<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:NurSapat.Cad.UI.ViewModels"
        xmlns:behaviors="clr-namespace:NurSapat.Cad.UI.Behaviors;assembly=NurSapat.Cad.UI"
        Width="420"
        Height="560"
        Title="Свойства объекта"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        WindowDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="0"
        x:Class="NurSapat.Cad.UI.Dialogs.ObjectPropertiesDialogWindow"
        x:DataType="vm:ObjectPropertiesDialogViewModel"
        FontFamily="Inter">

    <Border Background="White"
            BorderBrush="#808080"
            BorderThickness="2"
            CornerRadius="8"
            PointerPressed="OnWindowPointerPressed">
        <Grid RowDefinitions="*,Auto,Auto" Margin="16" RowSpacing="10">
            <ScrollViewer>
                <StackPanel Spacing="8">
                    <TextBlock Text="{Binding ObjectKind}" FontWeight="SemiBold" FontSize="14"/>
                    <TextBlock Text="{Binding SizeSummary}" Foreground="#64748B" TextWrapping="Wrap"/>

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="6">
                        <TextBlock Text="Метка" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" Text="{Binding LabelText, Mode=TwoWay}"/>

                        <TextBlock Grid.Row="1" Text="X, мм" VerticalAlignment="Center" IsVisible="{Binding ShowPositionFields}"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding XText, Mode=TwoWay}"
                                 IsVisible="{Binding ShowPositionFields}"
                                 behaviors:SignedDecimalInputBehavior.AllowNegative="True"/>

                        <TextBlock Grid.Row="2" Text="Y, мм" VerticalAlignment="Center" IsVisible="{Binding ShowPositionFields}"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding YText, Mode=TwoWay}"
                                 IsVisible="{Binding ShowPositionFields}"
                                 behaviors:SignedDecimalInputBehavior.AllowNegative="True"/>

                        <TextBlock Grid.Row="3" Text="Ширина, мм" VerticalAlignment="Center" IsVisible="{Binding ShowSizeFields}"/>
                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding WidthText, Mode=TwoWay}"
                                 IsVisible="{Binding ShowSizeFields}"
                                 behaviors:SignedDecimalInputBehavior.AllowNegative="False"/>

                        <TextBlock Grid.Row="4" Text="Высота, мм" VerticalAlignment="Center" IsVisible="{Binding ShowSizeFields}"/>
                        <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding HeightText, Mode=TwoWay}"
                                 IsVisible="{Binding ShowSizeFields}"
                                 behaviors:SignedDecimalInputBehavior.AllowNegative="False"/>

                        <TextBlock Grid.Row="5" Text="Материал" VerticalAlignment="Center" IsVisible="{Binding ShowCatalogFields}"/>
                        <ComboBox Grid.Row="5" Grid.Column="1"
                                  IsVisible="{Binding ShowCatalogFields}"
                                  ItemsSource="{Binding MaterialOptions}"
                                  SelectedItem="{Binding SelectedMaterial}"
                                  DisplayMemberBinding="{Binding Name}"/>

                        <TextBlock Grid.Row="6" Text="Серия" VerticalAlignment="Center" IsVisible="{Binding ShowCatalogFields}"/>
                        <ComboBox Grid.Row="6" Grid.Column="1"
                                  IsVisible="{Binding ShowCatalogFields}"
                                  ItemsSource="{Binding SeriesOptions}"
                                  SelectedItem="{Binding SelectedSeries}"
                                  DisplayMemberBinding="{Binding Name}"/>

                        <TextBlock Grid.Row="7" Text="Открывание" VerticalAlignment="Center" IsVisible="{Binding ShowSashFields}"/>
                        <ComboBox Grid.Row="7" Grid.Column="1"
                                  IsVisible="{Binding ShowSashFields}"
                                  ItemsSource="{Binding OpeningTypeOptions}"
                                  SelectedItem="{Binding SelectedOpeningType}"/>

                        <TextBlock Grid.Row="8" Text="Петли" VerticalAlignment="Center" IsVisible="{Binding ShowSashFields}"/>
                        <ComboBox Grid.Row="8" Grid.Column="1"
                                  IsVisible="{Binding ShowSashFields}"
                                  ItemsSource="{Binding HingeSideOptions}"
                                  SelectedItem="{Binding SelectedHingeSide}"/>

                        <CheckBox Grid.Row="9" Grid.ColumnSpan="2"
                                  Content="Фурнитура"
                                  IsChecked="{Binding HasHardware}"
                                  IsVisible="{Binding ShowSashFields}"/>
                        <CheckBox Grid.Row="10" Grid.ColumnSpan="2"
                                  Content="Ручка"
                                  IsChecked="{Binding HasHandle}"
                                  IsVisible="{Binding ShowSashFields}"/>
                        <CheckBox Grid.Row="11" Grid.ColumnSpan="2"
                                  Content="Москитная сетка"
                                  IsChecked="{Binding HasMosquitoNet}"
                                  IsVisible="{Binding ShowSashFields}"/>

                        <TextBlock Grid.Row="12" Text="Заполнение" VerticalAlignment="Center" IsVisible="{Binding ShowGlazingFields}"/>
                        <ComboBox Grid.Row="12" Grid.Column="1"
                                  IsVisible="{Binding ShowGlazingFields}"
                                  ItemsSource="{Binding FillTypeOptions}"
                                  SelectedItem="{Binding SelectedFillType}"/>

                        <TextBlock Grid.Row="13" Text="Ось импоста, мм" VerticalAlignment="Center" IsVisible="{Binding ShowImpostAxisField}"/>
                        <TextBox Grid.Row="13" Grid.Column="1" Text="{Binding AxisPositionText, Mode=TwoWay}"
                                 IsVisible="{Binding ShowImpostAxisField}"
                                 behaviors:SignedDecimalInputBehavior.AllowNegative="True"/>

                        <TextBlock Grid.Row="14" Text="Смещение, мм" VerticalAlignment="Center" IsVisible="{Binding ShowExtremeFields}"/>
                        <TextBox Grid.Row="14" Grid.Column="1" Text="{Binding ExtremeOffsetText, Mode=TwoWay}"
                                 IsVisible="{Binding ShowExtremeFields}"
                                 behaviors:SignedDecimalInputBehavior.AllowNegative="False"/>

                        <TextBlock Grid.Row="15" Text="Край" VerticalAlignment="Center" IsVisible="{Binding ShowExtremeFields}"/>
                        <ComboBox Grid.Row="15" Grid.Column="1"
                                  IsVisible="{Binding ShowExtremeFields}"
                                  ItemsSource="{Binding EdgeAlignmentOptions}"
                                  SelectedItem="{Binding SelectedEdgeAlignment}"/>

                        <TextBlock Grid.Row="16" Text="Стрела арки, мм" VerticalAlignment="Center" IsVisible="{Binding ShowArcField}"/>
                        <TextBox Grid.Row="16" Grid.Column="1" Text="{Binding ArcHeightText, Mode=TwoWay}"
                                 IsVisible="{Binding ShowArcField}"
                                 behaviors:SignedDecimalInputBehavior.AllowNegative="False"/>

                        <TextBlock Grid.Row="17" Text="Толщина подоконника" VerticalAlignment="Center" IsVisible="{Binding ShowSillFields}"/>
                        <TextBox Grid.Row="17" Grid.Column="1" Text="{Binding SillThicknessText, Mode=TwoWay}"
                                 IsVisible="{Binding ShowSillFields}"
                                 behaviors:SignedDecimalInputBehavior.AllowNegative="False"/>
                    </Grid>

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" RowDefinitions="Auto,Auto,Auto" RowSpacing="6"
                          IsVisible="{Binding ShowSillFields}">
                        <TextBlock Text="Ширина подоконника" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" Text="{Binding SillWidthText, Mode=TwoWay}"
                                 behaviors:SignedDecimalInputBehavior.AllowNegative="False"/>
                        <TextBlock Grid.Row="1" Text="Вынос слева" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SillLeftOverhangText, Mode=TwoWay}"
                                 behaviors:SignedDecimalInputBehavior.AllowNegative="False"/>
                        <TextBlock Grid.Row="2" Text="Вынос справа" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding SillRightOverhangText, Mode=TwoWay}"
                                 behaviors:SignedDecimalInputBehavior.AllowNegative="False"/>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <TextBlock Grid.Row="1"
                       Text="{Binding ValidationMessage}"
                       Foreground="#DC2626"
                       FontSize="11"
                       TextWrapping="Wrap"/>

            <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="12">
                <Button Content="OK" Command="{Binding ConfirmCommand}"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                <Button Grid.Column="1" Content="Отмена" Command="{Binding CancelCommand}"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
            </Grid>
        </Grid>
    </Border>
</Window>
