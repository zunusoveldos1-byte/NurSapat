<Window xmlns="https://github.com/avaloniaui"

        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

        xmlns:vm="clr-namespace:NurSapat.Cad.UI.ViewModels"

        xmlns:conv="clr-namespace:NurSapat.Cad.UI.Converters;assembly=NurSapat.Cad.UI"

        Width="360"

        Height="420"

        Title="Декоративный шпрос"

        WindowStartupLocation="CenterOwner"

        CanResize="False"

        WindowDecorations="None"

        ExtendClientAreaToDecorationsHint="True"

        ExtendClientAreaTitleBarHeightHint="0"

        x:Class="NurSapat.Cad.UI.Dialogs.DecorativeSpokeDialogWindow"

        x:DataType="vm:DecorativeSpokeDialogViewModel"

        FontFamily="Inter">



    <Window.Resources>

        <conv:DecorativeSpokeLabelConverter x:Key="SpokeLabel"/>

    </Window.Resources>



    <Border Background="White"

            BorderBrush="#808080"

            BorderThickness="2"

            CornerRadius="8">

        <Grid RowDefinitions="Auto,*,Auto" Margin="20" RowSpacing="10">

            <Border Background="#F8FAFC"

                    CornerRadius="6"

                    Padding="8,6"

                    PointerPressed="OnTitleBarPointerPressed"

                    Cursor="SizeAll">

                <TextBlock Text="Параметры декоративной раскладки"

                           FontWeight="SemiBold"

                           FontSize="14"/>

            </Border>



            <StackPanel Grid.Row="1" Spacing="10">

                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">

                    <TextBlock Text="Тип" VerticalAlignment="Center"/>

                    <ComboBox Grid.Column="1"

                              HorizontalAlignment="Stretch"

                              ItemsSource="{Binding AvailableSpokeTypes}"

                              SelectedItem="{Binding SelectedSpokeType, Mode=TwoWay}">

                        <ComboBox.ItemTemplate>

                            <DataTemplate>

                                <TextBlock Text="{Binding Converter={StaticResource SpokeLabel}}"/>

                            </DataTemplate>

                        </ComboBox.ItemTemplate>

                    </ComboBox>

                </Grid>



                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">

                    <TextBlock Text="Толщина, мм" VerticalAlignment="Center"/>

                    <ComboBox Grid.Column="1"

                              HorizontalAlignment="Stretch"

                              ItemsSource="{Binding AvailableThicknesses}"

                              SelectedItem="{Binding SelectedThickness, Mode=TwoWay}">

                        <ComboBox.ItemTemplate>

                            <DataTemplate>

                                <TextBlock Text="{Binding Converter={StaticResource SpokeLabel}}"/>

                            </DataTemplate>

                        </ComboBox.ItemTemplate>

                    </ComboBox>

                </Grid>



                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">

                    <TextBlock Text="Цвет" VerticalAlignment="Center"/>

                    <ComboBox Grid.Column="1"

                              HorizontalAlignment="Stretch"

                              ItemsSource="{Binding AvailableColors}"

                              SelectedItem="{Binding SelectedColor, Mode=TwoWay}">

                        <ComboBox.ItemTemplate>

                            <DataTemplate>

                                <TextBlock Text="{Binding Converter={StaticResource SpokeLabel}}"/>

                            </DataTemplate>

                        </ComboBox.ItemTemplate>

                    </ComboBox>

                </Grid>



                <StackPanel IsVisible="{Binding IsGridVisible}" Spacing="8">

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">

                        <TextBlock Text="Строк" VerticalAlignment="Center"/>

                        <TextBox Grid.Column="1" Text="{Binding RowsText, Mode=TwoWay}"/>

                    </Grid>

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">

                        <TextBlock Text="Столбцов" VerticalAlignment="Center"/>

                        <TextBox Grid.Column="1" Text="{Binding ColumnsText, Mode=TwoWay}"/>

                    </Grid>

                </StackPanel>



                <Grid ColumnDefinitions="Auto,*"

                      ColumnSpacing="12"

                      IsVisible="{Binding IsRayCountVisible}">

                    <TextBlock Text="Лучей" VerticalAlignment="Center"/>

                    <TextBox Grid.Column="1" Text="{Binding RaysText, Mode=TwoWay}"/>

                </Grid>



                <TextBlock Text="Для арочного стеклопакета рекомендуются «Солнечные лучи» или «Дуга внутри дуги»."

                           FontSize="11"

                           Foreground="#64748B"

                           TextWrapping="Wrap"

                           IsVisible="{Binding IsArchHintVisible}"/>

            </StackPanel>



            <StackPanel Grid.Row="2" Spacing="8">

                <TextBlock Text="{Binding ValidationMessage}"

                           Foreground="#DC2626"

                           FontSize="11"

                           TextWrapping="Wrap"/>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">

                    <Button Content="OK"

                            Command="{Binding ConfirmCommand}"

                            HorizontalAlignment="Stretch"

                            HorizontalContentAlignment="Center"/>

                    <Button Grid.Column="1"

                            Content="Отмена"

                            Command="{Binding CancelCommand}"

                            HorizontalAlignment="Stretch"

                            HorizontalContentAlignment="Center"/>

                </Grid>

            </StackPanel>

        </Grid>

    </Border>

</Window>

