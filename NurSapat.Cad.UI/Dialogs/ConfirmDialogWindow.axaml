<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:NurSapat.Cad.UI.ViewModels"
        Width="360"
        Height="160"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        WindowDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="0"
        Background="Transparent"
        x:Class="NurSapat.Cad.UI.Dialogs.ConfirmDialogWindow"
        x:DataType="vm:ConfirmDialogViewModel"
        FontFamily="Inter">

    <!-- Рамка как в SizeInputWindow: серая, толщина 2, закругление, тень и перетаскивание -->
    <Border Background="White"
            BorderBrush="#808080"
            BorderThickness="2"
            CornerRadius="8"
            Padding="20"
            BoxShadow="0 4 16 0 #30000000"
            PointerPressed="OnWindowPointerPressed">
        <Grid RowDefinitions="*,Auto" RowSpacing="20">
            <TextBlock Text="{Binding Message}"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center" />
            <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="12">
                <Button Content="Да"
                        Command="{Binding ConfirmCommand}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center" />
                <Button Grid.Column="1"
                        Content="Нет"
                        Command="{Binding CancelCommand}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center" />
            </Grid>
        </Grid>
    </Border>
</Window>