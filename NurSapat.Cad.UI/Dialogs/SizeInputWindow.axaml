<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="200"
        Width="300" Height="200"
        Title="Введите размеры"
        WindowStartupLocation="CenterOwner"
        x:Class="NurSapat.Cad.UI.Dialogs.SizeInputWindow"
        FontFamily="Segoe UI, Arial, Tahoma, Microsoft Sans Serif"> <!-- ← Добавьте эту строку -->

    <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="16" Margin="20">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16" RowDefinitions="Auto,Auto" RowSpacing="8">
            <TextBlock Text="Ширина, мм" VerticalAlignment="Center"/>
            <NumericUpDown Grid.Column="1" x:Name="WidthInput" Minimum="10" Maximum="10000" Value="1000" Increment="10"/>
            
            <TextBlock Grid.Row="1" Text="Высота, мм" VerticalAlignment="Center"/>
            <NumericUpDown Grid.Row="1" Grid.Column="1" x:Name="HeightInput" Minimum="10" Maximum="10000" Value="1000" Increment="10"/>
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="12">
            <Button Content="OK" x:Name="OkButton" HorizontalAlignment="Stretch"/>
            <Button Grid.Column="1" Content="Отмена" x:Name="CancelButton" HorizontalAlignment="Stretch"/>
        </Grid>
    </Grid>
</Window>