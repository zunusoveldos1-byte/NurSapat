<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:NurSapat.Cad.UI.ViewModels"
        Width="360"
        Height="190"
        Title="Сохранить в типовые"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        WindowDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="0"
        x:Class="NurSapat.Cad.UI.Dialogs.TemplateNameWindow"
        x:DataType="vm:TemplateNameViewModel"
        FontFamily="Inter">

    <Border Background="White" BorderBrush="#808080" BorderThickness="2" CornerRadius="8"
            PointerPressed="OnWindowPointerPressed">
        <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="12" Margin="20">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <TextBlock Text="Название" VerticalAlignment="Center"/>
                <TextBox Grid.Column="1" Text="{Binding NameText, Mode=TwoWay}"/>
            </Grid>
            <TextBlock Grid.Row="1" Text="{Binding ValidationMessage}" Foreground="#DC2626" FontSize="11"/>
            <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="12">
                <Button Content="OK" Command="{Binding ConfirmCommand}" HorizontalAlignment="Stretch"/>
                <Button Grid.Column="1" Content="Отмена" Command="{Binding CancelCommand}" HorizontalAlignment="Stretch"/>
            </Grid>
        </Grid>
    </Border>
</Window>
