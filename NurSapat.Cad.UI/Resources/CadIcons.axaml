<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:helpers="clr-namespace:NurSapat.Cad.UI.Helpers">

    <!--
        Единый центр хранения всех векторных иконок CAD-тулбара.

        Каждая иконка объявлена один раз под ключом "CadIcon.<Имя>" и используется
        в UI через {StaticResource CadIcon.<Имя>} (см. CadEditorView.axaml,
        ResourceKeyToGeometryConverter и CadToolbarLayout.IconResourceKey).

        Это единственное место, где хранится Geometry для иконок CAD — сама
        разметка кнопок (Path/TextBlock/иконка из другого набора) может быть
        заменена в будущем без изменения логики тулбара, поскольку он всегда
        обращается только к ключу ресурса, а не к самой геометрии.
    -->

    <!-- Системный шрифт MDL2 для шрифтовых иконок -->
    <FontFamily x:Key="SegoeMdl2Font">Segoe MDL2 Assets</FontFamily>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!--  БЛОК «СОЗДАНИЕ» — Рамки, коробки, импосты, створки и т.д.       -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->

    <StreamGeometry x:Key="CadIcon.FictitiousBounding">M 2,2 H 22 V 22 H 2 Z</StreamGeometry>

    <StreamGeometry x:Key="CadIcon.FakeFrame">M 2,2 h 2 M 5,2 h 2 M 8,2 h 2 M 11,2 h 2 M 14,2 h 2 M 17,2 h 2 M 20,2 h 2 M 22,2 v 2 M 22,5 v 2 M 22,8 v 2 M 22,11 v 2 M 22,14 v 2 M 22,17 v 2 M 22,20 v 2 M 22,22 h -2 M 19,22 h -2 M 16,22 h -2 M 13,22 h -2 M 10,22 h -2 M 7,22 h -2 M 4,22 h -2 M 2,22 v -2 M 2,19 v -2 M 2,16 v -2 M 2,13 v -2 M 2,10 v -2 M 2,7 v -2 M 2,4 v -2</StreamGeometry>

    <StreamGeometry x:Key="CadIcon.FakeCircle">M 12,2 A 10,10 0 1 0 12,22 A 10,10 0 1 0 12,2 Z</StreamGeometry>

    <StreamGeometry x:Key="CadIcon.FakeTriangle">M 12,2 L 22,22 H 2 Z</StreamGeometry>

    <!-- Также используется для CadIcon-ключа радиусной вершины (Editing) — см. дублирующие иконки ниже -->
    <StreamGeometry x:Key="CadIcon.FakeArch">M 3,18 H 21 M 3,18 A 9,9 0 0 1 21,18</StreamGeometry>

    <StreamGeometry x:Key="CadIcon.VerticalImpost">M 12,4 v 2 M 12,7 v 2 M 12,10 v 2 M 12,13 v 2 M 12,16 v 2 M 12,19 v 2</StreamGeometry>

    <StreamGeometry x:Key="CadIcon.HorizontalImpost">M 3,12 h 2 M 6,12 h 2 M 9,12 h 2 M 12,12 h 2 M 15,12 h 2 M 18,12 h 2</StreamGeometry>

    <StreamGeometry x:Key="CadIcon.RealFrame">M 3,3 H 21 V 21 H 3 Z</StreamGeometry>

    <StreamGeometry x:Key="CadIcon.AdapterProfile">M 3,3 H 21 V 21 H 3 Z M 7,7 H 17 V 17 H 7 Z</StreamGeometry>

    <StreamGeometry x:Key="CadIcon.Sash">M 7,4 L 18,12 L 7,20</StreamGeometry>

    <StreamGeometry x:Key="CadIcon.Hardware">M 5,3 L 8,3 L 8,7 L 5,7 Z M 5,17 L 8,17 L 8,21 L 5,21 Z M 9,4 L 20,12 L 9,20</StreamGeometry>

    <StreamGeometry x:Key="CadIcon.Handle">M 10,6 L 12,6 A 2,2 0 0 1 14,8 L 14,22 A 2,2 0 0 1 12,23 L 10,23 A 2,2 0 0 1 8,22 L 8,8 A 2,2 0 0 1 10,6 Z M 12,9 L 20,9 A 1,1 0 0 1 21,10 L 21,11 A 1,1 0 0 1 20,12 L 12,12 A 1,1 0 0 1 11,11 L 11,10 A 1,1 0 0 1 12,9 Z</StreamGeometry>

    <StreamGeometry x:Key="CadIcon.RealVerticalImpost">M 12,4 V 20 M 9,4 H 15 M 9,20 H 15</StreamGeometry>

    <StreamGeometry x:Key="CadIcon.RealHorizontalImpost">M 4,12 H 20 M 4,9 V 15 M 20,9 V 15</StreamGeometry>

    <StreamGeometry x:Key="CadIcon.DoubleVerticalImpost">M 9,2 V 22 M 12,2 V 22 M 15,2 V 22 M 4,2 L 20,2 M 4,22 L 20,22</StreamGeometry>

    <StreamGeometry x:Key="CadIcon.DoubleHorizontalImpost">M 2,9 H 22 M 2,12 H 22 M 2,15 H 22 M 2,4 V 20 M 22,4 V 20</StreamGeometry>

    <StreamGeometry x:Key="CadIcon.SlantedImpost">M 4,20 L 20,4 M 2,22 L 6,18 M 18,6 L 22,2</StreamGeometry>

    <!-- Вертикальная гофра (4 линии, рамка аккуратная) -->
    <StreamGeometry x:Key="CadIcon.CorrugationVertical">M 2,2 H 22 V 22 H 2 Z M 6,2 V 22 M 10,2 V 22 M 14,2 V 22 M 18,2 V 22</StreamGeometry>

    <!-- Горизонтальная гофра (4 линии, рамка аккуратная) -->
    <StreamGeometry x:Key="CadIcon.CorrugationHorizontal">M 2,2 H 22 V 22 H 2 Z M 2,6 H 22 M 2,10 H 22 M 2,14 H 22 M 2,18 H 22</StreamGeometry>

    <!-- Также используется для CadIcon-ключа горизонтальных жалюзи (Creation) — см. дублирующие иконки ниже -->

    <StreamGeometry x:Key="CadIcon.CorrugationSlanted">M 3,3 H 21 V 21 H 3 Z M 3,9 L 9,3 M 3,15 L 15,3 M 3,21 L 21,3 M 9,21 L 21,9 M 15,21 L 21,15</StreamGeometry>

    <StreamGeometry x:Key="CadIcon.Corrugation">M 3,16 L 7,12 L 11,16 L 15,12 L 19,16 L 21,14</StreamGeometry>

    <StreamGeometry x:Key="CadIcon.Glassing">M 3,3 H 21 V 21 H 3 Z M 9,15 L 15,9 M 11.5,15.5 L 15.5,11.5 M 8.5,12.5 L 12.5,8.5</StreamGeometry>

    <StreamGeometry x:Key="CadIcon.AdditionalElement">M 6,6 H 18 V 18 H 6 Z M 12,9 V 15 M 9,12 H 15</StreamGeometry>

    <StreamGeometry x:Key="CadIcon.GlassWithBead">M 3,3 H 21 V 21 H 3 Z M 7,7 H 17 V 17 H 7 Z M 9,15 L 15,9 M 11.5,15.5 L 15.5,11.5</StreamGeometry>

   <StreamGeometry x:Key="CadIcon.MullionEdge">M 3,4 h 5 v 16 h -5 z M 15,6 v 12 M 9,12 h 12 M 13,8 L 15,6 L 17,8 M 13,16 L 15,18 L 17,16 M 9,12 L 11,10 L 11,14 M 21,12 L 19,10 L 19,14</StreamGeometry>

    <!-- Также используется для CadIcon-ключа вертикальных жалюзи (Creation) — см. дублирующие иконки ниже -->
    <StreamGeometry x:Key="CadIcon.MosquitoNet">M 3,3 H 21 V 21 H 3 Z M 3,3 L 9,9 M 3,9 L 9,15 M 3,15 L 9,21 M 9,3 L 15,9 M 9,9 L 15,15 M 9,15 L 15,21 M 15,3 L 21,9 M 15,9 L 21,15 M 15,15 L 21,21 M 3,21 L 9,15 M 3,15 L 9,9 M 3,9 L 9,3 M 9,21 L 15,15 M 9,15 L 15,9 M 9,9 L 15,3 M 15,21 L 21,15 M 15,15 L 21,9 M 15,9 L 21,3</StreamGeometry>

    <StreamGeometry x:Key="CadIcon.Bead">M 3,3 H 21 V 21 H 3 Z M 6,6 H 18 V 18 H 6 Z M 6,3 V 6 M 18,3 V 6 M 6,18 V 21 M 18,18 V 21 M 3,6 H 6 M 18,6 H 21 M 3,18 H 6 M 18,18 H 21</StreamGeometry>

    <StreamGeometry x:Key="CadIcon.Lock">M 6,11 H 18 V 19 H 6 Z M 8,11 V 8 A 2,2 0 0 1 16,8 V 11 M 12,14 V 16</StreamGeometry>

    <StreamGeometry x:Key="CadIcon.Limiter">M 3,3 H 21 V 21 H 3 Z M 3,3 h 2 v 7 h -2 z M 3,21 L 12,3 M 21,21 L 12,3</StreamGeometry>

    <StreamGeometry x:Key="CadIcon.Closer">M 3,3 H 21 V 21 H 3 Z M 3,3 h 8 v 4 h -8 z M 11,7 L 21,12 M 3,21 L 21,12</StreamGeometry>

    <StreamGeometry x:Key="CadIcon.Espagnolette">M 2,2 H 22 V 22 H 2 Z M 20,3 L 22,3 L 22,7 L 20,7 Z M 20,17 L 22,17 L 22,21 L 20,21 Z M 3,5 L 20,12 L 3,19</StreamGeometry>

    <StreamGeometry x:Key="CadIcon.SashFixed">M 3,3 H 21 V 21 H 3 Z M 12,5 V 19 M 5,12 H 19</StreamGeometry>

    <StreamGeometry x:Key="CadIcon.SashTurn">M 3,3 H 21 V 21 H 3 Z M 3,3 L 21,12 L 3,21</StreamGeometry>

    <StreamGeometry x:Key="CadIcon.SashTilt">M 3,3 H 21 V 21 H 3 Z M 3,21 L 12,3 L 21,21</StreamGeometry>

    <StreamGeometry x:Key="CadIcon.SashSuspended">M 3,3 H 21 V 21 H 3 Z M 3,3 L 12,21 L 21,3</StreamGeometry>

    <StreamGeometry x:Key="CadIcon.SashTurnVertical">M 4,4 H 20 V 20 H 4 Z M 4,12 L 12,4 M 4,12 L 12,20</StreamGeometry>

    <StreamGeometry x:Key="CadIcon.SashTurnHorizontal">M 4,4 H 20 V 20 H 4 Z M 12,4 L 20,12 M 12,20 L 20,12</StreamGeometry>

    <StreamGeometry x:Key="CadIcon.SashSliding">M 3,3 H 21 V 21 H 3 Z M 18,12 L 6,12 M 6,12 L 9,9 M 6,12 L 9,15</StreamGeometry>

   <StreamGeometry x:Key="CadIcon.SashFolding">M 3,3 H 21 V 21 H 3 Z M 18,3 L 12,18 M 12,18 L 8,12 M 8,12 L 5,12 M 5,12 L 7,10 M 5,12 L 7,14</StreamGeometry>

    <StreamGeometry x:Key="CadIcon.More">M 6,12 A 1.5,1.5 0 1 0 6,12.01 M 12,12 A 1.5,1.5 0 1 0 12,12.01 M 18,12 A 1.5,1.5 0 1 0 18,12.01</StreamGeometry>

    <StreamGeometry x:Key="CadIcon.Cornice">M 2,18 H 22 M 4,18 V 14 H 20 V 18 M 6,14 L 4,10 H 20 L 18,14</StreamGeometry>

    <StreamGeometry x:Key="CadIcon.BlindControl">M 6,4 H 18 V 8 H 6 Z M 12,8 V 20 M 10,18 L 12,20 L 14,18</StreamGeometry>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!--  БЛОК «РЕДАКТИРОВАНИЕ» — Выделение, удаление, выравнивание и т.д. -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->

    <StreamGeometry x:Key="CadIcon.Selection">M 7,4 L 7,18 L 11,14 L 14,21 L 16,20 L 13,13 L 18,13 Z</StreamGeometry>

    <StreamGeometry x:Key="CadIcon.SelectObject">M 4,6 H 20 V 18 H 4 Z M 4,10 H 20 M 12,12 L 18,17.5 L 15.5,18 L 18.5,23 L 16.5,24 L 13.5,19 L 11,21 Z</StreamGeometry>

    <StreamGeometry x:Key="CadIcon.SelectProfile">M 3,7 H 21 M 3,11 H 21 M 12,11 L 18,16.5 L 15.5,17 L 18.5,22 L 16.5,23 L 13.5,18 L 11,20 Z</StreamGeometry>

    <StreamGeometry x:Key="CadIcon.SelectVertex">M 8,4 H 12 L 16,8 V 12 L 12,16 H 8 L 4,12 V 8 Z M 10,5 V 7 M 10,13 V 15 M 5,10 H 7 M 13,10 H 15 M 8.5,10 A 1.5,1.5 0 1 0 11.5,10 A 1.5,1.5 0 1 0 8.5,10 M 13,13 L 19,17.5 L 16.5,18 L 19.5,22 L 17.5,23 L 14.5,18.5 L 12,20.5 Z</StreamGeometry>

    <StreamGeometry x:Key="CadIcon.UndoLast">M 7,12 L 3,8 L 7,4 M 3,8 H 15 A 5,5 0 0 1 20,13 A 5,5 0 0 1 15,18 H 9</StreamGeometry>

    <!-- Шрифтовые MDL2-иконки (TextGeometry → IGeometrySource → Geometry) -->
    <helpers:TextGeometry x:Key="CadIcon.UndoGlobal"
                          Text="&#xE7A7;"
                          FontFamilyName="Segoe MDL2 Assets"
                          FontSize="20"/>

    <helpers:TextGeometry x:Key="CadIcon.RedoGlobal"
                          Text="&#xE7A6;"
                          FontFamilyName="Segoe MDL2 Assets"
                          FontSize="20"/>

    <StreamGeometry x:Key="CadIcon.Zoom">M 10,4 A 6,6 0 1 0 10,16 A 6,6 0 1 0 10,4 Z M 15,15 L 21,21</StreamGeometry>

    <StreamGeometry x:Key="CadIcon.Hand">M 8,14 V 7 A 1,1 0 0 1 10,7 V 12 M 10,9 V 5 A 1,1 0 0 1 12,5 V 12 M 12,7 V 5 A 1,1 0 0 1 14,5 V 12 M 14,8 V 7 A 1,1 0 0 1 16,7 V 15 A 5,5 0 0 1 11,20 L 7,16 Z</StreamGeometry>

    <StreamGeometry x:Key="CadIcon.ZoomFit">M 3,3 H 9 M 3,3 V 9 M 21,3 H 15 M 21,3 V 9 M 3,21 H 9 M 3,21 V 15 M 21,21 H 15 M 21,21 V 15 M 9,9 H 15 V 15 H 9 Z</StreamGeometry>

    <StreamGeometry x:Key="CadIcon.MoveMullionVertical">M 12,3 V 21 M 5,12 H 9 M 7,10 L 5,12 L 7,14 M 19,12 H 15 M 17,10 L 19,12 L 17,14</StreamGeometry>

    <StreamGeometry x:Key="CadIcon.MoveMullionHorizontal">M 3,12 H 21 M 12,5 V 9 M 10,7 L 12,5 L 14,7 M 12,19 V 15 M 10,17 L 12,19 L 14,17</StreamGeometry>

    <StreamGeometry x:Key="CadIcon.AlignMullions">M 4,6 H 20 M 4,12 H 20 M 4,18 H 20 M 8,4 V 20 M 16,4 V 20</StreamGeometry>

    <StreamGeometry x:Key="CadIcon.AlignGlassUnits">M 3,5 H 14 V 16 H 3 Z M 10,8 H 21 V 19 H 10 Z</StreamGeometry>

    <StreamGeometry x:Key="CadIcon.AlignClearOpenings">M 4,6 H 20 V 18 H 4 Z M 7,12 H 17 M 7,12 L 9,10 M 7,12 L 9,14 M 17,12 L 15,10 M 17,12 L 15,14</StreamGeometry>

    <StreamGeometry x:Key="CadIcon.Trash">M 8,4 V 2 H 16 V 4 M 4,4 H 20 M 6,4 V 21 H 18 V 4 M 10,7 V 18 M 14,7 V 18</StreamGeometry>

    <StreamGeometry x:Key="CadIcon.ClearAll">M 12,2 A 10,10 0 1 0 12,22 A 10,10 0 1 0 12,2 Z M 6,10 H 18 V 14 H 6 Z</StreamGeometry>

    <StreamGeometry x:Key="CadIcon.Resize">M 4,6 H 20 V 18 H 4 Z M 7,12 H 17 M 7,12 L 9,10 M 7,12 L 9,14 M 17,12 L 15,10 M 17,12 L 15,14</StreamGeometry>

    <StreamGeometry x:Key="CadIcon.ArchHeight">M 3,18 H 17 M 3,18 A 7,7 0 0 1 15,13 M 17,4 V 11 M 21,4 V 11 M 17,7.5 H 21 M 11,18 L 6.5,13.5 M 6.5,13.5 L 9.5,14 M 6.5,13.5 L 6,16.5</StreamGeometry>

    <StreamGeometry x:Key="CadIcon.ArcVertex">M 4,18 A 8,8 0 0 1 20,18 M 12,10 A 2,2 0 1 0 12,10.01</StreamGeometry>

    <StreamGeometry x:Key="CadIcon.RemoveArcVertex">M 4,18 A 8,8 0 0 1 20,18 M 9,10 H 15</StreamGeometry>

    <StreamGeometry x:Key="CadIcon.SplitArc">M 4,18 A 8,8 0 0 1 20,18 M 12,10 V 4 M 10,6 L 12,4 L 14,6</StreamGeometry>

    <StreamGeometry x:Key="CadIcon.SetRadius">M 12,12 H 20 M 12,12 A 8,8 0 0 1 20,12 M 14,10 L 12,12 L 14,14</StreamGeometry>

    <StreamGeometry x:Key="CadIcon.SetArchHeight">M 3,18 H 21 M 3,18 A 9,9 0 0 1 21,18 M 12,4 V 18 M 10,6 L 12,4 L 14,6 M 10,16 L 12,18 L 14,16</StreamGeometry>

    <StreamGeometry x:Key="CadIcon.Recalculate">M 4,12 A 8,8 0 0 1 20,12 M 20,12 A 8,8 0 0 1 4,12 M 17,6 L 20,12 L 14,12 M 7,18 L 4,12 L 10,12</StreamGeometry>

    <StreamGeometry x:Key="CadIcon.Properties">M 12,3 A 2,2 0 1 0 12,7 A 2,2 0 1 0 12,3 Z M 12,7 V 21 M 8,11 H 16 M 8,15 H 16</StreamGeometry>

    <StreamGeometry x:Key="CadIcon.Copy">M 8,2 H 20 V 16 H 8 Z M 4,6 V 22 H 16</StreamGeometry>

    <StreamGeometry x:Key="CadIcon.Paste">M 6,4 H 18 V 20 H 6 Z M 9,2 H 15 V 6 H 9 Z M 9,10 H 15 M 9,13 H 15 M 9,16 H 13</StreamGeometry>

    <StreamGeometry x:Key="CadIcon.Details">M 4,3 H 20 V 21 H 4 Z M 7,7 H 17 M 7,10 H 17 M 7,13 H 17 M 7,16 H 13</StreamGeometry>

    <StreamGeometry x:Key="CadIcon.StandardStructures">M 4,4 H 20 V 20 H 4 Z M 4,8 H 20 M 12,8 V 20</StreamGeometry>

    <StreamGeometry x:Key="CadIcon.AddConstruction">M 12,4 V 20 M 4,12 H 20</StreamGeometry>

