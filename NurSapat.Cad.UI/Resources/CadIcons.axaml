    <StreamGeometry x:Key="CadIcon.InsertFromStandard">M 4,4 H 20 V 20 H 4 Z M 4,8 H 20 M 12,8 V 20 M 10,14 L 12,16 L 14,14</StreamGeometry>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!--  БЛОК «ДЕКОРИРОВАНИЕ» — Шпросы, декоративные элементы             -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->

    <StreamGeometry x:Key="CadIcon.DecorativeSpoke">M 4,4 H 20 V 20 H 4 Z M 8,8 H 16 V 16 H 8 Z M 12,4 V 20 M 4,12 H 20</StreamGeometry>

    <StreamGeometry x:Key="CadIcon.ShprossVertical">M 12,4 V 20</StreamGeometry>

    <StreamGeometry x:Key="CadIcon.ShprossHorizontal">M 4,12 H 20</StreamGeometry>

    <StreamGeometry x:Key="CadIcon.Sill">M 2,16 H 22 V 19 H 2 Z M 4,19 H 20 V 21 H 4 Z</StreamGeometry>

</ResourceDictionary>
