<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:NurSapat.Cad.UI.ViewModels;assembly=NurSapat.Cad.UI"
             xmlns:controls="clr-namespace:NurSapat.Cad.UI.Controls;assembly=NurSapat.Cad.UI"
             xmlns:conv="clr-namespace:NurSapat.Cad.UI.Converters;assembly=NurSapat.Cad.UI"
             xmlns:models="clr-namespace:NurSapat.Cad.UI.Models;assembly=NurSapat.Cad.UI"
             xmlns:core="clr-namespace:NurSapat.Core.Models;assembly=NurSapat.Core"
             xmlns:construction="clr-namespace:NurSapat.Core.Models.Construction;assembly=NurSapat.Core"
             xmlns:behaviors="clr-namespace:NurSapat.Cad.UI.Behaviors;assembly=NurSapat.Cad.UI"
             x:Class="NurSapat.Cad.UI.Views.CadEditorView"
             x:DataType="vm:CadEditorViewModel"
             FontFamily="Inter"
             Background="#F6F9FD">

    <UserControl.KeyBindings>
        <KeyBinding Gesture="Ctrl+Alt+Z" Command="{Binding UndoLastElementCommand}"/>
        <KeyBinding Gesture="Ctrl+Z" Command="{Binding UndoCommand}"/>
        <KeyBinding Gesture="Ctrl+Y" Command="{Binding RedoCommand}"/>
    </UserControl.KeyBindings>

    <UserControl.Resources>
        <conv:ResourceKeyToGeometryConverter x:Key="IconKeyToGeometry"/>
        <DataTemplate x:Key="CadToolbarToolTemplate" DataType="vm:CadDesignToolButtonViewModel">
            <Button Classes.cadTool="True"
                    Classes.active="{Binding IsActive}"
                    Focusable="False"
                    IsEnabled="{Binding IsImplemented}"
                    Command="{Binding ActivateCommand}"
                    CommandParameter="{Binding ToolKey}"
                    ToolTip.Tip="{Binding TooltipText}"
                    ToolTip.ShowDelay="200">
                <Viewbox Width="26" Height="26">
                    <Path Width="24" Height="24"
                          Stroke="#0F172A"
                          StrokeThickness="1.2"
                          Fill="Transparent"
                          Data="{Binding IconResourceKey, Converter={StaticResource IconKeyToGeometry}}"/>
                </Viewbox>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="FontFamily" Value="Inter"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style Selector="TextBlock.paramLabel">
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.cadTool">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="MinWidth" Value="42"/>
            <Setter Property="MinHeight" Value="42"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.cadTool:pointerover">
            <Setter Property="Background" Value="#F0F7FF"/>
            <Setter Property="BorderBrush" Value="#93C5FD"/>
        </Style>
        <Style Selector="Button.cadTool.active">
            <Setter Property="Background" Value="#E8F4FD"/>
            <Setter Property="BorderBrush" Value="#0078D7"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>
        <Style Selector="Button.cadTool:disabled">
            <Setter Property="Opacity" Value="0.42"/>
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="Cursor" Value="Arrow"/>
        </Style>
        <Style Selector="Path.toolIcon">
            <Setter Property="Stroke" Value="Black"/>
            <Setter Property="StrokeThickness" Value="1"/>
            <Setter Property="Fill" Value="Transparent"/>
            <Setter Property="Stretch" Value="Uniform"/>
        </Style>
        <Style Selector="Path.toolIcon.dashed">
            <Setter Property="StrokeDashArray" Value="4,2"/>
        </Style>
        <Style Selector="Button.mini">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Inter"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.template">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#0078D7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Inter"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="#0078D7"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.qtyArrow">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="13"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="ComboBox, TextBox, NumericUpDown">
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="FontFamily" Value="Inter"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>
        <Style Selector="CheckBox">
            <Setter Property="FontFamily" Value="Inter"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#475569"/>
        </Style>
        <Style Selector="CheckBox:disabled">
            <Setter Property="Opacity" Value="0.45"/>
        </Style>
        <Style Selector="TextBlock.cadToolbarBlockHeader">
            <Setter Property="Foreground" Value="#0078D7"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="6,10,6,6"/>
            <Setter Property="LetterSpacing" Value="1"/>
        </Style>
        <Style Selector="Border.cadToolbarBlockSpacer">
            <Setter Property="Height" Value="14"/>
            <Setter Property="Margin" Value="6,10,6,6"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="TextBox.coordField">
            <Setter Property="MinHeight" Value="26"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto">
        <Border Grid.Row="0"
                Background="White"
                BorderBrush="#E2E8F0"
                BorderThickness="0,0,0,1"
                Padding="5,6"
                IsVisible="{Binding IsTopPanelVisible}">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <Grid RowDefinitions="Auto,Auto"
                      ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                      Margin="0,0,0,2">
                    <StackPanel Grid.Row="0"
                                Grid.Column="0"
                                Orientation="Horizontal"
                                Spacing="6"
                                Margin="5"
                                VerticalAlignment="Center">
                        <TextBlock Classes="paramLabel" Text="Шаблоны"/>
                        <ComboBox Width="170"
                                  MinWidth="140"
                                  ItemsSource="{Binding DrawingTemplates}"
                                  SelectedItem="{Binding SelectedDrawingTemplate}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate DataType="models:CadDrawingTemplate">
                                    <TextBlock Text="{Binding Name}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Row="0"
                                Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="6"
                                Margin="5"
                                VerticalAlignment="Center">
                        <TextBlock Classes="paramLabel" Text="Серия"/>
                        <ComboBox Width="130"
                                  MinWidth="110"
                                  ItemsSource="{Binding AvailableProfileSeries}"
                                  SelectedItem="{Binding SelectedProfileSeriesItem}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate DataType="construction:ProfileSeries">
                                    <TextBlock Text="{Binding Name}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Row="0"
                                Grid.Column="2"
                                Orientation="Horizontal"
                                Spacing="6"
                                Margin="5"
                                VerticalAlignment="Center">
                        <TextBlock Classes="paramLabel" Text="Материалы"/>
                        <ComboBox Width="200"
                                  MinWidth="160"
                                  IsEnabled="{Binding IsConstructionMaterialComboEnabled}"
                                  ItemsSource="{Binding FilteredConstructionMaterialOptions}"
                                  SelectedItem="{Binding SelectedConstructionMaterialOption}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate DataType="models:ConstructionMaterialOption">
                                    <TextBlock Text="{Binding DisplayName}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <CheckBox Content="Все"
                                  IsChecked="{Binding ShowAllMaterials}"
                                  VerticalAlignment="Center"
                                  ToolTip.Tip="Показать все материалы из базы"/>
                    </StackPanel>

                    <StackPanel Grid.Row="0"
                                Grid.Column="3"
                                Orientation="Horizontal"
                                Spacing="6"
                                Margin="5"
                                VerticalAlignment="Center">
                        <TextBlock Classes="paramLabel" Text="Цвет материала"/>
                        <ComboBox Width="130"
                                  MinWidth="110"
                                  ItemsSource="{Binding MaterialColors}"
                                  SelectedItem="{Binding SelectedMaterialColor}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="0"
                                Grid.Column="4"
                                Orientation="Horizontal"
                                Spacing="6"
                                Margin="5"
                                VerticalAlignment="Center">
                        <TextBlock Classes="paramLabel" Text="Конструкция"/>
                        <ComboBox Width="150"
                                  MinWidth="130"
                                  ItemsSource="{Binding Constructions}"
                                  SelectedItem="{Binding SelectedConstruction}"/>
                        <Button Classes="mini"
                                ToolTip.Tip="Список конструкций заказа"
                                Command="{Binding OpenConstructionsLookupCommand}">
                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       Text="&#xE8FD;"
                                       FontSize="14"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"/>
                        </Button>
                    </StackPanel>

                    <StackPanel Grid.Row="1"
                                Grid.Column="2"
                                Orientation="Horizontal"
                                Spacing="12"
                                Margin="5,4,5,0"
                                VerticalAlignment="Top">
                        <CheckBox Content="Блок. откид."
                                  IsChecked="{Binding IsTiltBlockerEnabled}"
                                  IsEnabled="{Binding AreFurnitureOptionsEnabled}"
                                  ToolTip.Tip="Блокиратор откидывания"/>
                        <CheckBox Content="Микропров."
                                  IsChecked="{Binding IsMicroVentilationEnabled}"
                                  IsEnabled="{Binding AreFurnitureOptionsEnabled}"
                                  ToolTip.Tip="Микропроветривание"/>
                        <CheckBox Content="Балк. компл."
                                  IsChecked="{Binding IsBalconyKitEnabled}"
                                  IsEnabled="{Binding AreFurnitureOptionsEnabled}"
                                  ToolTip.Tip="Балконный комплект"/>
                        <CheckBox Content="Микролифт"
                                  IsChecked="{Binding IsMicroliftEnabled}"
                                  IsEnabled="{Binding AreFurnitureOptionsEnabled}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1"
                                Grid.Column="4"
                                Orientation="Horizontal"
                                Spacing="6"
                                Margin="5,4,5,0"
                                VerticalAlignment="Top">
                        <Button Classes="mini"
                                Content="+"
                                ToolTip.Tip="Добавить конструкцию"
                                Command="{Binding AddConstructionCommand}"/>
                        <Button Classes="mini"
                                Content="−"
                                ToolTip.Tip="Удалить текущую конструкцию"
                                Command="{Binding RemoveConstructionCommand}"/>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="2" ColumnDefinitions="212,*">
            <Border Grid.Column="0"
                    Margin="0"
                    Background="White"
                    BorderBrush="#E2E8F0"
                    BorderThickness="0,0,1,0"
                    VerticalAlignment="Stretch"
                    IsVisible="{Binding IsLeftPanelVisible}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalAlignment="Top"
                              Padding="2,4">
                    <StackPanel VerticalAlignment="Top" Spacing="0" Width="204">
                        <Border Background="#F8FAFC"
                                BorderBrush="#E2E8F0"
                                BorderThickness="1"
                                CornerRadius="8"
                                Margin="4,0,4,8"
                                Padding="4">
                            <UniformGrid Columns="3" Margin="0">
                                <Button Classes="template"
                                        Content="Создание"
                                        Command="{Binding SetWorkspaceModeCommand}"
                                        CommandParameter="{x:Static models:CadEditorWorkspaceMode.Creation}"
                                        Margin="2"/>
                                <Button Classes="template"
                                        Content="Редакт."
                                        Command="{Binding SetWorkspaceModeCommand}"
                                        CommandParameter="{x:Static models:CadEditorWorkspaceMode.Editing}"
                                        Margin="2"/>
                                <Button Classes="template"
                                        Content="Декор"
                                        Command="{Binding SetWorkspaceModeCommand}"
                                        CommandParameter="{x:Static models:CadEditorWorkspaceMode.Decoration}"
                                        Margin="2"/>
                            </UniformGrid>
                        </Border>

                        <TextBlock Classes="cadToolbarBlockHeader"
                                   Text="СОЗДАНИЕ"
                                   IsVisible="{Binding IsCreationWorkspaceActive}"/>
                        <ItemsControl ItemsSource="{Binding CreationDesignTools}"
                                      ItemTemplate="{StaticResource CadToolbarToolTemplate}"
                                      IsVisible="{Binding IsCreationWorkspaceActive}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="4"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <Border Classes="cadToolbarBlockSpacer"
                                IsVisible="{Binding IsCreationWorkspaceActive}">
                            <Border Height="1"
                                    Background="#E2E8F0"
                                    VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Classes="cadToolbarBlockHeader"
                                   Text="РЕДАКТИРОВАНИЕ"
                                   IsVisible="{Binding IsEditingWorkspaceActive}"/>
                        <ItemsControl ItemsSource="{Binding EditingDesignTools}"
                                      ItemTemplate="{StaticResource CadToolbarToolTemplate}"
                                      IsVisible="{Binding IsEditingWorkspaceActive}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="4"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <Border Classes="cadToolbarBlockSpacer"
                                IsVisible="{Binding IsEditingWorkspaceActive}">
                            <Border Height="1"
                                    Background="#E2E8F0"
                                    VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Classes="cadToolbarBlockHeader"
                                   Text="ДЕКОРИРОВАНИЕ"
                                   IsVisible="{Binding IsDecorationWorkspaceActive}"/>
                        <ItemsControl ItemsSource="{Binding DecorationDesignTools}"
                                      ItemTemplate="{StaticResource CadToolbarToolTemplate}"
                                      IsVisible="{Binding IsDecorationWorkspaceActive}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="4"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>

                        <Separator Background="#AEAEAE" Margin="0,10"/>

                        <StackPanel Margin="4,0,4,8" Spacing="6" IsVisible="{Binding IsExtremeImpostToolActive}">
                            <TextBlock Classes="paramLabel" Text="Тип импоста"/>
                            <ComboBox ItemsSource="{Binding ExtremeImpostPlacementOptions}"
                                      SelectedItem="{Binding SelectedExtremeImpostPlacementOption, Mode=TwoWay}"
                                      HorizontalAlignment="Stretch"
                                      MinHeight="28">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Label}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Margin="4,0,4,8" Spacing="6" IsVisible="{Binding IsSillPropertiesPanelVisible}">
                            <TextBlock Classes="paramLabel" Text="Подоконник"/>
                            <TextBlock Classes="paramLabel" Text="Материал"/>
                            <ComboBox ItemsSource="{Binding SillMaterialOptions}"
                                      SelectedItem="{Binding SelectedSillMaterialOption, Mode=TwoWay}"
                                      HorizontalAlignment="Stretch"
                                      MinHeight="28">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate DataType="models:ConstructionMaterialOption">
                                        <TextBlock Text="{Binding DisplayName}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Margin="4,0,4,8" Spacing="6" IsVisible="{Binding IsSashMosquitoNetPanelVisible}">
                            <TextBlock Classes="paramLabel" Text="Москитная сетка"/>
                            <Button Content="Добавить москитную сетку"
                                    Command="{Binding ToggleMosquitoNetOnSelectedSashCommand}"
                                    HorizontalAlignment="Stretch"
                                    MinHeight="28"/>
                            <CheckBox Content="Сетка установлена"
                                      IsChecked="{Binding HasMosquitoNetOnSelectedSash, Mode=TwoWay}"
                                      IsEnabled="False"/>
                        </StackPanel>

                        <StackPanel Margin="4,0,4,8" Spacing="6" IsVisible="{Binding IsExtremeImpostEditPanelActive}">
                            <TextBlock Classes="paramLabel" Text="Отступ от края, мм"/>
                            <NumericUpDown Minimum="0"
                                           Increment="1"
                                           FormatString="F0"
                                           Value="{Binding ExtremeImpostOffsetMm, Mode=TwoWay}"
                                           HorizontalAlignment="Stretch"/>
                        </StackPanel>

                        <StackPanel Margin="4,0,4,8" Spacing="6" IsVisible="{Binding IsDragCreateShapeToolActive}">
                            <TextBlock Classes="paramLabel" Text="Привязка"/>
                            <ComboBox ItemsSource="{Binding PlacementAnchorOptions}"
                                      SelectedItem="{Binding SelectedPlacementAnchorOption, Mode=TwoWay}"
                                      HorizontalAlignment="Stretch"
                                      MinHeight="28">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate DataType="models:PlacementAnchorOption">
                                        <TextBlock Text="{Binding Label}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <controls:CadSceneControl Grid.Column="1"
                                      Editor="{Binding}"
                                      ShowHorizontalRuler="False"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Stretch"
                                      ClipToBounds="True"/>
        </Grid>

        <Grid Grid.Row="3" ColumnDefinitions="212,*" Height="30">
            <Border Grid.Column="0"
                    Background="#F8FAFC"
                    BorderBrush="#E2E8F0"
                    BorderThickness="0,0,1,1"/>
            <controls:RulerControl Grid.Column="1"
                                   Editor="{Binding}"
                                   Orientation="Horizontal"
                                   HorizontalTickEdge="Top"
                                   CanvasScreenOriginX="{x:Static controls:CadSceneControl.VerticalRulerThickness}"
                                   Height="30"
                                   ClipToBounds="True"
                                   HorizontalAlignment="Stretch"
                                   VerticalAlignment="Stretch"/>
        </Grid>

        <Border Grid.Row="4"
                Height="32"
                Background="#F0F0F0"
                BorderBrush="#E2E8F0"
                BorderThickness="0,1,0,0"
                IsVisible="{Binding IsBottomPanelVisible}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="0">
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="10,0,5,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Classes="paramLabel" Text="X =" VerticalAlignment="Center"/>
                        <TextBlock Width="72"
                                   VerticalAlignment="Center"
                                   Text="{Binding CursorX, StringFormat={}{0:F1}}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Classes="paramLabel" Text="Y =" VerticalAlignment="Center"/>
                        <TextBlock Width="72"
                                   VerticalAlignment="Center"
                                   Text="{Binding CursorY, StringFormat={}{0:F1}}"/>
                    </StackPanel>
                </StackPanel>

                <Border Width="1" Background="#AEAEAE" Margin="5,4" IsVisible="{Binding ShowStatusBarDimensions}"/>

                <StackPanel Orientation="Horizontal" Spacing="8" Margin="5,0,10,0" VerticalAlignment="Center"
                            IsVisible="{Binding ShowStatusBarDimensions}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Classes="paramLabel" Text="L =" VerticalAlignment="Center"/>
                        <TextBlock Width="72"
                                   VerticalAlignment="Center"
                                   Text="{Binding StatusBarLength, StringFormat={}{0:F1}}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Classes="paramLabel" Text="H =" VerticalAlignment="Center"/>
                        <TextBlock Width="72"
                                   VerticalAlignment="Center"
                                   Text="{Binding StatusBarHeight, StringFormat={}{0:F1}}"/>
                    </StackPanel>
                </StackPanel>

                <Border Width="1" Background="#AEAEAE" Margin="5,4" IsVisible="{Binding IsImpostPanelActive}"/>

                <StackPanel Orientation="Horizontal" Spacing="8" Margin="5,0,10,0" VerticalAlignment="Center"
                            IsVisible="{Binding IsImpostPanelActive}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Classes="paramLabel" Text="L =" VerticalAlignment="Center"/>
                        <TextBox Width="72"
                                 Classes="coordField"
                                 VerticalAlignment="Center"
                                 Text="{Binding ImpostPanelL, Mode=TwoWay}"
                                 behaviors:SignedDecimalInputBehavior.AllowNegative="False"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Classes="paramLabel" Text="H =" VerticalAlignment="Center"/>
                        <TextBox Width="72"
                                 Classes="coordField"
                                 VerticalAlignment="Center"
                                 Text="{Binding ImpostPanelH, Mode=TwoWay}"
                                 behaviors:SignedDecimalInputBehavior.AllowNegative="False"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="8" Margin="5,0,10,0" VerticalAlignment="Center"
                            IsVisible="{Binding HasArcTopProfile}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Classes="paramLabel" Text="R =" VerticalAlignment="Center"/>
                        <TextBox Width="72"
                                 Classes="coordField"
                                 VerticalAlignment="Center"
                                 Text="{Binding TopProfileArcRadius, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 behaviors:SignedDecimalInputBehavior.AllowNegative="False"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Classes="paramLabel" Text="Arc H =" VerticalAlignment="Center"/>
                        <TextBox Width="72"
                                 Classes="coordField"
                                 VerticalAlignment="Center"
                                 Text="{Binding TopProfileArcHeight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 behaviors:SignedDecimalInputBehavior.AllowNegative="False"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
