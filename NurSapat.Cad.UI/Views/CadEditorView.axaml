<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:material="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vm="clr-namespace:NurSapat.Cad.UI.ViewModels;assembly=NurSapat.Cad.UI"
             xmlns:controls="clr-namespace:NurSapat.Cad.UI.Controls;assembly=NurSapat.Cad.UI"
             x:Class="NurSapat.Cad.UI.Views.CadEditorView"
             x:DataType="vm:CadEditorViewModel">

	<UserControl.Styles>
		<Style Selector="Button">
			<Setter Property="Background" Value="White"/>
			<Setter Property="BorderBrush" Value="#D1D5DB"/>
			<Setter Property="Foreground" Value="#333333"/>
			<Setter Property="CornerRadius" Value="4"/>
			<Setter Property="Height" Value="30"/>
			<Setter Property="Padding" Value="14,0"/>
			<!-- Добавим отступы для контента кнопки -->
			<Setter Property="HorizontalContentAlignment" Value="Left"/>
		</Style>
		<Style Selector="Button.active">
			<Setter Property="Background" Value="#2563EB"/>
			<Setter Property="BorderBrush" Value="#1D4ED8"/>
			<Setter Property="Foreground" Value="White"/>
		</Style>
		<Style Selector="GridSplitter">
			<Setter Property="Background" Value="#F3F4F6"/>
			<Setter Property="BorderBrush" Value="#E5E7EB"/>
			<Setter Property="BorderThickness" Value="1,0"/>
		</Style>
	</UserControl.Styles>

	<DockPanel LastChildFill="True">

		<!-- TOP TOOLBAR -->
		<Border DockPanel.Dock="Top" Height="44" Background="#F8F9FA" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" BoxShadow="0 1 2 rgba(0,0,0,0.05)">
			<StackPanel Orientation="Horizontal" Spacing="8" Margin="10,6">
				<!-- Пример кнопки с местом для иконки -->
				<Button>
					<StackPanel Orientation="Horizontal" Spacing="8">
						<!-- МЕСТО ДЛЯ ИКОНКИ: Width и Height задайте нужный размер -->
						<Border Width="16" Height="16" Background="Transparent"/>
						<TextBlock Text="Панорамирование" VerticalAlignment="Center" FontSize="12"/>
					</StackPanel>
				</Button>

				<Button Command="{Binding FitAllCommand}">
					<StackPanel Orientation="Horizontal" Spacing="8">
						<Border Width="16" Height="16" Background="Transparent"/>
						<TextBlock Text="Показать всё" VerticalAlignment="Center" FontSize="12"/>
					</StackPanel>
				</Button>

				<Button Command="{Binding ManualDimensionsCommand}">
					<StackPanel Orientation="Horizontal" Spacing="8">
						<Border Width="16" Height="16" Background="Transparent"/>
						<TextBlock Text="Ввод размеров" VerticalAlignment="Center" FontSize="12"/>
					</StackPanel>
				</Button>

				<Button Command="{Binding SaveTemplateCommand}">
					<StackPanel Orientation="Horizontal" Spacing="8">
						<Border Width="16" Height="16" Background="Transparent"/>
						<TextBlock Text="Сохранить шаблон" VerticalAlignment="Center" FontSize="12"/>
					</StackPanel>
				</Button>

				<Button Command="{Binding ToggleTrainingCommand}">
					<StackPanel Orientation="Horizontal" Spacing="8">
						<Border Width="16" Height="16" Background="Transparent"/>
						<TextBlock Text="Журнал обучения" VerticalAlignment="Center" FontSize="12"/>
					</StackPanel>
				</Button>

				<TextBlock Text="{Binding StatusText}" Foreground="#333333" VerticalAlignment="Center" Margin="12,0,0,0" FontSize="13"/>
			</StackPanel>
		</Border>

		<!-- BOTTOM PROPERTY BAR -->
		<Border DockPanel.Dock="Bottom" Height="92" Background="#F8F9FA" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0">
			<Grid ColumnDefinitions="*,Auto" Margin="16,8">
				<StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
					<TextBlock Text="Оконная конструкция" FontWeight="SemiBold" Foreground="#333333"/>
					<TextBlock Text="{Binding StatusText}" Foreground="#4B5563" FontSize="12"/>
				</StackPanel>
				<StackPanel Orientation="Horizontal" Spacing="8" Grid.Column="1">
					<Button Content="Применить" Height="28" Padding="12,0" CornerRadius="4" Background="#2563EB" Foreground="White"/>
					<Button Content="Сброс" Height="28" Padding="12,0" CornerRadius="4"/>
				</StackPanel>
			</Grid>
		</Border>

		<!-- CENTER AREA WITH SPLITTERS -->
		<Grid ColumnDefinitions="Auto,5,*,5,Auto">

			<!-- LEFT PANEL (Tools) -->
			<Border x:Name="LeftPanel"
                    Grid.Column="0"
                    Width="220"
                    MinWidth="80"
                    MaxWidth="400"
                    Background="#F8F9FA"
                    BorderBrush="#E5E7EB"
                    BorderThickness="0,0,1,0">
				<ScrollViewer>
					<StackPanel Margin="8">
						<TextBlock Text="Инструменты" FontWeight="Bold" Margin="0,0,0,8"/>
						<ListBox ItemsSource="{Binding Tools}" Background="Transparent" BorderThickness="0">
							<ListBox.ItemTemplate>
								<DataTemplate>
									<Button Classes.active="{Binding IsActive}"
                                            Command="{Binding $parent[UserControl].DataContext.ActivateToolCommand}"
                                            CommandParameter="{Binding Id}"
                                            HorizontalAlignment="Stretch"
                                            Margin="0,2"
                                            Height="36">
										<!-- Здесь мы размещаем иконку и текст -->
										<StackPanel Orientation="Horizontal" Spacing="8">
											<!-- МЕСТО ДЛЯ ИКОНКИ (ширина 20px, высота 20px) -->
											<Border Width="20" Height="20" Background="Transparent"/>
											<TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" FontSize="12"/>
										</StackPanel>
									</Button>
								</DataTemplate>
							</ListBox.ItemTemplate>
						</ListBox>
					</StackPanel>
				</ScrollViewer>
			</Border>

			<!-- LEFT SPLITTER -->
			<GridSplitter Grid.Column="1" Width="5" Background="Transparent" ResizeDirection="Columns" HorizontalAlignment="Stretch"/>

			<!-- CANVAS -->
			<Border Grid.Column="2" Background="#FAFAFA" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="4" Margin="2">
				<controls:CadCanvasControl Editor="{Binding}"/>
			</Border>

			<!-- RIGHT SPLITTER -->
			<GridSplitter Grid.Column="3" Width="5" Background="Transparent" ResizeDirection="Columns" HorizontalAlignment="Stretch"/>

			<!-- RIGHT PANEL (Properties) -->
			<Border x:Name="RightPanel"
                    Grid.Column="4"
                    Width="320"
                    MinWidth="200"
                    MaxWidth="600"
                    Background="#F8F9FA"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1,0,0,0">
				<ScrollViewer>
					<StackPanel Spacing="12" Margin="12">

						<!-- Секция: Геометрия (L, H, X, Y) -->
						<Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="12">
							<StackPanel>
								<TextBlock Text="Геометрия" FontWeight="SemiBold" FontSize="12" Foreground="#111827" Margin="0,0,0,10"/>

								<Grid ColumnDefinitions="*,*" ColumnSpacing="16" RowDefinitions="Auto,Auto" RowSpacing="8">
									<!-- Ширина -->
									<StackPanel Grid.Row="0" Grid.Column="0">
										<TextBlock Text="Ширина L, мм" FontSize="11" Foreground="#6B7280"/>
										<NumericUpDown Value="{Binding FrameWidth}" Minimum="300" Increment="10" Height="28" HorizontalAlignment="Stretch"/>
									</StackPanel>
									<!-- Высота -->
									<StackPanel Grid.Row="0" Grid.Column="1">
										<TextBlock Text="Высота H, мм" FontSize="11" Foreground="#6B7280"/>
										<NumericUpDown Value="{Binding FrameHeight}" Minimum="300" Increment="10" Height="28" HorizontalAlignment="Stretch"/>
									</StackPanel>
								</Grid>

								<Border Height="1" Background="#E5E7EB" Margin="0,10"/>

								<Grid ColumnDefinitions="*,*" ColumnSpacing="16" RowDefinitions="Auto,Auto" RowSpacing="8">
									<StackPanel Grid.Row="0" Grid.Column="0">
										<TextBlock Text="Координата X, мм" FontSize="11" Foreground="#6B7280"/>
										<NumericUpDown Value="{Binding SelectedImpostCoordinate}" Increment="5" Height="28" HorizontalAlignment="Stretch"/>
									</StackPanel>
									<StackPanel Grid.Row="0" Grid.Column="1">
										<TextBlock Text="Координата Y, мм" FontSize="11" Foreground="#6B7280"/>
										<NumericUpDown Value="{Binding SelectedImpostCoordinate}" Increment="5" Height="28" HorizontalAlignment="Stretch"/>
									</StackPanel>
								</Grid>
							</StackPanel>
						</Border>

						<!-- Секция: Профиль -->
						<Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="12">
							<StackPanel>
								<TextBlock Text="Профиль" FontWeight="SemiBold" FontSize="12" Foreground="#111827" Margin="0,0,0,10"/>

								<Grid ColumnDefinitions="*,Auto,*,Auto" ColumnSpacing="12">
									<StackPanel Grid.Column="0">
										<TextBlock Text="Серия" FontSize="11" Foreground="#6B7280"/>
										<ComboBox ItemsSource="{Binding ProfileSystems}"
                                                  SelectedItem="{Binding FrameProfileSystem}"
                                                  Height="28"
                                                  HorizontalAlignment="Stretch"
                                                  MinWidth="120"/>
									</StackPanel>

									<Border Grid.Column="1" Width="1" Height="32" Background="#E5E7EB" VerticalAlignment="Center"/>

									<StackPanel Grid.Column="2">
										<TextBlock Text="Цвет ламинации" FontSize="11" Foreground="#6B7280"/>
										<ComboBox ItemsSource="{Binding LaminationColors}"
                                                  SelectedItem="{Binding FrameLaminationColor}"
                                                  Height="28"
                                                  HorizontalAlignment="Stretch"
                                                  MinWidth="120"/>
									</StackPanel>

									<StackPanel Grid.Column="3" IsVisible="False"/>
								</Grid>
							</StackPanel>
						</Border>

						<!-- Секция: Створка / Фурнитура -->
						<Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="12" IsVisible="{Binding IsSashSelected}">
							<StackPanel>
								<TextBlock Text="Фурнитура" FontWeight="SemiBold" FontSize="12" Foreground="#111827" Margin="0,0,0,8"/>
								<Grid ColumnDefinitions="*,*" ColumnSpacing="8">
									<StackPanel>
										<TextBlock Text="Тип" FontSize="11" Foreground="#6B7280"/>
										<ComboBox ItemsSource="{Binding OpeningTypes}" SelectedItem="{Binding SelectedOpeningType}" Height="28"/>
									</StackPanel>
									<StackPanel>
										<TextBlock Text="Бренд" FontSize="11" Foreground="#6B7280"/>
										<ComboBox ItemsSource="{Binding HardwareBrands}" SelectedItem="{Binding SelectedHardwareBrand}" Height="28"/>
									</StackPanel>
								</Grid>
								<StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
									<CheckBox Content="Доводчик" IsChecked="{Binding HasCloser}" Foreground="#333333"/>
									<CheckBox Content="Замок" IsChecked="{Binding HasLock}" Foreground="#333333"/>
									<CheckBox Content="Ограничитель" IsChecked="{Binding HasLimiter}" Foreground="#333333"/>
								</StackPanel>
							</StackPanel>
						</Border>

						<!-- Секция: Стеклопакет -->
						<Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="12" IsVisible="{Binding IsGlazingSelected}">
							<StackPanel>
								<TextBlock Text="Стеклопакет" FontWeight="SemiBold" FontSize="12" Foreground="#111827" Margin="0,0,0,8"/>
								<ComboBox ItemsSource="{Binding GlassFormulas}" SelectedItem="{Binding SelectedGlassFormula}" Height="28"/>
							</StackPanel>
						</Border>

					</StackPanel>
				</ScrollViewer>
			</Border>
		</Grid>
	</DockPanel>
</UserControl>