<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:NurSapat.Cad.UI.ViewModels;assembly=NurSapat.Cad.UI"
             xmlns:controls="clr-namespace:NurSapat.Cad.UI.Controls;assembly=NurSapat.Cad.UI"
             xmlns:converters="clr-namespace:NurSapat.Cad.UI.Converters;assembly=NurSapat.Cad.UI"
             x:Class="NurSapat.Cad.UI.Views.CadEditorView"
             x:DataType="vm:CadEditorViewModel">

    <UserControl.Resources>
        <converters:LeftPanelIconConverter x:Key="LeftIconConverter" />
        <converters:RightPanelIconConverter x:Key="RightIconConverter" />
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="#202124"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style Selector="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="#202124"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Padding" Value="8,4"/>
        </Style>
        <Style Selector="Button:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#EEF3FE"/>
            <Setter Property="BorderBrush" Value="#C7D8FA"/>
        </Style>
        <Style Selector="Button.toolListItem">
            <Setter Property="Height" Value="33"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.toolListItem.active">
            <Setter Property="Background" Value="#E8F0FE"/>
            <Setter Property="BorderBrush" Value="#1A73E8"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="TextBlock.mdlIcon">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="21"/>
            <Setter Property="Foreground" Value="#1A73E8"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBlock.sectionTitle">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style Selector="TextBlock.propertyLabel">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#3C4043"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBox, NumericUpDown, ComboBox">
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style Selector="CheckBox">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#202124"/>
        </Style>

        <!-- СТИЛИ ДЛЯ КНОПОК СВОРАЧИВАНИЯ -->
        <Style Selector="Button.panelToggle">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="60"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#DCDCDC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="#5F6368"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        
        <Style Selector="Button.panelToggle.left">
            <Setter Property="CornerRadius" Value="0,4,4,0"/>
            <Setter Property="Margin" Value="-1,0,0,0"/>
        </Style>
        
        <Style Selector="Button.panelToggle.right">
            <Setter Property="CornerRadius" Value="4,0,0,4"/>
            <Setter Property="Margin" Value="0,0,-1,0"/>
        </Style>

        <Style Selector="Button.panelToggle:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#E7F1FF"/>
            <Setter Property="BorderBrush" Value="#1A73E8"/>
            <Setter Property="Foreground" Value="#1A73E8"/>
        </Style>

        <Style Selector="Button.panelToggle:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#D7E8FF"/>
            <Setter Property="BorderBrush" Value="#1A73E8"/>
        </Style>

        <Style Selector="ToggleButton.toggleBtn">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style Selector="ToggleButton.toggleBtn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#F1F3F4"/>
            <Setter Property="BorderBrush" Value="#DADCE0"/>
        </Style>

        <Style Selector="ToggleButton.toggleBtn:checked /template/ ContentPresenter">
            <Setter Property="Background" Value="#E8F0FE"/> <Setter Property="BorderBrush" Value="#1A73E8"/>  </Style>

        <Style Selector="ToggleButton.toggleBtn:checked TextBlock.mdlIcon">
            <Setter Property="Foreground" Value="#1A73E8"/>  </Style>

        <Style Selector="ToggleButton.toggleBtn:checked:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#D2E3FC"/>
            <Setter Property="BorderBrush" Value="#1A73E8"/>
        </Style>

        <Style Selector="ToggleButton.toggleBtn:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#E0E0E0"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="*,34">
        <!-- ОСНОВНАЯ ОБЛАСТЬ (Левая панель, Центр, Правая панель) -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto">
        
            <!-- Левая панель (Инструменты) -->
            <Border x:Name="LeftPanel" 
                    Grid.Column="0" 
                    Width="260"
                    Background="#F8F9FA" 
                    BorderBrush="#DCDCDC" 
                    BorderThickness="0,0,1,0" 
                    ZIndex="2"
                    IsVisible="{Binding IsLeftPanelVisible}">
                <ScrollViewer>
                    <StackPanel Margin="14,10" Spacing="8">
                        <TextBlock Text="Инструменты" FontWeight="SemiBold"/>
                        <ItemsControl ItemsSource="{Binding Tools}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Classes.toolListItem="True"
                                            Classes.active="{Binding IsActive}"
                                            Command="{Binding $parent[UserControl].DataContext.ActivateToolCommand}"
                                            CommandParameter="{Binding Id}">
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <TextBlock Classes="mdlIcon" Text="&#xE8B0;" FontSize="16" Width="22"/>
                                            <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- КНОПКА СВОРАЧИВАНИЯ ЛЕВОЙ ПАНЕЛИ -->
            <Button Grid.Column="1" 
                    Command="{Binding ToggleLeftPanelCommand}" 
                    Classes="panelToggle left"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    ZIndex="10">
                <TextBlock Text="{Binding IsLeftPanelVisible, Converter={StaticResource LeftIconConverter}}"/>
            </Button>

            <controls:CadSceneControl Grid.Column="1" 
                                      Editor="{Binding}" 
                                      ClipToBounds="True"/>

            <!-- КНОПКА СВОРАЧИВАНИЯ ПРАВОЙ ПАНЕЛИ -->
            <Button Grid.Column="1" 
                    Command="{Binding ToggleRightPanelCommand}" 
                    Classes="panelToggle right"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    ZIndex="10">
                <TextBlock Text="{Binding IsRightPanelVisible, Converter={StaticResource RightIconConverter}}"/>
            </Button>

            <!-- Правая панель (Свойства) -->
            <Border x:Name="RightPanel" 
                    Grid.Column="2" 
                    Width="320"
                    Background="#F8F9FA" 
                    BorderBrush="#DCDCDC" 
                    BorderThickness="1,0,0,0" 
                    ZIndex="2"
                    IsVisible="{Binding IsRightPanelVisible}">
                <ScrollViewer>
                    <StackPanel Margin="14,12" Spacing="0">
                        <TextBlock Text="Свойства" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,12"/>
                        <Border Height="1" Background="#DCDCDC"/>

                        <StackPanel Margin="0,14" Spacing="10">
                            <TextBlock Classes="sectionTitle" Text="Геометрия"/>
                            <Grid ColumnDefinitions="*,146" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="8">
                                <TextBlock Classes="propertyLabel" Text="Ширина (L), мм"/>
                                <NumericUpDown Grid.Column="1" Value="1000" Minimum="300" Increment="10"/>
                                <TextBlock Grid.Row="1" Classes="propertyLabel" Text="Высота (H), мм"/>
                                <NumericUpDown Grid.Row="1" Grid.Column="1" Value="1000" Minimum="300" Increment="10"/>
                                <TextBlock Grid.Row="2" Classes="sectionTitle" Text="Положение" Margin="0,8,0,0"/>
                                <TextBlock Grid.Row="3" Classes="propertyLabel" Text="X, мм"/>
                                <NumericUpDown Grid.Row="3" Grid.Column="1" Value="0" IsEnabled="False"/>
                            </Grid>
                            <Grid ColumnDefinitions="*,146">
                                <TextBlock Classes="propertyLabel" Text="Y, мм"/>
                                <NumericUpDown Grid.Column="1" Value="0" IsEnabled="False"/>
                            </Grid>
                        </StackPanel>
                        <Border Height="1" Background="#DCDCDC"/>

                        <StackPanel Margin="0,14" Spacing="10">
                            <TextBlock Classes="sectionTitle" Text="Профиль"/>
                            <Grid ColumnDefinitions="*,146" RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                                <TextBlock Classes="propertyLabel" Text="Система"/>
                                <ComboBox Grid.Column="1" SelectedIndex="0"> 
                                    <ComboBoxItem Content="Rehau Euro 70"/>
                                    <ComboBoxItem Content="KBE Expert 70"/>
                                    <ComboBoxItem Content="Veka Softline 70"/>
                                </ComboBox>
                                <TextBlock Grid.Row="1" Classes="propertyLabel" Text="Ширина профиля"/>
                                <ComboBox Grid.Row="1" Grid.Column="1" SelectedIndex="0">
                                    <ComboBoxItem Content="70 мм"/>
                                    <ComboBoxItem Content="72 мм"/>
                                    <ComboBoxItem Content="58 мм"/>
                                </ComboBox>
                                <TextBlock Grid.Row="2" Classes="propertyLabel" Text="Цвет ламинации"/>
                                <Grid Grid.Row="2" Grid.Column="1" ColumnDefinitions="*,32,28" ColumnSpacing="6">
                                    <ComboBox SelectedIndex="0">
                                        <ComboBoxItem Content="Белый"/>
                                        <ComboBoxItem Content="Золотой дуб"/>
                                        <ComboBoxItem Content="Антрацит"/>
                                    </ComboBox>
                                    <Border Grid.Column="1" Width="24" Height="24" Background="White" BorderBrush="#CFCFCF" BorderThickness="1" CornerRadius="3"/>
                                    <Button Grid.Column="2" Padding="0" Content="..."/>
                                </Grid>
                            </Grid>
                        </StackPanel>
                        <Border Height="1" Background="#DCDCDC"/>

                        <StackPanel Margin="0,14" Spacing="10" IsVisible="False">
                            <TextBlock Classes="sectionTitle" Text="Створка"/>
                            <Grid ColumnDefinitions="*,164" RowDefinitions="Auto,Auto" RowSpacing="8">
                                <TextBlock Classes="propertyLabel" Text="Тип"/>
                                <ComboBox Grid.Column="1" SelectedIndex="0">
                                    <ComboBoxItem Content="Поворотно-откидная"/>
                                    <ComboBoxItem Content="Поворотная"/>
                                </ComboBox>
                                <TextBlock Grid.Row="1" Classes="propertyLabel" Text="Направление"/>
                                <ComboBox Grid.Row="1" Grid.Column="1" SelectedIndex="0">
                                    <ComboBoxItem Content="Правая"/>
                                    <ComboBoxItem Content="Левая"/>
                                </ComboBox>
                            </Grid>
                            <CheckBox Content="Доводчик" IsChecked="False"/>
                            <CheckBox Content="Микропроветривание" IsChecked="False"/>
                            <CheckBox Content="Замок" IsChecked="False"/>
                        </StackPanel>
                        <Border Height="1" Background="#DCDCDC" IsVisible="False"/>

                        <StackPanel Margin="0,14" Spacing="10">
                            <TextBlock Classes="sectionTitle" Text="Стеклопакет"/>
                            <Grid ColumnDefinitions="*,164" RowDefinitions="Auto,Auto" RowSpacing="8">
                                <TextBlock Classes="propertyLabel" Text="Формула"/>
                                <ComboBox Grid.Column="1" SelectedIndex="0">
                                    <ComboBoxItem Content="4-16-4"/>
                                    <ComboBoxItem Content="4LowE-16-4"/>
                                    <ComboBoxItem Content="4-10-4-10-4"/>
                                </ComboBox>
                                <TextBlock Grid.Row="1" Classes="propertyLabel" Text="Толщина, мм"/>
                                <NumericUpDown Grid.Row="1" Grid.Column="1" Value="24" IsEnabled="False"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- НИЖНЯЯ ПАНЕЛЬ -->
        <Border Grid.Row="1" Background="#F8F9FA" BorderBrush="#DCDCDC" BorderThickness="0,1,0,0" IsVisible="{Binding IsBottomPanelVisible}">
            <Grid ColumnDefinitions="*,Auto,*" Margin="16,0">
                <StackPanel Orientation="Horizontal" Spacing="22" VerticalAlignment="Center">
                    <!-- Исправление: вместо StringFormat используем Run -->
                    <TextBlock>
                        <Run Text="X: "/><Run Text="{Binding CursorX}"/><Run Text=" мм"/>
                    </TextBlock>
                    <TextBlock>
                        <Run Text="Y: "/><Run Text="{Binding CursorY}"/><Run Text=" мм"/>
                    </TextBlock>
                    <TextBlock Text="L: 1000 мм"/>
                    <TextBlock Text="H: 1000 мм"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock>
                        <Run Text="Масштаб: "/><Run Text="{Binding ZoomPercent}"/>
                    </TextBlock>
    
                    <ToggleButton IsChecked="{Binding IsGridEnabled}" Classes="toggleBtn" ToolTip.Tip="Отображать сетку">
                        <TextBlock Classes="mdlIcon" Text="&#xECA5;" FontSize="15" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </ToggleButton>
    
                    <ToggleButton IsChecked="{Binding IsSnapEnabled}" Classes="toggleBtn" ToolTip.Tip="Привязка к сетке и объектам">
                        <TextBlock Classes="mdlIcon" Text="&#xE8B0;" FontSize="15" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </ToggleButton>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="18" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="Ничего"/>
                    <TextBlock>
                        <Run Text="Инструмент: "/><Run Text="{Binding ActiveToolDisplayName}"/>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>