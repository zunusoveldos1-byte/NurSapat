<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:NurSapat.App.ViewModels.Utilities"
        x:Class="NurSapat.App.Views.Utilities.DealerBaseWindow"
        x:DataType="vm:DealerBaseViewModel"
        Width="460"
        Height="260"
        MinWidth="420"
        MinHeight="240"
        WindowStartupLocation="CenterOwner"
        WindowDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="-1"
        Background="Transparent"
        FontFamily="Inter">

    <Window.Styles>
        <StyleInclude Source="/Styles/MaterialsDictionaryStyles.axaml"/>
    </Window.Styles>

    <Border Classes="mat-shell" Margin="12">
        <Grid RowDefinitions="32,*,Auto">
            <Border Grid.Row="0"
                    Classes="mat-titlebar"
                    PointerPressed="OnTitleBarPointerPressed">
                <Grid ColumnDefinitions="*,46">
                    <TextBlock Classes="mat-titlebar-text"
                               Margin="16,0,0,0"
                               Text="Формирование дилерской базы"/>
                    <Button Grid.Column="1"
                            Classes="mat-chrome-btn close"
                            Click="OnCloseClick"
                            Content="✕"
                            Width="46"
                            Height="32"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"/>
                </Grid>
            </Border>

            <StackPanel Grid.Row="1" Margin="16,0,16,0" Spacing="10">
                <TextBlock Text="Пароль защиты (необязательно)"
                           FontSize="12"
                           Foreground="#64748B"/>
                <Grid ColumnDefinitions="*,Auto">
                    <TextBox Text="{Binding ProtectionPassword}"
                             PasswordChar="{Binding PasswordChar}"
                             PlaceholderText="Оставьте пустым для незашифрованного пакета"
                             MinHeight="34"
                             VerticalContentAlignment="Center"/>
                    <Button Grid.Column="1"
                            Classes="mat-toolbar"
                            Margin="6,0,0,0"
                            Width="34"
                            Height="34"
                            Padding="0"
                            ToolTip.Tip="Показать пароль"
                            Command="{Binding TogglePasswordVisibilityCommand}"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center">
                        <TextBlock Text="👁" FontSize="14"/>
                    </Button>
                </Grid>

                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="#DC2626"
                           TextWrapping="Wrap"
                           FontSize="12"
                           MinHeight="18"/>
            </StackPanel>

            <Border Grid.Row="2" Padding="16" Background="#F8FAFC" CornerRadius="0,0,12,12">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Spacing="8">
                    <Button Classes="mat-primary"
                            Content="Сформировать (dealer.zp / .nursapat)"
                            Command="{Binding ExportCommand}"
                            IsEnabled="{Binding !IsBusy}"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"/>
                    <Button Classes="mat-toolbar"
                            Content="Отмена"
                            Command="{Binding CancelCommand}"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
