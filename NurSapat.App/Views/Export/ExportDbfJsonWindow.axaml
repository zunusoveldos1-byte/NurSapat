<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:NurSapat.App.ViewModels.Export"
        x:Class="NurSapat.App.Views.Export.ExportDbfJsonWindow"
        x:DataType="vm:ExportDbfJsonViewModel"
        Width="500"
        Height="320"
        MinWidth="460"
        MinHeight="300"
        WindowStartupLocation="CenterOwner"
        WindowDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="-1"
        Background="Transparent"
        FontFamily="Inter">

    <Window.Styles>
        <StyleInclude Source="/Styles/MaterialsDictionaryStyles.axaml"/>
    </Window.Styles>

    <Border Classes="mat-shell" Margin="12">
        <Grid RowDefinitions="40,*,Auto">
            <Border Grid.Row="0"
                    Classes="mat-titlebar"
                    PointerPressed="OnTitleBarPointerPressed">
                <Grid ColumnDefinitions="*,46">
                    <TextBlock Classes="mat-titlebar-text"
                               Margin="16,0,0,0"
                               Text="Экспорт списания во внешний склад (JSON / DBF)"/>
                    <Button Grid.Column="1"
                            Classes="mat-chrome-btn close"
                            Click="OnCloseClick"
                            Content="✕"
                            Width="46"
                            Height="32"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"/>
                </Grid>
            </Border>

            <StackPanel Grid.Row="1" Margin="16,12,16,0" Spacing="12">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBox Text="{Binding ExportFolderPath}"
                             PlaceholderText="Папка назначения"
                             MinHeight="34"
                             VerticalContentAlignment="Center"/>
                    <Button Grid.Column="1"
                            Classes="mat-toolbar"
                            Content="Обзор..."
                            Command="{Binding BrowseFolderCommand}"
                            MinWidth="88"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"/>
                </Grid>

                <Border Classes="mat-card" Padding="12">
                    <StackPanel Spacing="8">
                        <RadioButton Content="Сформировать вечный снимок заказа (JSON)"
                                     IsChecked="{Binding ExportJsonSnapshot}"/>
                        <RadioButton Content="Сформировать файлы dBASE 5.0 (Base1.dbf - Base5.dbf) для старого склада"
                                     IsChecked="{Binding ExportDbfFiles}"/>
                    </StackPanel>
                </Border>

                <ProgressBar Minimum="0"
                             Maximum="100"
                             Value="{Binding ProgressValue}"
                             IsVisible="{Binding IsProgressVisible}"
                             Height="8"/>

                <TextBlock Text="{Binding StatusText}"
                           TextWrapping="Wrap"
                           Foreground="#64748B"
                           FontSize="12"/>
            </StackPanel>

            <Border Grid.Row="2" Padding="16" Background="#F8FAFC" CornerRadius="0,0,12,12">
                <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                    <Button Grid.Column="0"
                            Classes="mat-primary"
                            Content="Экспортировать"
                            Command="{Binding ExportCommand}"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"/>
                    <Button Grid.Column="1"
                            Classes="mat-toolbar"
                            Margin="8,0,0,0"
                            Content="Открыть папку DATA"
                            Command="{Binding OpenDataFolderCommand}"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"/>
                    <Button Grid.Column="3"
                            Classes="mat-toolbar"
                            Content="Закрыть"
                            Command="{Binding CloseCommand}"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
