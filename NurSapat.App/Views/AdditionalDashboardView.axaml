<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:NurSapat.App.ViewModels"
             x:Class="NurSapat.App.Views.AdditionalDashboardView"
             x:Name="Root"
             x:DataType="vm:AdditionalDashboardViewModel">
    <UserControl.Styles>
        <StyleInclude Source="/Styles/AdditionalDashboardStyles.axaml"/>
        <Style Selector="TextBlock.oc-timeline-label">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style Selector="TextBlock.oc-timeline-label.selected">
            <Setter Property="Foreground" Value="#2F80ED"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </UserControl.Styles>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <Grid Background="#F7F9FC"
              Margin="16"
              RowDefinitions="Auto,*,Auto"
              RowSpacing="16">

            <Border Grid.Row="0" Classes="oc-header-panel">
                <Grid ColumnDefinitions="*,Auto">
                    <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnSpacing="28">
                        <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                            <TextBlock Text="{Binding OrderNumberDisplay}"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="#0F172A"/>
                            <TextBlock Text="{Binding OrderStatus}"
                                       FontSize="13"
                                       Foreground="#64748B"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                            <TextBlock Classes="oc-label" Text="Клиент"/>
                            <TextBlock Classes="oc-value" Text="{Binding CustomerNameDisplay}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="4" VerticalAlignment="Center">
                            <TextBlock Classes="oc-label" Text="Создан"/>
                            <TextBlock Classes="oc-value" Text="{Binding CreatedDateText}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="3" Spacing="4" VerticalAlignment="Center">
                            <TextBlock Classes="oc-label" Text="Менеджер"/>
                            <TextBlock Classes="oc-value" Text="{Binding ManagerName}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="4" Spacing="4" VerticalAlignment="Center">
                            <TextBlock Classes="oc-label" Text="Последнее изменение"/>
                            <TextBlock Classes="oc-value" Text="{Binding LastModifiedAgo}"/>
                        </StackPanel>
                    </Grid>
                    <Border Grid.Column="1"
                            Classes="oc-status-badge"
                            Background="{Binding OrderStatusBackground}"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{Binding OrderStatusEmoji}" FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding OrderStatusBadge}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{Binding OrderStatusForeground}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Row="1" ColumnDefinitions="22*,12,56*,12,22*">
                <StackPanel Grid.Column="0" Spacing="16">
                    <Border Classes="oc-card">
                        <StackPanel Spacing="16">
                            <TextBlock Classes="oc-title" Text="Шаблон заказа"/>
                            <StackPanel Spacing="8">
                                <TextBlock Classes="oc-label" Text="Шаблон"/>
                                <ComboBox Classes="oc-field"
                                          ItemsSource="{Binding Templates}"
                                          SelectedItem="{Binding SelectedTemplate}"
                                          HorizontalAlignment="Stretch">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate DataType="vm:OrderTemplateOption">
                                            <TextBlock Text="{Binding Title}" FontSize="13"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Spacing="8">
                                <TextBlock Classes="oc-section" Text="Будут изменены"/>
                                <ItemsControl ItemsSource="{Binding TemplateImpacts}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="vm:OrderTemplateImpactItem">
                                            <Border Classes="oc-impact-item" Margin="0,0,0,6">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="✔" Foreground="#27AE60" FontSize="13"/>
                                                    <TextBlock Text="{Binding Title}" Classes="oc-value"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <Button Classes="oc-primary"
                                    Content="Применить шаблон"
                                    Command="{Binding SyncOrderWithTemplateCommand}"
                                    HorizontalAlignment="Stretch"/>
                        </StackPanel>
                    </Border>

                    <Border Classes="oc-card">
                        <StackPanel Spacing="14">
                            <TextBlock Classes="oc-title" Text="Профиль изделия"/>
                            <ItemsControl ItemsSource="{Binding ProfileFields}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="vm:OrderProfileField">
                                        <Border Classes="oc-profile-row" Margin="0,0,0,6">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Text="{Binding Label}" Classes="oc-label" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Value}" Classes="oc-value" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Classes="oc-secondary"
                                    Content="Редактировать"
                                    Command="{Binding EditProfileCommand}"
                                    HorizontalAlignment="Stretch"/>
                        </StackPanel>
                    </Border>

                    <Border Classes="oc-card">
                        <StackPanel Spacing="12">
                            <TextBlock Classes="oc-title" Text="Автоматизация"/>
                            <ItemsControl ItemsSource="{Binding AutomationRules}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="vm:OrderAutomationToggle">
                                        <ToggleSwitch Classes="oc-switch"
                                                      Content="{Binding Title}"
                                                      IsChecked="{Binding IsEnabled}"
                                                      Margin="0,0,0,8"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Classes="oc-ghost"
                                    Content="Настроить автоматизацию"
                                    Command="{Binding ConfigureAutomationCommand}"
                                    HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Border Grid.Column="2" Classes="oc-card" Padding="20">
                    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="16">
                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                            <TextBlock Classes="oc-title" Text="Этапы выполнения заказа" VerticalAlignment="Center"/>
                            <ToggleSwitch Grid.Column="1"
                                          Classes="oc-switch"
                                          Content="Заблокировать изменения"
                                          IsChecked="{Binding IsOrderLocked}"/>
                        </Grid>

                        <Grid Grid.Row="1">
                            <Border Height="2"
                                    Background="#E2E8F0"
                                    VerticalAlignment="Top"
                                    Margin="40,13,40,0"/>
                            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding Stages}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="0"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="vm:OrderStageCard">
                                        <Button Background="Transparent"
                                                BorderThickness="0"
                                                Padding="4,0"
                                                Cursor="Hand"
                                                Command="{Binding #Root.((vm:AdditionalDashboardViewModel)DataContext).SelectStageCommand}"
                                                CommandParameter="{Binding}">
                                            <StackPanel Spacing="8" Width="88" HorizontalAlignment="Center">
                                                <Border Classes="oc-timeline-node"
                                                        Classes.selected="{Binding IsSelected}"
                                                        Background="White"
                                                        BorderBrush="{Binding TimelineForeground}">
                                                    <TextBlock Text="{Binding TimelineIcon}"
                                                               FontSize="13"
                                                               FontWeight="Bold"
                                                               Foreground="{Binding TimelineForeground}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="{Binding ShortTitle}"
                                                           Classes="oc-timeline-label"
                                                           Classes.selected="{Binding IsSelected}"/>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            </ScrollViewer>
                        </Grid>

                        <Border Grid.Row="2"
                                Classes="oc-stage-detail"
                                IsVisible="{Binding SelectedStage, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <StackPanel Spacing="14" DataContext="{Binding SelectedStage}">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Classes="oc-section" Text="{Binding Title}"/>
                                    <Border Grid.Column="1" CornerRadius="8" Padding="8,4" Background="{Binding StatusBackground}">
                                        <TextBlock Text="{Binding Status}" FontSize="12" FontWeight="SemiBold" Foreground="{Binding StatusForeground}"/>
                                    </Border>
                                </Grid>
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                    <StackPanel Spacing="4">
                                        <TextBlock Classes="oc-label" Text="Ответственный"/>
                                        <TextBlock Classes="oc-value" Text="{Binding Responsible}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <TextBlock Classes="oc-label" Text="Дата начала"/>
                                        <TextBlock Classes="oc-value" Text="{Binding StartDateText}"/>
                                    </StackPanel>
                                </Grid>
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                    <StackPanel Spacing="4">
                                        <TextBlock Classes="oc-label" Text="Дата окончания"/>
                                        <TextBlock Classes="oc-value" Text="{Binding EndDateText}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <TextBlock Classes="oc-label" Text="Комментарий"/>
                                        <TextBlock Classes="oc-value" Text="{Binding Comment, TargetNullValue=—}"/>
                                    </StackPanel>
                                </Grid>
                                <StackPanel Spacing="6">
                                    <TextBlock Classes="oc-label" Text="Автоматические действия"/>
                                    <ItemsControl ItemsSource="{Binding AutomationActions}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2">
                                                    <TextBlock Text="↓" Foreground="#94A3B8"/>
                                                    <TextBlock Text="{Binding}" Classes="oc-value"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button Classes="oc-primary"
                                            Content="Перевести на следующий этап"
                                            Command="{Binding #Root.((vm:AdditionalDashboardViewModel)DataContext).AdvanceStageCommand}"
                                            IsEnabled="{Binding #Root.((vm:AdditionalDashboardViewModel)DataContext).CanAdvanceSelectedStage}"/>
                                    <Button Classes="oc-secondary"
                                            Content="Отменить этап"
                                            Command="{Binding #Root.((vm:AdditionalDashboardViewModel)DataContext).CancelStageCommand}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <StackPanel Grid.Row="4" Spacing="12">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Button Classes="oc-tab" Classes.active="{Binding IsHistoryTabSelected}" Content="История" Command="{Binding SelectDetailTabCommand}" CommandParameter="0"/>
                                <Button Classes="oc-tab" Classes.active="{Binding IsFilesTabSelected}" Content="Файлы" Command="{Binding SelectDetailTabCommand}" CommandParameter="1"/>
                                <Button Classes="oc-tab" Classes.active="{Binding IsCommentsTabSelected}" Content="Комментарии" Command="{Binding SelectDetailTabCommand}" CommandParameter="2"/>
                                <Button Classes="oc-tab" Classes.active="{Binding IsRemindersTabSelected}" Content="Напоминания" Command="{Binding SelectDetailTabCommand}" CommandParameter="3"/>
                                <Button Classes="oc-tab" Classes.active="{Binding IsControlTabSelected}" Content="Контроль" Command="{Binding SelectDetailTabCommand}" CommandParameter="4"/>
                                <Button Classes="oc-tab" Classes.active="{Binding IsFinanceTabSelected}" Content="Финансы" Command="{Binding SelectDetailTabCommand}" CommandParameter="5"/>
                            </StackPanel>

                            <Border Classes="oc-stage-detail" MinHeight="240" MaxHeight="340">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <Panel>
                                        <StackPanel Spacing="12" IsVisible="{Binding IsHistoryTabSelected}">
                                            <ItemsControl ItemsSource="{Binding HistoryEvents}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="vm:OrderHistoryEvent">
                                                        <Grid ColumnDefinitions="56,Auto,*" Margin="0,0,0,14">
                                                            <TextBlock Grid.Column="0" Text="{Binding TimeText}" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A"/>
                                                            <Border Grid.Column="1" Classes="oc-history-badge" Background="{Binding CategoryBackground}" Margin="0,0,12,0" VerticalAlignment="Top">
                                                                <TextBlock Text="{Binding CategoryLabel}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding CategoryForeground}"/>
                                                            </Border>
                                                            <StackPanel Grid.Column="2" Spacing="2">
                                                                <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A"/>
                                                                <TextBlock Text="{Binding Details}" FontSize="12" Foreground="#64748B" TextWrapping="Wrap"/>
                                                                <TextBlock Text="{Binding User}" FontSize="11" Foreground="#94A3B8"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>

                                        <StackPanel Spacing="12" IsVisible="{Binding IsFilesTabSelected}">
                                            <WrapPanel Orientation="Horizontal">
                                                <ItemsControl ItemsSource="{Binding Files}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel Orientation="Horizontal"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="vm:OrderFileCard">
                                                            <Border Classes="oc-file-card" Margin="0,0,10,10">
                                                                <StackPanel Spacing="8" Width="120">
                                                                    <Border CornerRadius="8" Padding="6,4" Background="{Binding TypeBackground}" HorizontalAlignment="Left">
                                                                        <TextBlock Text="{Binding TypeLabel}" FontSize="11" FontWeight="Bold" Foreground="{Binding TypeForeground}"/>
                                                                    </Border>
                                                                    <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                                    <TextBlock Text="{Binding SizeText}" Classes="oc-muted"/>
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </WrapPanel>
                                            <Border Classes="oc-drop-zone">
                                                <StackPanel Spacing="8" HorizontalAlignment="Center">
                                                    <TextBlock Text="Перетащите файлы сюда" Classes="oc-value" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="PDF, фото, DWG, DXF" Classes="oc-muted" HorizontalAlignment="Center"/>
                                                    <Button Classes="oc-secondary" Content="Добавить файл" Command="{Binding AddSampleFileCommand}" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>

                                        <StackPanel Spacing="12" IsVisible="{Binding IsCommentsTabSelected}">
                                            <ItemsControl ItemsSource="{Binding Comments}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="vm:OrderCommentMessage">
                                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Margin="0,0,0,14">
                                                            <Border Classes="oc-avatar" Background="{Binding AvatarBackground}">
                                                                <TextBlock Text="{Binding Initials}" FontWeight="Bold" Foreground="{Binding AvatarForeground}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                            <StackPanel Grid.Column="1" Spacing="4">
                                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                                    <TextBlock Text="{Binding Author}" FontWeight="SemiBold" FontSize="13"/>
                                                                    <TextBlock Text="{Binding TimeText}" Classes="oc-muted"/>
                                                                </StackPanel>
                                                                <Border Classes="oc-comment-bubble">
                                                                    <TextBlock Text="{Binding Message}" FontSize="13" TextWrapping="Wrap"/>
                                                                </Border>
                                                            </StackPanel>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                <TextBox Grid.Column="0" Classes="oc-comment-input" Text="{Binding NewCommentText}"/>
                                                <Button Grid.Column="1" Classes="oc-primary" Content="Отправить" Command="{Binding SendCommentCommand}"/>
                                            </Grid>
                                        </StackPanel>

                                        <StackPanel Spacing="10" IsVisible="{Binding IsRemindersTabSelected}">
                                            <ItemsControl ItemsSource="{Binding Reminders}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="vm:OrderReminderItem">
                                                        <Border Classes="oc-profile-row" Margin="0,0,0,8">
                                                            <Grid ColumnDefinitions="Auto,*,Auto">
                                                                <ToggleSwitch IsChecked="{Binding IsCompleted}" Width="44"/>
                                                                <StackPanel Grid.Column="1" Margin="8,0,0,0" Spacing="2">
                                                                    <TextBlock Text="{Binding Title}" Classes="oc-value"/>
                                                                    <TextBlock Text="{Binding DueText}" Classes="oc-muted"/>
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>

                                        <StackPanel Spacing="10" IsVisible="{Binding IsControlTabSelected}">
                                            <ItemsControl ItemsSource="{Binding ChecklistItems}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="vm:OrderChecklistItem">
                                                        <Border Classes="oc-profile-row" Margin="0,0,0,8">
                                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                                <TextBlock Text="{Binding StatusIcon}" FontSize="14" Foreground="{Binding StatusForeground}" VerticalAlignment="Center"/>
                                                                <StackPanel Spacing="2">
                                                                    <TextBlock Text="{Binding Title}" Classes="oc-value"/>
                                                                    <TextBlock Text="{Binding Details}" Classes="oc-muted" IsVisible="{Binding Details, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Text="Пока есть ошибки, нельзя отправить заказ дальше."
                                                       Classes="oc-muted"
                                                       IsVisible="{Binding HasBlockingChecklistErrors}"/>
                                        </StackPanel>

                                        <StackPanel Spacing="10" IsVisible="{Binding IsFinanceTabSelected}">
                                            <UniformGrid Columns="2" Rows="3">
                                                <Border Classes="oc-finance-tile" Margin="0,0,8,8">
                                                    <StackPanel Spacing="4">
                                                        <TextBlock Classes="oc-label" Text="Стоимость"/>
                                                        <TextBlock Classes="oc-value" FontSize="18" Text="{Binding TotalCostText}"/>
                                                    </StackPanel>
                                                </Border>
                                                <Border Classes="oc-finance-tile" Margin="4,0,0,8">
                                                    <StackPanel Spacing="4">
                                                        <TextBlock Classes="oc-label" Text="Скидка"/>
                                                        <TextBlock Classes="oc-value" FontSize="18" Text="{Binding DiscountText}"/>
                                                    </StackPanel>
                                                </Border>
                                                <Border Classes="oc-finance-tile" Margin="0,0,8,8">
                                                    <StackPanel Spacing="4">
                                                        <TextBlock Classes="oc-label" Text="Оплачено"/>
                                                        <TextBlock FontSize="18" FontWeight="Bold" Foreground="{Binding PaidAmountForeground}" Text="{Binding PaidAmountText}"/>
                                                    </StackPanel>
                                                </Border>
                                                <Border Classes="oc-finance-tile" Margin="4,0,0,8">
                                                    <StackPanel Spacing="4">
                                                        <TextBlock Classes="oc-label" Text="Остаток"/>
                                                        <TextBlock FontSize="18" FontWeight="Bold" Foreground="{Binding RemainingAmountForeground}" Text="{Binding RemainingAmountText}"/>
                                                    </StackPanel>
                                                </Border>
                                                <Border Classes="oc-finance-tile" Margin="0,0,8,0">
                                                    <StackPanel Spacing="4">
                                                        <TextBlock Classes="oc-label" Text="Прибыль"/>
                                                        <TextBlock FontSize="18" FontWeight="Bold" Foreground="#27AE60" Text="{Binding ProfitText}"/>
                                                    </StackPanel>
                                                </Border>
                                                <Border Classes="oc-finance-tile" Margin="4,0,0,0">
                                                    <StackPanel Spacing="4">
                                                        <TextBlock Classes="oc-label" Text="Себестоимость / Маржа"/>
                                                        <TextBlock Classes="oc-value" FontSize="16" Text="{Binding CostPriceText}"/>
                                                        <TextBlock Classes="oc-muted" Text="{Binding MarginText, StringFormat='Маржа: {0}'}"/>
                                                    </StackPanel>
                                                </Border>
                                            </UniformGrid>
                                        </StackPanel>
                                    </Panel>
                                </ScrollViewer>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <StackPanel Grid.Column="4" Spacing="16">
                    <Border Classes="oc-card">
                        <StackPanel Spacing="14">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Classes="oc-title" Text="Валюты" VerticalAlignment="Center"/>
                                <Border Grid.Column="1" CornerRadius="8" Padding="8,4" Background="{Binding CurrencyStatusBackground}" IsVisible="{Binding IsCurrencyStatusVisible}">
                                    <TextBlock Text="{Binding CurrencyStatusText}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding CurrencyStatusForeground}"/>
                                </Border>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding CurrencyRates}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="vm:CurrencyRateDisplayModel">
                                        <Border Classes="oc-currency-row" Margin="0,0,0,8">
                                            <Grid ColumnDefinitions="48,*,Auto" ColumnSpacing="8">
                                                <TextBlock Text="{Binding Code}" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                                                <StackPanel Grid.Column="1" Spacing="2">
                                                    <TextBlock Text="{Binding RateText}" Classes="oc-value"/>
                                                    <TextBlock Text="{Binding Name}" Classes="oc-muted"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" HorizontalAlignment="Right" Spacing="2">
                                                    <TextBlock Text="{Binding OrderAmountText}" Classes="oc-value"/>
                                                    <TextBlock Text="сумма заказа" Classes="oc-muted"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Classes="oc-secondary" Content="Обновить курсы" Command="{Binding RefreshRatesCommand}" HorizontalAlignment="Stretch"/>
                            <Border Background="#EAF2FD" CornerRadius="10" Padding="12" IsVisible="{Binding ShowRecalculatePrompt}">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Курсы изменились. Пересчитать заказ?" FontSize="13" Foreground="#2F80ED" TextWrapping="Wrap"/>
                                    <Button Classes="oc-primary" Content="Пересчитать заказ" Command="{Binding RecalculateOrderCommand}" HorizontalAlignment="Stretch"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Classes="oc-card">
                        <StackPanel Spacing="12">
                            <TextBlock Classes="oc-title" Text="Финансы"/>
                            <Border Classes="oc-finance-tile">
                                <StackPanel Spacing="4">
                                    <TextBlock Classes="oc-label" Text="Стоимость"/>
                                    <TextBlock Classes="oc-big-number" Text="{Binding TotalCostText}"/>
                                </StackPanel>
                            </Border>
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                <Border Grid.Column="0" Classes="oc-finance-tile">
                                    <StackPanel Spacing="4">
                                        <TextBlock Classes="oc-label" Text="Оплачено"/>
                                        <TextBlock FontSize="20" FontWeight="Bold" Foreground="{Binding PaidAmountForeground}" Text="{Binding PaidAmountText}"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Classes="oc-finance-tile">
                                    <StackPanel Spacing="4">
                                        <TextBlock Classes="oc-label" Text="Осталось"/>
                                        <TextBlock FontSize="20" FontWeight="Bold" Foreground="{Binding RemainingAmountForeground}" Text="{Binding RemainingAmountText}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Classes="oc-card">
                        <StackPanel Spacing="12">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Classes="oc-title" Text="Контроль готовности"/>
                                <TextBlock Grid.Column="1" Text="{Binding ReadinessPercent, StringFormat='{}{0}%'}" FontSize="18" FontWeight="Bold" Foreground="#2F80ED"/>
                            </Grid>
                            <ProgressBar Classes="oc-progress" Minimum="0" Maximum="100" Value="{Binding ReadinessPercent}"/>
                            <TextBlock Text="{Binding ReadinessChecksText}" Classes="oc-muted"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <Border Grid.Row="2" Classes="oc-card">
                <StackPanel Spacing="14">
                    <TextBlock Classes="oc-title" Text="Информация о заказе"/>
                    <UniformGrid Columns="5" Rows="2">
                        <Border Classes="oc-info-footer-item" Margin="0,0,8,8">
                            <StackPanel Spacing="4">
                                <TextBlock Classes="oc-label" Text="Создал"/>
                                <TextBlock Classes="oc-value" Text="{Binding ManagerName}"/>
                            </StackPanel>
                        </Border>
                        <Border Classes="oc-info-footer-item" Margin="4,0,4,8">
                            <StackPanel Spacing="4">
                                <TextBlock Classes="oc-label" Text="Менеджер"/>
                                <TextBlock Classes="oc-value" Text="{Binding ManagerName}"/>
                            </StackPanel>
                        </Border>
                        <Border Classes="oc-info-footer-item" Margin="4,0,4,8">
                            <StackPanel Spacing="4">
                                <TextBlock Classes="oc-label" Text="Замерщик"/>
                                <TextBlock Classes="oc-value" Text="{Binding MeasurerName}"/>
                            </StackPanel>
                        </Border>
                        <Border Classes="oc-info-footer-item" Margin="4,0,4,8">
                            <StackPanel Spacing="4">
                                <TextBlock Classes="oc-label" Text="Производство"/>
                                <TextBlock Classes="oc-value" Text="{Binding ProductionTeam}"/>
                            </StackPanel>
                        </Border>
                        <Border Classes="oc-info-footer-item" Margin="8,0,0,8">
                            <StackPanel Spacing="4">
                                <TextBlock Classes="oc-label" Text="Источник"/>
                                <TextBlock Classes="oc-value" Text="{Binding OrderSource}"/>
                            </StackPanel>
                        </Border>
                        <Border Classes="oc-info-footer-item" Margin="0,0,8,0">
                            <StackPanel Spacing="4">
                                <TextBlock Classes="oc-label" Text="Версия заказа"/>
                                <TextBlock Classes="oc-value" Text="{Binding OrderVersion}"/>
                            </StackPanel>
                        </Border>
                        <Border Classes="oc-info-footer-item" Margin="4,0,4,0">
                            <StackPanel Spacing="4">
                                <TextBlock Classes="oc-label" Text="GUID"/>
                                <TextBlock Classes="oc-value" Text="{Binding OrderGuid}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>
                        <Border Classes="oc-info-footer-item" Margin="4,0,4,0">
                            <StackPanel Spacing="4">
                                <TextBlock Classes="oc-label" Text="Дата создания"/>
                                <TextBlock Classes="oc-value" Text="{Binding CreatedDateText}"/>
                            </StackPanel>
                        </Border>
                        <Border Classes="oc-info-footer-item" Margin="4,0,4,0">
                            <StackPanel Spacing="4">
                                <TextBlock Classes="oc-label" Text="Дата изменения"/>
                                <TextBlock Classes="oc-value" Text="{Binding ModifiedDateText}"/>
                            </StackPanel>
                        </Border>
                        <Border Classes="oc-info-footer-item" Margin="8,0,0,0">
                            <StackPanel Spacing="4">
                                <TextBlock Classes="oc-label" Text="Последняя синхронизация"/>
                                <TextBlock Classes="oc-value" Text="{Binding LastSyncText}"/>
                                <TextBlock Classes="oc-muted" Text="{Binding RepeatCustomerText, StringFormat='Повторный клиент: {0}'}"/>
                                <TextBlock Classes="oc-muted" Text="{Binding ApiStatus, StringFormat='API: {0}'}"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
