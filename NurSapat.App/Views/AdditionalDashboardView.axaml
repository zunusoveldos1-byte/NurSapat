<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:NurSapat.App.ViewModels"
             xmlns:cadVm="clr-namespace:NurSapat.Cad.UI.ViewModels;assembly=NurSapat.Cad.UI"
             x:Class="NurSapat.App.Views.AdditionalDashboardView"
             x:Name="Root"
             x:DataType="vm:AdditionalDashboardViewModel">
    <UserControl.Styles>
        <StyleInclude Source="/Styles/AdditionalDashboardStyles.axaml"/>
    </UserControl.Styles>

    <Grid Background="#F7F9FC"
          ColumnDefinitions="320,16,*,16,340"
          Margin="16">
        <!-- Левая колонка -->
        <ScrollViewer Grid.Column="0"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="16">
                <!-- Шаблон заказа -->
                <Border Classes="ad-card">
                    <StackPanel Spacing="16">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Classes="ad-icon" Text="&#xE8A5;"/>
                            <TextBlock Classes="ad-title" Text="Шаблон заказа"/>
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <TextBlock Classes="ad-label" Text="Шаблон"/>
                            <ComboBox Classes="ad-field"
                                      ItemsSource="{Binding Templates}"
                                      SelectedItem="{Binding SelectedTemplate}"
                                      HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate DataType="vm:OrderTemplateOption">
                                        <TextBlock Text="{Binding Title}" FontSize="13"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <Button Classes="ad-primary"
                                Content="Обновить заказ в соответствии с шаблоном"
                                Command="{Binding SyncOrderWithTemplateCommand}"
                                HorizontalAlignment="Stretch"/>

                        <StackPanel Spacing="8">
                            <ToggleSwitch Classes="ad-switch"
                                          Content="Автоматически обновлять заказ в соответствии с шаблоном"
                                          IsChecked="{Binding AutoSyncTemplate}"/>
                            <TextBlock Classes="ad-muted"
                                       Text="При изменении шаблона заказ будет автоматически синхронизироваться."
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Примечание -->
                <Border Classes="ad-card">
                    <StackPanel Spacing="12">
                        <TextBlock Classes="ad-title" Text="Профиль неизвестного происхождения"/>
                        <TextBlock Classes="ad-label" Text="Примечание"/>
                        <TextBox Classes="ad-note"
                                 Text="{Binding Note}"
                                 MaxLength="500"/>
                        <TextBlock Classes="ad-muted"
                                   HorizontalAlignment="Right"
                                   Text="{Binding NoteLength, StringFormat='{}{0} / 500'}"/>
                    </StackPanel>
                </Border>

                <!-- Протокол -->
                <Border Classes="ad-card">
                    <StackPanel Spacing="16">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Classes="ad-icon" Text="&#xE81C;"/>
                            <TextBlock Classes="ad-title" Text="Протокол работы с заказом"/>
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding VisibleActivityLog}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="cadVm:OrderActivityEvent">
                                    <Grid ColumnDefinitions="16,56,*" Margin="0,0,0,16">
                                        <Border Grid.Column="0"
                                                Width="8"
                                                Height="8"
                                                CornerRadius="4"
                                                Background="#2F80ED"
                                                VerticalAlignment="Top"
                                                Margin="0,6,0,0"/>
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock Text="{Binding Time}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="#0F172A"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Spacing="4">
                                            <TextBlock Text="{Binding Title}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="#0F172A"/>
                                            <TextBlock Text="{Binding User}"
                                                       FontSize="12"
                                                       Foreground="#64748B"/>
                                            <TextBlock Text="{Binding Details}"
                                                       FontSize="12"
                                                       Foreground="#94A3B8"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button Classes="ad-secondary"
                                HorizontalAlignment="Stretch"
                                Content="{Binding ActivityLogToggleText}"
                                Command="{Binding ToggleActivityLogCommand}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Центральная колонка -->
        <Border Grid.Column="2"
                Classes="ad-card"
                Padding="20">
            <Grid RowDefinitions="Auto,Auto,*,Auto">
                <!-- Заголовок -->
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Classes="ad-icon" Text="&#xE9D5;"/>
                        <TextBlock Classes="ad-title" Text="Этапы выполнения заказа"/>
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1"
                                  Classes="ad-switch"
                                  Content="Заблокировать изменения заказа"
                                  IsChecked="{Binding IsOrderLocked}"/>
                </Grid>

                <!-- Таблица этапов -->
                <Grid Grid.Row="2" RowDefinitions="Auto,*">
                    <Border Grid.Row="0" Classes="ad-table-header">
                        <Grid ColumnDefinitions="40,*,120,104,104,*,40"
                              Margin="8,0">
                            <TextBlock Grid.Column="0" Classes="ad-th" Text="№"/>
                            <TextBlock Grid.Column="1" Classes="ad-th" Text="Этап"/>
                            <TextBlock Grid.Column="2" Classes="ad-th" Text="Состояние"/>
                            <TextBlock Grid.Column="3" Classes="ad-th" Text="Дата начала"/>
                            <TextBlock Grid.Column="4" Classes="ad-th" Text="Дата окончания"/>
                            <TextBlock Grid.Column="5" Classes="ad-th" Text="Примечание"/>
                            <TextBlock Grid.Column="6" Classes="ad-th" Text=""/>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Stages}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:OrderStageCard">
                                    <Border Classes="ad-table-row">
                                        <Grid ColumnDefinitions="40,*,120,104,104,*,40"
                                              Margin="8,0">
                                            <TextBlock Grid.Column="0"
                                                       Classes="ad-body"
                                                       VerticalAlignment="Center"
                                                       Text="{Binding Number}"/>
                                            <TextBlock Grid.Column="1"
                                                       Classes="ad-body"
                                                       VerticalAlignment="Center"
                                                       Text="{Binding Title}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <Border Grid.Column="2"
                                                    Classes="ad-badge"
                                                    Background="{Binding StatusBackground}"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Status}"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Foreground="{Binding StatusForeground}"/>
                                            </Border>
                                            <TextBlock Grid.Column="3"
                                                       Classes="ad-body"
                                                       VerticalAlignment="Center"
                                                       FontSize="12"
                                                       Text="{Binding StartDateText}"/>
                                            <TextBlock Grid.Column="4"
                                                       Classes="ad-body"
                                                       VerticalAlignment="Center"
                                                       FontSize="12"
                                                       Text="{Binding EndDateText}"/>
                                            <TextBlock Grid.Column="5"
                                                       Classes="ad-muted"
                                                       VerticalAlignment="Center"
                                                       Text="{Binding Note}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <Button Grid.Column="6"
                                                    Classes="ad-ghost"
                                                    Command="{Binding #Root.((vm:AdditionalDashboardViewModel)DataContext).EditStageCommand}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip.Tip="Изменить этап"
                                                    VerticalAlignment="Center">
                                                <TextBlock Classes="ad-icon" Text="&#xE70F;" FontSize="14"/>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <!-- Информационная панель -->
                <UniformGrid Grid.Row="3"
                             Columns="3"
                             Margin="0,16,0,0">
                    <Border Classes="ad-info-tile" Margin="0,0,8,0">
                        <StackPanel Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Classes="ad-icon" Text="&#xE7F4;" FontSize="14"/>
                                <TextBlock Classes="ad-muted" Text="Программа"/>
                            </StackPanel>
                            <TextBlock Classes="ad-body" Text="{Binding ProgramName}"/>
                        </StackPanel>
                    </Border>
                    <Border Classes="ad-info-tile" Margin="4,0">
                        <StackPanel Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Classes="ad-icon" Text="&#xE821;" FontSize="14"/>
                                <TextBlock Classes="ad-muted" Text="Подразделение"/>
                            </StackPanel>
                            <TextBlock Classes="ad-body" Text="{Binding DepartmentName}"/>
                        </StackPanel>
                    </Border>
                    <Border Classes="ad-info-tile" Margin="8,0,0,0">
                        <StackPanel Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Classes="ad-icon" Text="&#xE77B;" FontSize="14"/>
                                <TextBlock Classes="ad-muted" Text="Пользователь"/>
                            </StackPanel>
                            <TextBlock Classes="ad-body" Text="{Binding CurrentUserDisplay}"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>
            </Grid>
        </Border>

        <!-- Правая колонка -->
        <ScrollViewer Grid.Column="4"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="16">
                <!-- Курсы валют -->
                <Border Classes="ad-card">
                    <StackPanel Spacing="16">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Classes="ad-icon" Text="&#xEB51;"/>
                                <TextBlock Classes="ad-title" Text="Курсы валют для заказа"/>
                            </StackPanel>
                            <Border Grid.Column="1"
                                    Classes="ad-status-pill"
                                    Background="{Binding CurrencyStatusBackground}">
                                <TextBlock FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{Binding CurrencyStatusForeground}"
                                           Text="{Binding CurrencyStatusText}"/>
                            </Border>
                        </Grid>

                        <Grid RowDefinitions="Auto,*">
                            <Border Grid.Row="0" Classes="ad-table-header">
                                <Grid ColumnDefinitions="56,*,80,88,88"
                                      Margin="8,0">
                                    <TextBlock Grid.Column="0" Classes="ad-th" Text="Валюта"/>
                                    <TextBlock Grid.Column="1" Classes="ad-th" Text="Курс"/>
                                    <TextBlock Grid.Column="2" Classes="ad-th" Text="Действие"/>
                                    <TextBlock Grid.Column="3" Classes="ad-th" Text="Начало"/>
                                    <TextBlock Grid.Column="4" Classes="ad-th" Text="Окончание"/>
                                </Grid>
                            </Border>
                            <ItemsControl Grid.Row="1" ItemsSource="{Binding OrderState.ExchangeRates}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="cadVm:ExchangeRateLine">
                                        <Border Classes="ad-table-row">
                                            <Grid ColumnDefinitions="56,*,80,88,88"
                                                  Margin="8,0">
                                                <TextBlock Grid.Column="0"
                                                           Classes="ad-body"
                                                           FontWeight="SemiBold"
                                                           VerticalAlignment="Center"
                                                           Text="{Binding Code}"/>
                                                <TextBlock Grid.Column="1"
                                                           Classes="ad-body"
                                                           VerticalAlignment="Center"
                                                           Text="{Binding RateText}"/>
                                                <TextBlock Grid.Column="2"
                                                           Classes="ad-muted"
                                                           VerticalAlignment="Center"
                                                           FontSize="11"
                                                           Text="{Binding ActionText}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Column="3"
                                                           Classes="ad-body"
                                                           VerticalAlignment="Center"
                                                           FontSize="12"
                                                           Text="{Binding PeriodStartText}"/>
                                                <TextBlock Grid.Column="4"
                                                           Classes="ad-body"
                                                           VerticalAlignment="Center"
                                                           FontSize="12"
                                                           Text="{Binding PeriodEndText}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>

                        <Button Classes="ad-secondary"
                                Content="Добавить валюту"
                                Command="{Binding AddCurrencyCommand}"
                                HorizontalAlignment="Stretch"/>
                    </StackPanel>
                </Border>

                <!-- Информация о заказе -->
                <Border Classes="ad-card">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Classes="ad-icon" Text="&#xE946;"/>
                            <TextBlock Classes="ad-title" Text="Информация о заказе"/>
                        </StackPanel>

                        <Border BorderBrush="#EEF2F7" BorderThickness="0,1,0,0" Padding="0,4,0,0">
                            <StackPanel Spacing="0">
                                <Grid ColumnDefinitions="*,Auto" Height="36" Margin="0,4">
                                    <TextBlock Classes="ad-muted" VerticalAlignment="Center" Text="Программа"/>
                                    <TextBlock Grid.Column="1" Classes="ad-body" VerticalAlignment="Center" Text="{Binding ProgramName}"/>
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto" Height="36" Margin="0,4">
                                    <TextBlock Classes="ad-muted" VerticalAlignment="Center" Text="Подразделение"/>
                                    <TextBlock Grid.Column="1" Classes="ad-body" VerticalAlignment="Center" Text="{Binding DepartmentShort}"/>
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto" Height="36" Margin="0,4">
                                    <TextBlock Classes="ad-muted" VerticalAlignment="Center" Text="Пользователь"/>
                                    <TextBlock Grid.Column="1" Classes="ad-body" VerticalAlignment="Center" Text="{Binding CurrentUserDisplay}"/>
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto" Height="36" Margin="0,4">
                                    <TextBlock Classes="ad-muted" VerticalAlignment="Center" Text="Дата создания"/>
                                    <TextBlock Grid.Column="1" Classes="ad-body" VerticalAlignment="Center" Text="{Binding CreatedDateText}"/>
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto" Height="36" Margin="0,4">
                                    <TextBlock Classes="ad-muted" VerticalAlignment="Center" Text="Дата изменения"/>
                                    <TextBlock Grid.Column="1" Classes="ad-body" VerticalAlignment="Center" Text="{Binding ModifiedDateText}"/>
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto" Height="36" Margin="0,4">
                                    <TextBlock Classes="ad-muted" VerticalAlignment="Center" Text="Статус заказа"/>
                                    <Border Grid.Column="1"
                                            Classes="ad-badge"
                                            Background="#EAF2FD"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding OrderStatus}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="#2F80ED"/>
                                    </Border>
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto" Height="36" Margin="0,4">
                                    <TextBlock Classes="ad-muted" VerticalAlignment="Center" Text="Стоимость"/>
                                    <TextBlock Grid.Column="1" Classes="ad-body" FontWeight="SemiBold" VerticalAlignment="Center" Text="{Binding TotalCostText}"/>
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto" Height="36" Margin="0,4">
                                    <TextBlock Classes="ad-muted" VerticalAlignment="Center" Text="Оплата"/>
                                    <TextBlock Grid.Column="1" Classes="ad-body" VerticalAlignment="Center" Text="{Binding OrderState.PaymentStatus}"/>
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto" Height="36" Margin="0,4">
                                    <TextBlock Classes="ad-muted" VerticalAlignment="Center" Text="Площадь"/>
                                    <TextBlock Grid.Column="1" Classes="ad-body" VerticalAlignment="Center" Text="{Binding OrderState.ItemArea, StringFormat='{}{0:0.#} м²'}"/>
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto" Height="36" Margin="0,4">
                                    <TextBlock Classes="ad-muted" VerticalAlignment="Center" Text="Периметр"/>
                                    <TextBlock Grid.Column="1" Classes="ad-body" VerticalAlignment="Center" Text="{Binding OrderState.Perimeter, StringFormat='{}{0:0.#} м'}"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
