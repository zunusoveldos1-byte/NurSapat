<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:NurSapat.App.ViewModels"
             xmlns:cadVm="clr-namespace:NurSapat.Cad.UI.ViewModels;assembly=NurSapat.Cad.UI"
             x:Class="NurSapat.App.Views.AdditionalDashboardView"
             x:DataType="vm:AdditionalDashboardViewModel">
    <UserControl.Styles>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E1E7F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>
        <Style Selector="TextBlock.h">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="#0B1736"/>
        </Style>
        <Style Selector="TextBlock.icon">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="Foreground" Value="#1A73E8"/>
            <Setter Property="FontSize" Value="18"/>
        </Style>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="#1A73E8"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
    </UserControl.Styles>

    <Grid Background="#F6F9FD" ColumnDefinitions="330,*,280" ColumnSpacing="14" Margin="14">
        <StackPanel Grid.Column="0" Spacing="14">
            <Border Classes="card" Padding="18">
                <StackPanel Spacing="14">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Classes="icon" Text="&#xE8EE;"/>
                        <TextBlock Classes="h" Text="Шаблон заказа"/>
                    </StackPanel>
                    <ComboBox ItemsSource="{Binding Templates}" SelectedItem="{Binding SelectedTemplate}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate DataType="vm:OrderTemplateOption">
                                <TextBlock Text="{Binding Title}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Classes="primary" Content="Применить шаблон" Command="{Binding ApplyTemplateCommand}"/>
                    <Button Content="Обновить заказ" Height="38" Command="{Binding RefreshOrderCommand}"/>
                </StackPanel>
            </Border>

            <Border Classes="card" Padding="18">
                <StackPanel Spacing="12">
                    <TextBlock Classes="h" Text="Протокол работы с заказом"/>
                    <ScrollViewer MaxHeight="360">
                        <ItemsControl ItemsSource="{Binding OrderState.ActivityLog}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="cadVm:OrderActivityEvent">
                                    <Grid ColumnDefinitions="72,*" Margin="0,5">
                                        <TextBlock Text="{Binding Time}" Foreground="#64748B" FontSize="12"/>
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12"/>
                                            <TextBlock Text="{Binding Details}" Foreground="#64748B" FontSize="12" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>
        </StackPanel>

        <StackPanel Grid.Column="1" Spacing="14">
            <Border Classes="card" Padding="18">
                <StackPanel Spacing="14">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="Этапы выполнения заказа" FontWeight="SemiBold" FontSize="18"/>
                        <ToggleSwitch Grid.Column="1" Content="Заблокировать изменения" IsChecked="{Binding IsOrderLocked}"/>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Stages}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel ItemWidth="220" ItemHeight="150"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:OrderStageCard">
                                <Border Classes="card" Padding="14" Margin="6">
                                    <StackPanel Spacing="8">
                                        <Grid ColumnDefinitions="Auto,*">
                                            <CheckBox IsChecked="{Binding IsCompleted}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Number, StringFormat='Этап {0}'}" FontWeight="Bold"/>
                                        </Grid>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Status}" Foreground="#1A73E8" FontSize="12"/>
                                        <TextBlock Text="{Binding PlannedAtText}" Foreground="#64748B" FontSize="12"/>
                                        <Button Content="Завершить этап"
                                                Command="{Binding $parent[UserControl].DataContext.CompleteStageCommand}"
                                                CommandParameter="{Binding}"
                                                HorizontalContentAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Classes="card" Padding="18">
                <StackPanel Spacing="14">
                    <TextBlock Text="Сводная информация" FontWeight="SemiBold" FontSize="16"/>
                    <UniformGrid Columns="5" Rows="1">
                        <Border Classes="card" Padding="12" Margin="6">
                            <StackPanel>
                                <TextBlock Text="{Binding TotalStages}" FontSize="24" FontWeight="Bold"/>
                                <TextBlock Text="Всего этапов" FontSize="12"/>
                            </StackPanel>
                        </Border>
                        <Border Classes="card" Padding="12" Margin="6">
                            <StackPanel>
                                <TextBlock Text="{Binding CompletedStages}" FontSize="24" FontWeight="Bold"/>
                                <TextBlock Text="Выполнено" FontSize="12" Foreground="#188038"/>
                            </StackPanel>
                        </Border>
                        <Border Classes="card" Padding="12" Margin="6">
                            <StackPanel>
                                <TextBlock Text="{Binding InProgressStages}" FontSize="24" FontWeight="Bold"/>
                                <TextBlock Text="В работе" FontSize="12" Foreground="#1A73E8"/>
                            </StackPanel>
                        </Border>
                        <Border Classes="card" Padding="12" Margin="6">
                            <StackPanel>
                                <TextBlock Text="{Binding WaitingStages}" FontSize="24" FontWeight="Bold"/>
                                <TextBlock Text="Ожидание" FontSize="12" Foreground="#F29900"/>
                            </StackPanel>
                        </Border>
                        <Border Classes="card" Padding="12" Margin="6">
                            <StackPanel>
                                <TextBlock Text="{Binding OverdueStages}" FontSize="24" FontWeight="Bold"/>
                                <TextBlock Text="Просрочено" FontSize="12" Foreground="#D93025"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </StackPanel>
            </Border>
        </StackPanel>

        <StackPanel Grid.Column="2" Spacing="14">
            <Border Classes="card" Padding="18">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Classes="h" Text="Курсы валют"/>
                        <TextBlock Grid.Column="1" Classes="icon" Text="&#xE72C;"/>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding OrderState.ExchangeRates}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="cadVm:ExchangeRateLine">
                                <Grid ColumnDefinitions="*,Auto" Margin="0,5">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Code}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Source}" Foreground="#64748B" FontSize="12"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding RateText}" FontWeight="Bold"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border Background="#EEF4FF" CornerRadius="8" Padding="12">
                        <TextBlock Text="{Binding OrderState.CurrencyStatus}" Foreground="#17315F" TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>
            </Border>

            <Border Classes="card" Padding="18">
                <StackPanel Spacing="10">
                    <TextBlock Classes="h" Text="Данные заказа"/>
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="Площадь"/>
                        <TextBlock Grid.Column="1" Text="{Binding OrderState.ItemArea, StringFormat='{}{0:0.###} м²'}"/>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="Периметр"/>
                        <TextBlock Grid.Column="1" Text="{Binding OrderState.Perimeter, StringFormat='{}{0:0.##} м'}"/>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="Стоимость"/>
                        <TextBlock Grid.Column="1" Text="{Binding OrderState.TotalCost, StringFormat='{}{0:0.##}'}"/>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="Оплата"/>
                        <TextBlock Grid.Column="1" Text="{Binding OrderState.PaymentStatus}"/>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
