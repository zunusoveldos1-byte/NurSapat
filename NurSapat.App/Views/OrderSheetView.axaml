<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:NurSapat.App.ViewModels"
             xmlns:orders="clr-namespace:NurSapat.Core.Models.Orders;assembly=NurSapat.Core"
             xmlns:cadControls="clr-namespace:NurSapat.Cad.UI.Controls;assembly=NurSapat.Cad.UI"
             x:Class="NurSapat.App.Views.OrderSheetView"
             x:DataType="vm:OrderSheetViewModel">

    <UserControl.Styles>
        <Style Selector="Border.os-panel">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="16"/>
        </Style>
        <Style Selector="TextBlock.os-title">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#0F172A"/>
        </Style>
        <Style Selector="TextBlock.os-label">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#64748B"/>
        </Style>
        <Style Selector="TextBlock.os-value">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style Selector="Border.os-line">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="#E2E8F0"/>
            <Setter Property="Margin" Value="0,10"/>
        </Style>
        <Style Selector="Button.os-tool">
            <Setter Property="MinWidth" Value="32"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
        </Style>
        <Style Selector="Button.os-eye">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style Selector="ListBox.os-list">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="ListBox.os-list ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ListBox.os-list ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Border.os-item">
            <Setter Property="Background" Value="#FAFBFC"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12"/>
        </Style>
        <Style Selector="ListBox.os-list ListBoxItem:selected Border.os-item">
            <Setter Property="Background" Value="#EFF6FF"/>
            <Setter Property="BorderBrush" Value="#BFDBFE"/>
        </Style>
    </UserControl.Styles>

    <Grid Background="#F6F9FD"
          RowDefinitions="*,200,28">

        <!-- Верхняя зона -->
        <Grid Grid.Row="0" MinHeight="360">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" MinWidth="280"/>
                <ColumnDefinition Width="420" MinWidth="360"/>
                <ColumnDefinition Width="*" MinWidth="320"/>
            </Grid.ColumnDefinitions>

            <!-- 1. Конструкции -->
            <Border Grid.Column="0" Classes="os-panel">
                <Grid RowDefinitions="Auto,*">
                    <TextBlock Classes="os-title" Text="Конструкции" Margin="0,0,0,12"/>

                    <Panel Grid.Row="1">
                        <StackPanel VerticalAlignment="Center"
                                    Spacing="8"
                                    IsVisible="{Binding ShowConstructionEmptyState}">
                            <TextBlock Text="Нет конструкций."
                                       Classes="os-value"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"/>
                            <TextBlock Text="Создайте конструкцию на вкладке «Чертеж»."
                                       FontSize="12"
                                       Foreground="#94A3B8"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>

                        <ListBox Classes="os-list"
                                 ItemsSource="{Binding Constructions}"
                                 SelectedItem="{Binding SelectedConstruction}"
                                 IsVisible="{Binding !ShowConstructionEmptyState}">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="orders:OrderConstruction">
                                    <Border Classes="os-item">
                                        <Grid ColumnDefinitions="44,*,Auto" ColumnSpacing="10">
                                            <Border Grid.Column="0"
                                                    Width="44" Height="44"
                                                    CornerRadius="6"
                                                    Background="#EFF6FF"
                                                    BorderBrush="#DBEAFE"
                                                    BorderThickness="1">
                                                <TextBlock Text="🪟"
                                                           FontSize="20"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}"
                                                           FontWeight="SemiBold"
                                                           FontSize="13"
                                                           Foreground="#0F172A"/>
                                                <TextBlock Text="{Binding DimensionsDisplay}"
                                                           FontSize="12"
                                                           Foreground="#64748B"/>
                                                <TextBlock Text="{Binding AreaDisplay}"
                                                           FontSize="12"
                                                           Foreground="#64748B"/>
                                                <TextBlock Text="{Binding QuantityDisplay}"
                                                           FontSize="12"
                                                           Foreground="#64748B"/>
                                                <TextBlock Text="{Binding StatusDisplay}"
                                                           FontSize="12"
                                                           Foreground="#16A34A"/>
                                            </StackPanel>
                                            <Button Grid.Column="2"
                                                    Classes="os-eye"
                                                    Content="👁"
                                                    VerticalAlignment="Top"
                                                    ToolTip.Tip="Показать в предпросмотре"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Panel>
                </Grid>
            </Border>

            <!-- 2. Информация о конструкции -->
            <Border Grid.Column="1" Classes="os-panel">
                <Grid RowDefinitions="Auto,*">
                    <TextBlock Classes="os-title" Text="Информация о конструкции" Margin="0,0,0,12"/>

                    <Panel Grid.Row="1">
                        <StackPanel VerticalAlignment="Center"
                                    Spacing="8"
                                    IsVisible="{Binding ShowConstructionNotSelected}">
                            <TextBlock Text="Конструкция не выбрана."
                                       Classes="os-value"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"/>
                            <TextBlock Text="Выберите конструкцию слева."
                                       FontSize="12"
                                       Foreground="#94A3B8"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"/>
                        </StackPanel>

                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      IsVisible="{Binding IsConstructionSelected}">
                            <StackPanel DataContext="{Binding ActiveConstruction}" Spacing="0">
                                <TextBlock Classes="os-label" Text="Название"/>
                                <TextBlock Classes="os-value" Text="{Binding Name}" Margin="0,4,0,0"/>
                                <Border Classes="os-line"/>

                                <TextBlock Classes="os-label" Text="Размер"/>
                                <TextBlock Classes="os-value" Text="{Binding DimensionsDisplay}" Margin="0,4,0,0"/>
                                <Border Classes="os-line"/>

                                <TextBlock Classes="os-label" Text="Количество"/>
                                <TextBlock Classes="os-value" Text="{Binding Cost.Quantity}" Margin="0,4,0,0"/>
                                <Border Classes="os-line"/>

                                <TextBlock Classes="os-label" Text="Площадь"/>
                                <TextBlock Classes="os-value" Text="{Binding AreaDisplay}" Margin="0,4,0,0"/>
                                <Border Classes="os-line"/>

                                <TextBlock Classes="os-label" Text="Периметр"/>
                                <TextBlock Classes="os-value" Text="{Binding PerimeterDisplay}" Margin="0,4,0,0"/>
                                <Border Classes="os-line"/>

                                <TextBlock Classes="os-label" Text="Профиль"/>
                                <TextBlock Classes="os-value" Text="{Binding ProfileDisplay}" Margin="0,4,0,0"/>
                                <Border Classes="os-line"/>

                                <TextBlock Classes="os-label" Text="Армирование"/>
                                <TextBlock Classes="os-value" Text="{Binding ReinforcementDisplay}" Margin="0,4,0,0"/>
                                <Border Classes="os-line"/>

                                <TextBlock Classes="os-label" Text="Стеклопакет"/>
                                <TextBlock Classes="os-value" Text="{Binding GlazingDisplay}" Margin="0,4,0,0"/>
                                <Border Classes="os-line"/>

                                <TextBlock Classes="os-label" Text="Фурнитура"/>
                                <TextBlock Classes="os-value" Text="{Binding HardwareDisplay}" Margin="0,4,0,0"/>
                                <Border Classes="os-line"/>

                                <TextBlock Classes="os-label" Text="Статус"/>
                                <TextBlock Classes="os-value" Text="{Binding StatusDisplay}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Panel>
                </Grid>
            </Border>

            <!-- 3. Предпросмотр -->
            <Border Grid.Column="2"
                    Classes="os-panel"
                    BorderThickness="0,0,0,1">
                <Grid RowDefinitions="Auto,Auto,*">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="4">
                            <TextBlock Classes="os-title" Text="Предпросмотр конструкции"/>
                            <TextBlock Text="{Binding ActiveConstruction.Name}"
                                       FontSize="12"
                                       Foreground="#64748B"
                                       IsVisible="{Binding IsConstructionSelected}"/>
                            <TextBlock Text="{Binding ActiveConstruction.DimensionsDisplay}"
                                       FontSize="12"
                                       Foreground="#64748B"
                                       IsVisible="{Binding IsConstructionSelected}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="4"
                                    VerticalAlignment="Top">
                            <Button Classes="os-tool" Content="−" Command="{Binding PreviewZoomOutCommand}"/>
                            <TextBlock Text="{Binding PreviewZoomPercent}"
                                       FontSize="12"
                                       Foreground="#64748B"
                                       VerticalAlignment="Center"
                                       MinWidth="44"
                                       TextAlignment="Center"/>
                            <Button Classes="os-tool" Content="+" Command="{Binding PreviewZoomInCommand}"/>
                            <Button Classes="os-tool" Content="Fit" Command="{Binding PreviewFitToScreenCommand}"/>
                            <Button Classes="os-tool" Content="2D" IsEnabled="False"/>
                            <Button Classes="os-tool" Content="3D" IsEnabled="False"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Grid.Row="1"
                               Text="Режим просмотра"
                               FontSize="11"
                               Foreground="#1D4ED8"
                               Margin="0,8,0,8"/>

                    <Border Grid.Row="2"
                            Background="#FAFBFC"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            ClipToBounds="True">
                        <Panel>
                            <StackPanel VerticalAlignment="Center"
                                        HorizontalAlignment="Center"
                                        Spacing="10"
                                        IsVisible="{Binding ShowPreviewPlaceholder}">
                                <TextBlock Text="🪟" FontSize="36" HorizontalAlignment="Center"/>
                                <TextBlock Text="Предпросмотр появится после создания конструкции."
                                           FontSize="12"
                                           Foreground="#94A3B8"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           MaxWidth="280"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                            <cadControls:CadSceneControl Editor="{Binding PreviewEditor}"
                                                         ClipToBounds="True"
                                                         IsVisible="{Binding !ShowPreviewPlaceholder}"/>
                        </Panel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Нижняя зона -->
        <Grid Grid.Row="1" MinHeight="180">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="280"/>
                <ColumnDefinition Width="1.4*" MinWidth="220"/>
                <ColumnDefinition Width="1*" MinWidth="180"/>
                <ColumnDefinition Width="1*" MinWidth="180"/>
            </Grid.ColumnDefinitions>

            <!-- 4. Материалы -->
            <Border Grid.Column="0" Classes="os-panel">
                <Grid RowDefinitions="Auto,*">
                    <TextBlock Classes="os-title" Text="Материалы конструкции" Margin="0,0,0,12"/>
                    <Panel Grid.Row="1">
                        <StackPanel VerticalAlignment="Center"
                                    Spacing="6"
                                    IsVisible="{Binding ShowMaterialsEmptyState}">
                            <TextBlock Text="Материалы пока отсутствуют."
                                       Classes="os-value"
                                       TextAlignment="Center"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Выполните расчёт конструкции."
                                       FontSize="12"
                                       Foreground="#94A3B8"
                                       TextAlignment="Center"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      IsVisible="{Binding !ShowMaterialsEmptyState}">
                            <StackPanel Spacing="0">
                                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                                    <TextBlock Classes="os-label" Text="Материал"/>
                                    <TextBlock Grid.Column="1" Classes="os-label" Text="Количество"/>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding MaterialLines}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:MaterialQuantityLine">
                                            <StackPanel Spacing="4" Margin="0,0,0,8">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <StackPanel Spacing="2">
                                                        <TextBlock Classes="os-value" Text="{Binding Name}" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding Detail}"
                                                                   FontSize="12"
                                                                   Foreground="#64748B"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1"
                                                               Classes="os-value"
                                                               Text="{Binding Quantity}"
                                                               VerticalAlignment="Center"/>
                                                </Grid>
                                                <Border Classes="os-line" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Panel>
                </Grid>
            </Border>

            <!-- 5. Итоги конструкции -->
            <Border Grid.Column="1" Classes="os-panel">
                <StackPanel Spacing="0">
                    <TextBlock Classes="os-title" Text="Итоги конструкции" Margin="0,0,0,12"/>
                    <TextBlock Classes="os-label" Text="Площадь"/>
                    <TextBlock Classes="os-value" Text="{Binding ConstructionAreaDisplay}" Margin="0,4,0,0"/>
                    <Border Classes="os-line"/>
                    <TextBlock Classes="os-label" Text="Вес"/>
                    <TextBlock Classes="os-value" Text="{Binding ConstructionWeightDisplay}" Margin="0,4,0,0"/>
                    <Border Classes="os-line"/>
                    <TextBlock Classes="os-label" Text="Стоимость материалов"/>
                    <TextBlock Classes="os-value" Text="{Binding ConstructionMaterialsCostDisplay}" Margin="0,4,0,0"/>
                    <Border Classes="os-line"/>
                    <TextBlock Classes="os-label" Text="Стоимость работ"/>
                    <TextBlock Classes="os-value" Text="{Binding ConstructionLaborCostDisplay}" Margin="0,4,0,0"/>
                    <Border Classes="os-line"/>
                    <TextBlock Classes="os-label" Text="Стоимость конструкции"/>
                    <TextBlock Classes="os-value" Text="{Binding ConstructionTotalCostDisplay}" Margin="0,4,0,0" FontWeight="SemiBold"/>
                </StackPanel>
            </Border>

            <!-- 6. Стоимость за 1 м² -->
            <Border Grid.Column="2" Classes="os-panel">
                <StackPanel Spacing="0">
                    <TextBlock Classes="os-title" Text="Стоимость за 1 м²" Margin="0,0,0,12"/>
                    <TextBlock Classes="os-label" Text="Стоимость конструкции"/>
                    <TextBlock Classes="os-value" Text="{Binding ConstructionTotalCostDisplay}" Margin="0,4,0,0"/>
                    <Border Classes="os-line"/>
                    <TextBlock Classes="os-label" Text="Площадь"/>
                    <TextBlock Classes="os-value" Text="{Binding ConstructionAreaDisplay}" Margin="0,4,0,0"/>
                    <Border Classes="os-line"/>
                    <TextBlock Classes="os-label" Text="Стоимость за 1 м²"/>
                    <TextBlock Classes="os-value" Text="{Binding CostPerSqMDisplay}" Margin="0,4,0,0" FontWeight="SemiBold"/>
                    <Border Classes="os-line"/>
                    <TextBlock Classes="os-label" Text="Себестоимость"/>
                    <TextBlock Classes="os-value" Text="{Binding CostPriceDisplay}" Margin="0,4,0,0"/>
                    <Border Classes="os-line"/>
                    <TextBlock Classes="os-label" Text="Рентабельность"/>
                    <TextBlock Classes="os-value" Text="{Binding ProfitabilityDisplay}" Margin="0,4,0,0"/>
                    <Border Classes="os-line"/>
                    <TextBlock Classes="os-label" Text="Наценка"/>
                    <TextBlock Classes="os-value" Text="{Binding MarkupDisplay}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- 7. Оплата -->
            <Border Grid.Column="3"
                    Classes="os-panel"
                    BorderThickness="0,0,0,1">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="0">
                        <TextBlock Classes="os-title" Text="Оплата" Margin="0,0,0,12"/>
                        <TextBlock Classes="os-label" Text="Общая стоимость"/>
                        <TextBlock Classes="os-value" Text="{Binding PaymentTotalDisplay}" Margin="0,4,0,0"/>
                        <Border Classes="os-line"/>
                        <TextBlock Classes="os-label" Text="Оплачено"/>
                        <TextBlock Classes="os-value" Text="{Binding PaidAmountDisplay}" Margin="0,4,0,0"/>
                        <Border Classes="os-line"/>
                        <TextBlock Classes="os-label" Text="Осталось"/>
                        <TextBlock Classes="os-value" Text="{Binding RemainingAmountDisplay}" Margin="0,4,0,0"/>
                        <Border Classes="os-line"/>
                        <TextBlock Classes="os-label" Text="Последний платёж"/>
                        <TextBlock Classes="os-value" Text="{Binding LastPaymentDisplay}" Margin="0,4,0,0"/>
                        <Border Classes="os-line"/>
                        <TextBlock Classes="os-label" Text="Процент оплаты"/>
                        <TextBlock Classes="os-value"
                                   Text="{Binding PaymentPercent, StringFormat={}{0:0}%}"
                                   Margin="0,4,0,0"/>
                        <TextBlock Text="{Binding PaymentEmptyHint}"
                                   FontSize="11"
                                   Foreground="#94A3B8"
                                   Margin="0,8,0,0"
                                   TextWrapping="Wrap"
                                   IsVisible="{Binding !HasPaymentData}"/>
                    </StackPanel>
                    <Panel Grid.Column="1"
                           Width="64" Height="64"
                           VerticalAlignment="Center"
                           Margin="12,0,0,0">
                        <Ellipse Width="64" Height="64"
                                 Stroke="#E2E8F0"
                                 StrokeThickness="6"
                                 Fill="Transparent"/>
                        <Ellipse Width="64" Height="64"
                                 Stroke="#2563EB"
                                 StrokeThickness="6"
                                 Fill="Transparent"
                                 StrokeDashArray="3,200"
                                 RenderTransformOrigin="50%,50%">
                            <Ellipse.RenderTransform>
                                <RotateTransform Angle="-90"/>
                            </Ellipse.RenderTransform>
                        </Ellipse>
                        <TextBlock Text="{Binding PaymentPercent, StringFormat={}{0:0}%}"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Foreground="#2563EB"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Panel>
                </Grid>
            </Border>
        </Grid>

        <!-- 8. StatusBar -->
        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#E2E8F0"
                BorderThickness="0,1,0,0"
                Padding="16,0">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{Binding SaveStatusText}"
                           FontSize="11"
                           Foreground="#334155"
                           VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="16">
                    <TextBlock Text="{Binding AutoSaveStatusText}" FontSize="11" Foreground="#64748B" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding ProjectVersionText}" FontSize="11" Foreground="#64748B" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding CurrentUserText}" FontSize="11" Foreground="#64748B" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding LastModifiedText}" FontSize="11" Foreground="#64748B" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding LastModifiedTimeText}" FontSize="11" Foreground="#64748B" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
