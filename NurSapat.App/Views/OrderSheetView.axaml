<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:NurSapat.App.ViewModels"
             xmlns:controls="clr-namespace:NurSapat.Cad.UI.Controls;assembly=NurSapat.Cad.UI"
             xmlns:appControls="clr-namespace:NurSapat.App.Controls"
             x:Class="NurSapat.App.Views.OrderSheetView"
             x:DataType="vm:OrderSheetViewModel">

    <UserControl.Styles>
        <Style Selector="Border.os-sidebar">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="12"/>
        </Style>
        <Style Selector="Border.os-card">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="12"/>
        </Style>
        <Style Selector="TextBlock.os-title">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style Selector="TextBlock.os-label">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style Selector="TextBlock.os-spec-label">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="Width" Value="88"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBlock.os-spec-value">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBox.os-search">
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="MaxHeight" Value="32"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBox.os-field">
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="MaxHeight" Value="32"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="ComboBox.os-field">
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="MaxHeight" Value="32"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style Selector="DatePicker.os-field">
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="MaxHeight" Value="32"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style Selector="TextBox.os-field-readonly">
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="MaxHeight" Value="32"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBox.os-field-multiline">
            <Setter Property="MinHeight" Value="48"/>
            <Setter Property="MaxHeight" Value="48"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style Selector="Button.os-listCard">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="Button.os-listCard:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Border.os-listCardBorder">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="8"/>
        </Style>
        <Style Selector="Border.os-listCardBorder:active">
            <Setter Property="Background" Value="#EFF6FF"/>
            <Setter Property="BorderBrush" Value="#3B82F6"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>
        <Style Selector="ListBox.os-constructionList">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style Selector="ListBox.os-constructionList ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Top"/>
        </Style>
        <Style Selector="ListBox.os-constructionList ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ListBox.os-constructionList ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.os-toolbar">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinWidth" Value="36"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.os-toolbar:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#F8FAFC"/>
        </Style>
        <Style Selector="Button.os-toolbar:disabled">
            <Setter Property="Opacity" Value="0.45"/>
        </Style>
        <Style Selector="Button.os-chip">
            <Setter Property="MinWidth" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.os-chip.active">
            <Setter Property="Background" Value="#EFF6FF"/>
            <Setter Property="BorderBrush" Value="#3B82F6"/>
            <Setter Property="Foreground" Value="#1D4ED8"/>
        </Style>
        <Style Selector="Button.os-action">
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.os-previewTool">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinWidth" Value="32"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.os-previewTool:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#F8FAFC"/>
        </Style>
        <Style Selector="Border.os-hint">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="8"/>
        </Style>
    </UserControl.Styles>

    <Grid Background="#F6F9FD"
          Margin="12"
          ColumnDefinitions="300,*"
          RowDefinitions="*,Auto"
          ColumnSpacing="12">

        <Border Grid.Row="0"
                Grid.Column="0"
                Classes="os-sidebar">
            <!-- Строка 3 (*) забирает свободное место, остальные аккуратно подстраиваются -->
            <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="10">

                <!-- 0. Заголовок -->
                <TextBlock Grid.Row="0"
                           Classes="os-title"
                           Text="Конструкции"
                           Margin="0"/>

                <!-- 1. Поиск -->
                <TextBox Grid.Row="1"
                         Classes="os-search"
                         PlaceholderText="Поиск..."
                         Text="{Binding ConstructionSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                    <TextBox.InnerLeftContent>
                        <TextBlock Text="&#xE721;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="14"
                                   Foreground="#94A3B8"
                                   VerticalAlignment="Center"
                                   Margin="4,0,0,0"/>
                    </TextBox.InnerLeftContent>
                </TextBox>

                <!-- 2. Индикатор страниц -->
                <TextBlock Grid.Row="2"
                           Text="{Binding PageIndicatorText}"
                           FontSize="11"
                           Foreground="#94A3B8"
                           HorizontalAlignment="Right"
                           IsVisible="{Binding !ShowConstructionCardsEmptyState}"/>

                <!-- 3. Список конструкций (Резиновая часть) -->
                <Panel Grid.Row="3">
                    <StackPanel VerticalAlignment="Center"
                                Spacing="8"
                                IsVisible="{Binding ShowConstructionCardsEmptyState}">
                        <TextBlock Text="Нет конструкций."
                                   FontSize="13"
                                   Foreground="#0F172A"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"/>
                        <TextBlock Text="Добавьте новую конструкцию кнопкой ниже или на вкладке «Чертеж»."
                                   FontSize="12"
                                   Foreground="#94A3B8"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>

                    <ListBox Classes="os-constructionList"
                             ItemsSource="{Binding PagedConstructionCards}"
                             SelectedItem="{Binding SelectedConstructionCard, Mode=TwoWay}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             IsVisible="{Binding !ShowConstructionCardsEmptyState}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:OrderConstructionLookupItemViewModel">
                                <Button Classes="os-listCard"
                                        Height="96"
                                        HorizontalAlignment="Stretch"
                                        Command="{Binding $parent[UserControl].((vm:OrderSheetViewModel)DataContext).SelectConstructionCardCommand}"
                                        CommandParameter="{Binding}">
                                    <Border Classes="os-listCardBorder"
                                            Classes.active="{Binding IsActive}"
                                            Height="96"
                                            HorizontalAlignment="Stretch">
                                        <Grid ColumnDefinitions="64,*" ColumnSpacing="8">
                                            <Border Grid.Column="0"
                                                    Width="64"
                                                    Height="64"
                                                    Background="#F8FAFC"
                                                    BorderBrush="#E2E8F0"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    ClipToBounds="True"
                                                    VerticalAlignment="Center">
                                                <Viewbox Stretch="Uniform"
                                                         StretchDirection="DownOnly"
                                                         HorizontalAlignment="Center"
                                                         VerticalAlignment="Center"
                                                         Margin="4">
                                                    <controls:CadCanvasControl Editor="{Binding PreviewEditor}"
                                                                               AutoFitOnResize="True"
                                                                               IsThumbnailPreview="True"
                                                                               IsEnabled="False"
                                                                               IsHitTestVisible="False"
                                                                               Width="56"
                                                                               Height="56"/>
                                                </Viewbox>
                                            </Border>

                                            <StackPanel Grid.Column="1"
                                                        Spacing="4"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"
                                                           Foreground="#0F172A"
                                                           TextWrapping="Wrap"
                                                           MaxHeight="32"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding DimensionsDisplay}"
                                                           FontSize="12"
                                                           Foreground="#64748B"
                                                           TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding QuantityDisplay}"
                                                           FontSize="12"
                                                           Foreground="#64748B"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Panel>

                <!-- 4. Общий блок инструментов (Приподнят за счет нижнего Margin) -->
                <StackPanel Grid.Row="4" Spacing="10" Margin="0,0,0,64  ">

                    <!-- Кнопка "+ Добавить конструкцию" -->
                    <Button x:Name="AddConstructionButton"
                            Height="36"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Background="Transparent"
                            BorderBrush="#3B82F6"
                            BorderThickness="1"
                            CornerRadius="8"
                            Cursor="Hand"
                            Command="{Binding AddConstructionCommand}">
                        <TextBlock Text="+ Добавить конструкцию"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#3B82F6"/>
                    </Button>

                    <!-- Панель действий -->
                    <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto"
                          ColumnSpacing="8">
                        <Button x:Name="DuplicateButton"
                                Grid.Column="0"
                                Classes="os-toolbar"
                                Command="{Binding DuplicateConstructionCommand}"
                                ToolTip.Tip="Дублировать">
                            <TextBlock Text="&#xE8C8;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="16"
                                       Foreground="#475569"/>
                        </Button>
                        <Button x:Name="EditButton"
                                Grid.Column="1"
                                Classes="os-toolbar"
                                Command="{Binding EditConstructionCommand}"
                                ToolTip.Tip="Изменить">
                            <TextBlock Text="&#xE70F;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="16"
                                       Foreground="#475569"/>
                        </Button>
                        <Button x:Name="DeleteButton"
                                Grid.Column="2"
                                Classes="os-toolbar"
                                Command="{Binding DeleteConstructionCommand}"
                                ToolTip.Tip="Удалить">
                            <TextBlock Text="&#xE74D;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="16"
                                       Foreground="#475569"/>
                        </Button>
                        <Button x:Name="PreviousPageButton"
                                Grid.Column="4"
                                Classes="os-toolbar"
                                Command="{Binding GoToPreviousPageCommand}"
                                IsEnabled="{Binding CanGoToPreviousPage}"
                                ToolTip.Tip="Предыдущая страница">
                            <TextBlock Text="&#xE70E;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="16"
                                       Foreground="#475569"/>
                        </Button>
                        <Button x:Name="NextPageButton"
                                Grid.Column="5"
                                Classes="os-toolbar"
                                Command="{Binding GoToNextPageCommand}"
                                IsEnabled="{Binding CanGoToNextPage}"
                                ToolTip.Tip="Следующая страница">
                            <TextBlock Text="&#xE70D;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="16"
                                       Foreground="#475569"/>
                        </Button>
                    </Grid>

                    <!-- Подсказка -->
                    <Border Classes="os-hint"
                            MinHeight="60"
                            Margin="0,4,0,0">
                        <TextBlock Text="{Binding ActiveHintText}"
                                   FontSize="12"
                                   Foreground="#64748B"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"
                                   Margin="8"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- НАЧАЛО: Основная рабочая область -->
        <Grid Grid.Row="0"
              Grid.Column="1"
              RowDefinitions="*,Auto"
              RowSpacing="12">

            <!-- НАЧАЛО: Верхний ярус — Параметры + Предпросмотр -->
            <Grid Grid.Row="0"
                  ColumnDefinitions="7*,3*"
                  ColumnSpacing="12">

                <!-- НАЧАЛО: Карточка «Параметры конструкции» -->
                <Border Grid.Column="0"
                        Classes="os-card"
                        ClipToBounds="True"
                        VerticalAlignment="Stretch">
                    <Grid RowDefinitions="Auto,*">
                        <TextBlock Grid.Row="0"
                                   Classes="os-title"
                                   Text="Параметры конструкции"/>

                        <Grid Grid.Row="1"
                              ColumnSpacing="12"
                              IsVisible="{Binding !ShowConstructionNotSelected}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="200" MinWidth="180" MaxWidth="220"/>
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0"
                                  RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                                  RowSpacing="6">
                                <Grid Grid.Row="0" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="72"/>
                                        <ColumnDefinition Width="92"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Classes="os-label" Text="Наименование"/>
                                        <TextBox Classes="os-field"
                                                 Text="{Binding SelectedConstructionModel.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Classes="os-label" Text="Кол-во"/>
                                        <TextBox Classes="os-field"
                                                 Text="{Binding SelectedConstructionModel.Quantity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Classes="os-label" Text="Площадь"/>
                                        <TextBox Classes="os-field-readonly"
                                                 IsReadOnly="True"
                                                 Text="{Binding SelectedConstructionModel.AreaDisplay}"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="8">
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Classes="os-label" Text="Ширина (мм)"/>
                                        <TextBox Classes="os-field"
                                                 Text="{Binding SelectedConstructionModel.Width, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Classes="os-label" Text="Высота (мм)"/>
                                        <TextBox Classes="os-field"
                                                 Text="{Binding SelectedConstructionModel.Height, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="8"
                                      IsVisible="{Binding SelectedConstructionModel.HasArcTopProfile}">
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Classes="os-label" Text="Радиус арки (мм)"/>
                                        <TextBox Classes="os-field"
                                                 Text="{Binding SelectedConstructionModel.ArcRadius, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Classes="os-label" Text="Высота стрелы (мм)"/>
                                        <TextBox Classes="os-field"
                                                 Text="{Binding SelectedConstructionModel.ArcHeight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Grid.Row="3" ColumnDefinitions="*,*" ColumnSpacing="8">
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Classes="os-label" Text="Дата изготовления"/>
                                        <DatePicker Classes="os-field"
                                                    SelectedDate="{Binding SelectedConstructionModel.ManufactureDate, Mode=TwoWay}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Classes="os-label" Text="Срок поставки"/>
                                        <DatePicker Classes="os-field"
                                                    SelectedDate="{Binding SelectedConstructionModel.DeliveryDate, Mode=TwoWay}"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Grid.Row="4" ColumnDefinitions="*,*" ColumnSpacing="8">
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Classes="os-label" Text="Менеджер"/>
                                        <ComboBox Classes="os-field"
                                                  ItemsSource="{Binding Managers}"
                                                  SelectedItem="{Binding SelectedConstructionModel.Manager, Mode=TwoWay}"
                                                  HorizontalAlignment="Stretch"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Classes="os-label" Text="Ответственный"/>
                                        <ComboBox Classes="os-field"
                                                  ItemsSource="{Binding Supervisors}"
                                                  SelectedItem="{Binding SelectedConstructionModel.Supervisor, Mode=TwoWay}"
                                                  HorizontalAlignment="Stretch"/>
                                    </StackPanel>
                                </Grid>

                                <StackPanel Grid.Row="5">
                                    <TextBlock Classes="os-label" Text="Примечание"/>
                                    <TextBox Classes="os-field-multiline"
                                             Height="96"
                                             MaxHeight="96"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             PlaceholderText="Введите примечание..."
                                             Text="{Binding SelectedConstructionModel.Notes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                            </Grid>

                            <Border Grid.Column="1"
                                    VerticalAlignment="Stretch"
                                    Background="#FAFAFA"
                                    BorderBrush="#CBD5E1"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="8">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Конструкция"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="#0F172A"/>
                                    <Border Background="White"
                                            BorderBrush="#E2E8F0"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            ClipToBounds="True"
                                            Height="64">
                                        <controls:CadCanvasControl Editor="{Binding PreviewEditor}"
                                                                   AutoFitOnResize="True"
                                                                   IsThumbnailPreview="True"
                                                                   IsHitTestVisible="False"
                                                                   IsEnabled="False"
                                                                   Height="64"/>
                                    </Border>
                                    <TextBlock Text="{Binding ActiveDimensionsDisplay}"
                                               FontSize="10"
                                               Foreground="#94A3B8"
                                               HorizontalAlignment="Center"/>
                                    <Grid ColumnDefinitions="Auto,*"
                                          RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                                          ColumnSpacing="8"
                                          RowSpacing="2">
                                        <TextBlock Grid.Row="0" Grid.Column="0" Classes="os-spec-label" Text="Тип профиля"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1" Classes="os-spec-value" Text="{Binding ProfileType}"/>
                                        <TextBlock Grid.Row="1" Grid.Column="0" Classes="os-spec-label" Text="Цвет профиля"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Classes="os-spec-value" Text="{Binding ProfileColor}"/>
                                        <TextBlock Grid.Row="2" Grid.Column="0" Classes="os-spec-label" Text="Стеклопакет"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1" Classes="os-spec-value" Text="{Binding GlassPacket}"/>
                                        <TextBlock Grid.Row="3" Grid.Column="0" Classes="os-spec-label" Text="Фурнитура"/>
                                        <TextBlock Grid.Row="3" Grid.Column="1" Classes="os-spec-value" Text="{Binding Hardware}"/>
                                        <TextBlock Grid.Row="4" Grid.Column="0" Classes="os-spec-label" Text="Ориентация"/>
                                        <CheckBox Grid.Row="4" Grid.Column="1"
                                                  Content="Белый"
                                                  FontSize="11"
                                                  IsChecked="{Binding ActiveWhiteOrientation}"
                                                  IsEnabled="False"
                                                  Padding="0"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <StackPanel Grid.Row="1"
                                    Spacing="4"
                                    VerticalAlignment="Center"
                                    IsVisible="{Binding ShowConstructionNotSelected}">
                            <TextBlock Text="Конструкция не выбрана"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="#0F172A"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Выберите конструкцию в списке слева."
                                       FontSize="12"
                                       Foreground="#94A3B8"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <!-- КОНЕЦ: Карточка «Параметры конструкции» -->

                <!-- НАЧАЛО: Карточка «Предпросмотр» -->
                <Border Grid.Column="1"
                        Classes="os-card"
                        VerticalAlignment="Stretch">
                    <Grid RowDefinitions="Auto,*">
                        <Grid Grid.Row="0"
                              ColumnDefinitions="*,Auto"
                              Margin="0,0,0,8">
                            <TextBlock Classes="os-title"
                                       Text="Предпросмотр"
                                       Margin="0"
                                       VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        Spacing="8"
                                        VerticalAlignment="Center">
                                <Button Classes="os-chip active" Content="2D"/>
                                <Button Classes="os-chip" Content="3D"/>
                                <Button Classes="os-chip"
                                        Width="32"
                                        Height="32"
                                        Command="{Binding ExpandPreviewCommand}"
                                        ToolTip.Tip="Развернуть">
                                    <TextBlock Text="&#xE740;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="12"/>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <Border Grid.Row="1"
                                Background="#F8FAFC"
                                BorderBrush="#E2E8F0"
                                BorderThickness="1"
                                CornerRadius="8"
                                ClipToBounds="True"
                                Padding="0">
                            <Panel>
                                <StackPanel HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Spacing="4"
                                            Margin="8"
                                            IsVisible="{Binding ShowPreviewPlaceholder}">
                                    <TextBlock Text="Нет эскиза"
                                               FontSize="13"
                                               Foreground="#64748B"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="Задайте габариты или откройте чертёж"
                                               FontSize="12"
                                               Foreground="#94A3B8"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>

                                <controls:CadCanvasControl x:Name="ConstructionPreviewCanvas"
                                                           Editor="{Binding PreviewEditor}"
                                                           AutoFitOnResize="True"
                                                           HorizontalAlignment="Stretch"
                                                           VerticalAlignment="Stretch"
                                                           IsVisible="{Binding !ShowPreviewPlaceholder}"/>

                                <StackPanel HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            Spacing="8"
                                            Margin="0,8,8,0">
                                    <Button Classes="os-previewTool"
                                            Command="{Binding PreviewZoomInCommand}"
                                            ToolTip.Tip="Увеличить">
                                        <TextBlock Text="&#xE710;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="12"/>
                                    </Button>
                                    <Button Classes="os-previewTool"
                                            Command="{Binding PreviewZoomOutCommand}"
                                            ToolTip.Tip="Уменьшить">
                                        <TextBlock Text="&#xE738;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="12"/>
                                    </Button>
                                    <Button Classes="os-previewTool"
                                            Command="{Binding PreviewFitToScreenCommand}"
                                            ToolTip.Tip="По размеру">
                                        <TextBlock Text="&#xE740;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="12"/>
                                    </Button>
                                </StackPanel>
                            </Panel>
                        </Border>
                    </Grid>
                </Border>
                <!-- КОНЕЦ: Карточка «Предпросмотр» -->
            </Grid>
            <!-- КОНЕЦ: Верхний ярус — Параметры + Предпросмотр -->

            <!-- НАЧАЛО: Нижний ярус — Данные / Итоги / Оплата -->
            <Grid Grid.Row="1"
                  ColumnDefinitions="*,*,*"
                  ColumnSpacing="12"
                  VerticalAlignment="Top"
                  MaxHeight="252">

                <!-- НАЧАЛО: Карточка «Данные по заказу» -->
                <Border Grid.Column="0"
                        Classes="os-card"
                        VerticalAlignment="Stretch">
                    <StackPanel Spacing="6">
                        <TextBlock Classes="os-title" Text="Данные по заказу"/>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <StackPanel Grid.Column="0">
                                <TextBlock Classes="os-label" Text="Заказчик"/>
                                <TextBox Classes="os-field"
                                         Text="{Binding CustomerName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Classes="os-label" Text="Телефон"/>
                                <TextBox Classes="os-field"
                                         PlaceholderText="+996(___) __ __ __"
                                         Text="{Binding CustomerPhone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Grid>
                        <StackPanel>
                            <TextBlock Classes="os-label" Text="Адрес объекта"/>
                            <TextBox Classes="os-field"
                                     Text="{Binding ObjectAddress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <StackPanel Grid.Column="0">
                                <TextBlock Classes="os-label" Text="Договор"/>
                                <TextBox Classes="os-field"
                                         Text="{Binding ContractNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Classes="os-label" Text="Менеджер"/>
                                <ComboBox Classes="os-field"
                                          ItemsSource="{Binding Managers}"
                                          SelectedItem="{Binding OrderManagerName, Mode=TwoWay}"
                                          HorizontalAlignment="Stretch"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
                <!-- КОНЕЦ: Карточка «Данные по заказу» -->

                <!-- НАЧАЛО: Карточка «Итоги по заказу» -->
                <Border Grid.Column="1"
                        Classes="os-card"
                        Padding="0"
                        VerticalAlignment="Stretch">
                    <Grid RowDefinitions="Auto,*,Auto">
                        <TextBlock Grid.Row="0"
                                   Classes="os-title"
                                   Text="Итоги по заказу"
                                   Margin="12,12,12,0"/>
                        <StackPanel Grid.Row="1"
                                    Spacing="4"
                                    Margin="12,8,12,8"
                                    VerticalAlignment="Top">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Конструкций" FontSize="12" Foreground="#64748B"/>
                                <TextBlock Grid.Column="1" Text="{Binding TotalCountDisplay}" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A"/>
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Общая площадь" FontSize="12" Foreground="#64748B"/>
                                <TextBlock Grid.Column="1" Text="{Binding TotalAreaDisplay}" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A"/>
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Общий вес" FontSize="12" Foreground="#64748B"/>
                                <TextBlock Grid.Column="1" Text="{Binding TotalWeightDisplay}" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A"/>
                            </Grid>
                        </StackPanel>
                        <Border Grid.Row="2"
                                Background="#EFF6FF"
                                BorderBrush="#BFDBFE"
                                BorderThickness="0,1,0,0"
                                CornerRadius="0,0,12,12"
                                Padding="12,8">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Итого к оплате" FontSize="11" Foreground="#1D4ED8"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding TotalPriceDisplay}"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           Foreground="#1D4ED8"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
                <!-- КОНЕЦ: Карточка «Итоги по заказу» -->

                <!-- НАЧАЛО: Карточка «Оплата» -->
                <Border Grid.Column="2"
                        Classes="os-card"
                        VerticalAlignment="Stretch">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <StackPanel Grid.Column="0" Spacing="6">
                            <TextBlock Classes="os-title" Text="Оплата"/>
                            <StackPanel>
                                <TextBlock Classes="os-label" Text="Валюта"/>
                                <ComboBox Classes="os-field"
                                          ItemsSource="{Binding Currencies}"
                                          SelectedItem="{Binding SelectedCurrency, Mode=TwoWay}"
                                          HorizontalAlignment="Stretch"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Classes="os-label" Text="Оплачено"/>
                                <TextBox Classes="os-field"
                                         Text="{Binding AmountPaid, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Classes="os-label" Text="К оплате"/>
                                <TextBox Classes="os-field-readonly"
                                         IsReadOnly="True"
                                         Text="{Binding AmountLeftToPayDisplay}"/>
                            </StackPanel>
                        </StackPanel>
                        <appControls:PaymentProgressRing Grid.Column="1"
                                                         Value="{Binding PaymentPercentage}"
                                                         VerticalAlignment="Top"
                                                         Margin="0,24,0,0"/>
                    </Grid>
                </Border>
                <!-- КОНЕЦ: Карточка «Оплата» -->
            </Grid>
            <!-- КОНЕЦ: Нижний ярус — Данные / Итоги / Оплата -->
        </Grid>
        <!-- КОНЕЦ: Основная рабочая область -->

        <!-- НАЧАЛО: Подвал с кнопками сохранения -->
        <Border Grid.Row="1"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Height="48"
                MinHeight="48"
                MaxHeight="48"
                Background="#F8FAFC"
                BorderBrush="#E2E8F0"
                BorderThickness="0,1,0,0"
                Padding="12,0">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center">
                    <TextBlock Text="{Binding SaveStatusBulletText}"
                               FontSize="12"
                               Foreground="#475569"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding LastAutosaveTimeDisplay}"
                               FontSize="11"
                               Foreground="#94A3B8"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center">
                    <Button Classes="os-action"
                            Background="Transparent"
                            BorderBrush="#CBD5E1"
                            BorderThickness="1"
                            Content="Отмена"
                            Command="{Binding CancelCommand}"/>
                    <Button Classes="os-action"
                            Background="White"
                            BorderBrush="#3B82F6"
                            BorderThickness="1"
                            Foreground="#2563EB"
                            Content="Сохранить"
                            Command="{Binding SaveCommand}"/>
                    <Button Classes="os-action"
                            Background="#3B82F6"
                            BorderBrush="#3B82F6"
                            BorderThickness="1"
                            Foreground="White"
                            Content="Сохранить и закрыть"
                            Command="{Binding SaveAndCloseCommand}"/>
                </StackPanel>
            </Grid>
        </Border>
        <!-- КОНЕЦ: Подвал с кнопками сохранения -->

    </Grid>
</UserControl>
