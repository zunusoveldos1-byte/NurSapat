<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:NurSapat.App.ViewModels"
             xmlns:orders="clr-namespace:NurSapat.Core.Models.Orders;assembly=NurSapat.Core"
             xmlns:cadControls="clr-namespace:NurSapat.Cad.UI.Controls;assembly=NurSapat.Cad.UI"
             x:Class="NurSapat.App.Views.OrderSheetView"
             x:DataType="vm:OrderSheetViewModel">

    <UserControl.Styles>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>
        <Style Selector="TextBlock.caption">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#64748B"/>
        </Style>
        <Style Selector="TextBlock.section">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#0F172A"/>
        </Style>
        <Style Selector="Border.field">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Padding" Value="8,0"/>
        </Style>
        <Style Selector="TextBox.field">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBlock.fieldValue">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="DatePicker.field">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style Selector="ListBox.constructionList ListBoxItem">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style Selector="ListBox.constructionList ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="#EFF6FF"/>
        </Style>
        <Style Selector="Button.tabIcon">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="Button.tabIcon.active">
            <Setter Property="Background" Value="#EFF6FF"/>
        </Style>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button.secondary">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Height" Value="34"/>
        </Style>
    </UserControl.Styles>

    <Grid Background="#F6F9FD" Margin="10" RowDefinitions="*,Auto" RowSpacing="10" ColumnDefinitions="*">

        <!-- Верх: конструкции | параметры | предпросмотр -->
        <Grid Grid.Row="0" ColumnDefinitions="220,*,300" ColumnSpacing="10">

            <!-- Конструкции -->
            <Border Grid.Column="0" Classes="card" Padding="10">
                <Grid RowDefinitions="Auto,Auto,*,Auto">
                    <TextBlock Grid.Row="0" Classes="section" Text="Конструкции" Margin="0,0,0,8"/>
                    <Border Grid.Row="1" Classes="field" Margin="0,0,0,8">
                        <TextBox PlaceholderText="Поиск..." FontSize="12"/>
                    </Border>
                    <ListBox Grid.Row="2"
                             ItemsSource="{Binding Constructions}"
                             SelectedItem="{Binding SelectedConstruction}"
                             Background="Transparent"
                             BorderThickness="0"
                             Classes="constructionList">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="orders:OrderConstruction">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"/>
                                    <TextBlock FontSize="11" Foreground="#64748B">
                                        <Run Text="{Binding Geometry.OuterWidthMm, StringFormat={}{0:0}}"/>
                                        <Run Text=" x "/>
                                        <Run Text="{Binding Geometry.OuterHeightMm, StringFormat={}{0:0}}"/>
                                        <Run Text=" мм"/>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Grid.Row="3" Spacing="6" Margin="0,8,0,0">
                        <Button Classes="primary" Content="+ Добавить конструкцию" Command="{Binding AddConstructionCommand}" HorizontalAlignment="Stretch"/>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                            <Button Grid.Column="0" Classes="secondary" Content="Копировать" Command="{Binding CopyConstructionCommand}"/>
                            <Button Grid.Column="1" Classes="secondary" Content="Удалить" Command="{Binding DeleteConstructionCommand}"/>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Параметры конструкции -->
            <Border Grid.Column="1" Classes="card" Padding="10">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <StackPanel Grid.Column="0" Spacing="4" Width="40">
                        <Button Classes="tabIcon" Classes.active="True"
                                Command="{Binding SelectParameterTabCommand}"
                                CommandParameter="0" ToolTip.Tip="Основные">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#2563EB"/>
                        </Button>
                        <Button Classes="tabIcon" ToolTip.Tip="Профиль">
                            <TextBlock Text="&#xE8FD;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#94A3B8"/>
                        </Button>
                        <Button Classes="tabIcon" ToolTip.Tip="Стеклопакет">
                            <TextBlock Text="&#xE771;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#94A3B8"/>
                        </Button>
                        <Button Classes="tabIcon" ToolTip.Tip="Фурнитура">
                            <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#94A3B8"/>
                        </Button>
                    </StackPanel>

                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Spacing="10">
                            <TextBlock Classes="section" Text="Параметры конструкции"/>
                            <Grid ColumnDefinitions="*,120,100" ColumnSpacing="8">
                                <StackPanel Grid.Column="0" Spacing="4">
                                    <TextBlock Classes="caption" Text="Наименование"/>
                                    <Border Classes="field"><TextBox Classes="field" Text="{Binding ConstructionName}"/></Border>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock Classes="caption" Text="Количество"/>
                                    <Border Classes="field"><TextBox Classes="field" Text="{Binding ConstructionQuantity}"/></Border>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Spacing="4">
                                    <TextBlock Classes="caption" Text="Площадь"/>
                                    <Border Classes="field" Background="#F8FAFC">
                                        <TextBlock Classes="fieldValue" Text="{Binding ConstructionAreaText}" Margin="4,0"/>
                                    </Border>
                                </StackPanel>
                            </Grid>
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                <StackPanel Spacing="4">
                                    <TextBlock Classes="caption" Text="Ширина, мм"/>
                                    <Border Classes="field"><TextBox Classes="field" Text="{Binding OuterWidthMm}"/></Border>
                                </StackPanel>
                                <StackPanel Spacing="4">
                                    <TextBlock Classes="caption" Text="Высота, мм"/>
                                    <Border Classes="field"><TextBox Classes="field" Text="{Binding OuterHeightMm}"/></Border>
                                </StackPanel>
                            </Grid>
                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                                <StackPanel Spacing="4">
                                    <TextBlock Classes="caption" Text="Дата изготовления"/>
                                    <Border Classes="field"><DatePicker Classes="field" SelectedDate="{Binding ProductionDateOffset}"/></Border>
                                </StackPanel>
                                <StackPanel Spacing="4">
                                    <TextBlock Classes="caption" Text="Дата доставки"/>
                                    <Border Classes="field"><DatePicker Classes="field" SelectedDate="{Binding DeliveryDateOffset}"/></Border>
                                </StackPanel>
                                <StackPanel Spacing="4">
                                    <TextBlock Classes="caption" Text="Дата монтажа"/>
                                    <Border Classes="field"><DatePicker Classes="field" SelectedDate="{Binding InstallationDateOffset}"/></Border>
                                </StackPanel>
                            </Grid>
                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                                <StackPanel Spacing="4">
                                    <TextBlock Classes="caption" Text="Доставка"/>
                                    <Border Classes="field"><TextBox Classes="field" Text="Нет"/></Border>
                                </StackPanel>
                                <StackPanel Spacing="4">
                                    <TextBlock Classes="caption" Text="Монтаж"/>
                                    <Border Classes="field"><TextBox Classes="field" Text="Нет"/></Border>
                                </StackPanel>
                                <StackPanel Spacing="4">
                                    <TextBlock Classes="caption" Text="Скидка, %"/>
                                    <Border Classes="field"><TextBox Classes="field" Text="{Binding Discount1Percent}"/></Border>
                                </StackPanel>
                            </Grid>
                            <StackPanel Spacing="4">
                                <TextBlock Classes="caption" Text="Примечание"/>
                                <Border Classes="field" MinHeight="56" Padding="8,6">
                                    <TextBox AcceptsReturn="True" Text="{Binding Header.Note}" TextWrapping="Wrap"
                                             Background="Transparent" BorderThickness="0" MinHeight="44"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Предпросмотр -->
            <Border Grid.Column="2" Classes="card" Padding="8">
                <Grid RowDefinitions="Auto,*">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                        <TextBlock Classes="section" Text="Предпросмотр" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                            <Button Content="+" Width="28" Height="28" Padding="0" CornerRadius="6"
                                    Command="{Binding PreviewEditor.FitAllCommand}"/>
                        </StackPanel>
                    </Grid>
                    <cadControls:CadSceneControl Grid.Row="1" Editor="{Binding PreviewEditor}" ClipToBounds="True"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Низ: данные заказа | итоги | оплата -->
        <Grid Grid.Row="1" ColumnDefinitions="*,*,280" ColumnSpacing="10" Height="200">

            <Border Grid.Column="0" Classes="card" Padding="12">
                <StackPanel Spacing="8">
                    <TextBlock Classes="section" Text="Данные по заказу"/>
                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="6">
                        <StackPanel Grid.Row="0" Grid.Column="0" Spacing="3">
                            <TextBlock Classes="caption" Text="Заказчик"/>
                            <Border Classes="field"><TextBox Classes="field" Text="{Binding Header.CustomerName}"/></Border>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="1" Spacing="3">
                            <TextBlock Classes="caption" Text="Телефон"/>
                            <Border Classes="field"><TextBox Classes="field" Text="{Binding Header.CustomerPhone}"/></Border>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Spacing="3">
                            <TextBlock Classes="caption" Text="Адрес объекта"/>
                            <Border Classes="field"><TextBox Classes="field" Text="{Binding Header.SiteAddress}"/></Border>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="0" Spacing="3">
                            <TextBlock Classes="caption" Text="Договор"/>
                            <Border Classes="field"><TextBox Classes="field" Text="{Binding Header.ContractNumber}"/></Border>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="1" Spacing="3">
                            <TextBlock Classes="caption" Text="Менеджер"/>
                            <Border Classes="field"><TextBox Classes="field" Text="{Binding Header.DealerName}"/></Border>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Classes="card" Padding="12">
                <StackPanel Spacing="8">
                    <TextBlock Classes="section" Text="Итоги по заказу"/>
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                        <Border Background="#F8FAFC" CornerRadius="6" Padding="10">
                            <StackPanel Spacing="2">
                                <TextBlock Classes="caption" Text="Стоимость материалов"/>
                                <TextBlock Text="{Binding MaterialsTotal, StringFormat={}{0:N2}}" FontWeight="SemiBold" FontSize="15"/>
                                <TextBlock Text="{Binding CurrencyCode}" FontSize="11" Foreground="#64748B"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#F8FAFC" CornerRadius="6" Padding="10">
                            <StackPanel Spacing="2">
                                <TextBlock Classes="caption" Text="Монтаж"/>
                                <TextBlock Text="{Binding InstallationTotal, StringFormat={}{0:N2}}" FontWeight="SemiBold" FontSize="15"/>
                                <TextBlock Text="{Binding CurrencyCode}" FontSize="11" Foreground="#64748B"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#F8FAFC" CornerRadius="6" Padding="10">
                            <StackPanel Spacing="2">
                                <TextBlock Classes="caption" Text="Доставка"/>
                                <TextBlock Text="{Binding DeliveryTotal, StringFormat={}{0:N2}}" FontWeight="SemiBold" FontSize="15"/>
                                <TextBlock Text="{Binding CurrencyCode}" FontSize="11" Foreground="#64748B"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8" Padding="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="Итого" FontWeight="SemiBold" Foreground="#1E40AF" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding GrandTotal, StringFormat={}{0:N2}}" FontSize="22" FontWeight="Bold" Foreground="#1D4ED8"/>
                                <TextBlock Text="{Binding CurrencyCode}" FontSize="11" Foreground="#64748B" HorizontalAlignment="Right"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Classes="card" Padding="12">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="8">
                        <TextBlock Classes="section" Text="Оплата"/>
                        <StackPanel Spacing="6">
                            <StackPanel Spacing="3">
                                <TextBlock Classes="caption" Text="Валюта"/>
                                <Border Classes="field"><TextBox Classes="field" Text="{Binding CurrencyCode}"/></Border>
                            </StackPanel>
                            <StackPanel Spacing="3">
                                <TextBlock Classes="caption" Text="Оплачено"/>
                                <Border Classes="field"><TextBox Classes="field" Text="{Binding Prepayment}"/></Border>
                            </StackPanel>
                            <StackPanel Spacing="3">
                                <TextBlock Classes="caption" Text="К оплате"/>
                                <Border Classes="field" Background="#F8FAFC">
                                    <TextBlock Classes="fieldValue" Text="{Binding PaymentDebt, StringFormat={}{0:N2}}" Margin="4,0"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                    <Border Grid.Column="1" Width="72" Height="72" CornerRadius="36" BorderBrush="#E2E8F0" BorderThickness="6"
                            VerticalAlignment="Center" Margin="8,0,0,0">
                        <TextBlock Text="{Binding PaymentPercent, StringFormat={}{0:0}%}" FontSize="14" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#2563EB"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
