<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:NurSapat.App.ViewModels.Account"
        x:Class="NurSapat.App.Views.Account.ChangePasswordWindow"
        x:DataType="vm:ChangePasswordViewModel"
        Width="400"
        Height="300"
        MinWidth="360"
        MinHeight="280"
        WindowStartupLocation="CenterOwner"
        WindowDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="-1"
        Background="Transparent"
        FontFamily="Inter">

    <Window.Styles>
        <StyleInclude Source="/Styles/MaterialsDictionaryStyles.axaml"/>
    </Window.Styles>

    <Border Classes="mat-shell" Margin="12">
        <Grid RowDefinitions="40,*,Auto">
            <Border Grid.Row="0"
                    Classes="mat-titlebar"
                    PointerPressed="OnTitleBarPointerPressed">
                <Grid ColumnDefinitions="*,46">
                    <TextBlock Classes="mat-titlebar-text"
                               Margin="16,0,0,0"
                               Text="Смена пароля пользователя"/>
                    <Button Grid.Column="1"
                            Classes="mat-chrome-btn close"
                            Click="OnCloseClick"
                            Content="✕"
                            Width="46"
                            Height="32"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"/>
                </Grid>
            </Border>

            <StackPanel Grid.Row="1" Margin="16,12,16,0" Spacing="10">
                <Grid ColumnDefinitions="140,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
                    <TextBlock Grid.Row="0" Text="Текущий пароль" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="0"
                             Grid.Column="1"
                             Text="{Binding CurrentPassword}"
                             PasswordChar="*"
                             MinHeight="34"
                             VerticalContentAlignment="Center"/>

                    <TextBlock Grid.Row="1" Text="Новый пароль" VerticalAlignment="Center"/>
                    <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="*,Auto">
                        <TextBox Grid.Column="0"
                                 Text="{Binding NewPassword}"
                                 PasswordChar="{Binding NewPasswordChar}"
                                 MinHeight="34"
                                 VerticalContentAlignment="Center"/>
                        <Button Grid.Column="1"
                                Classes="mat-toolbar"
                                Margin="6,0,0,0"
                                Width="34"
                                Height="34"
                                Padding="0"
                                ToolTip.Tip="Показать пароль"
                                Command="{Binding ToggleNewPasswordVisibilityCommand}"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center">
                            <TextBlock Text="👁" FontSize="14"/>
                        </Button>
                    </Grid>

                    <TextBlock Grid.Row="2" Text="Повторите новый пароль" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="2"
                             Grid.Column="1"
                             Text="{Binding ConfirmPassword}"
                             PasswordChar="{Binding NewPasswordChar}"
                             MinHeight="34"
                             VerticalContentAlignment="Center"/>
                </Grid>

                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="#DC2626"
                           TextWrapping="Wrap"
                           FontSize="12"
                           MinHeight="18"/>
            </StackPanel>

            <Border Grid.Row="2" Padding="16" Background="#F8FAFC" CornerRadius="0,0,12,12">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Spacing="8">
                    <Button Classes="mat-primary"
                            Content="Сохранить"
                            Command="{Binding ChangePasswordCommand}"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"/>
                    <Button Classes="mat-toolbar"
                            Content="Отмена"
                            Command="{Binding CancelCommand}"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
