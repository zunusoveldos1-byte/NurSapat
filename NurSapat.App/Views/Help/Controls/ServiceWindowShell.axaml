<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:NurSapat.App.Views.Help.Controls"
             x:Class="NurSapat.App.Views.Help.Controls.ServiceWindowShell"
             x:Name="Root"
             FontFamily="Inter">

    <Border Classes="svc-window-shell" Margin="12">
        <Grid RowDefinitions="32,*,Auto">
            <Border Grid.Row="0"
                    Classes="mat-titlebar"
                    PointerPressed="OnTitleBarPointerPressed">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Orientation="Horizontal"
                                Spacing="8"
                                VerticalAlignment="Center"
                                Margin="16,0,0,0">
                        <Image Source="/Assets/logo.ico" Width="16" Height="16" VerticalAlignment="Center"/>
                        <TextBlock Classes="mat-titlebar-text"
                                   Text="{Binding WindowTitle, ElementName=Root}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="0,0,8,0">
                        <Button Classes="mat-chrome-btn"
                                Click="OnMinimizeClick"
                                Content="—"/>
                        <Button Classes="mat-chrome-btn close"
                                Click="OnCloseClick"
                                Content="✕"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1" Classes="svc-body">
                <ContentPresenter x:Name="BodyPresenter"/>
            </Border>

            <Border Grid.Row="2"
                    Classes="svc-footer"
                    IsVisible="{Binding ShowFooter, ElementName=Root}">
                <ContentPresenter x:Name="FooterPresenter"/>
            </Border>
        </Grid>
    </Border>
</UserControl>
