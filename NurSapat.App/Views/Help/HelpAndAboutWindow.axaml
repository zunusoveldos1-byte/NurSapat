<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:NurSapat.App.ViewModels.Help"
        x:Class="NurSapat.App.Views.Help.HelpAndAboutWindow"
        x:DataType="vm:HelpAndAboutViewModel"
        Width="740"
        Height="500"
        MinWidth="600"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        WindowDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="-1"
        Background="Transparent"
        FontFamily="Inter">

    <Window.Styles>
        <StyleInclude Source="/Styles/MaterialsDictionaryStyles.axaml"/>
        <Style Selector="TabControl">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="TabItem">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="MinWidth" Value="132"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="TabItem:selected">
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="TabItem /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#F8FAFC"/>
        </Style>
        <Style Selector="TabItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#EFF6FF"/>
        </Style>
    </Window.Styles>

    <Border Classes="mat-shell" Margin="12">
        <Grid RowDefinitions="40,*,Auto">
            <Border Grid.Row="0"
                    Classes="mat-titlebar"
                    PointerPressed="OnTitleBarPointerPressed">
                <Grid ColumnDefinitions="*,46">
                    <TextBlock Classes="mat-titlebar-text"
                               Margin="16,0,0,0"
                               Text="Справка и О программе"/>
                    <Button Grid.Column="1"
                            Classes="mat-chrome-btn close"
                            Command="{Binding CloseCommand}"
                            Content="✕"
                            Width="46"
                            Height="32"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"/>
                </Grid>
            </Border>

            <TabControl Grid.Row="1"
                        Margin="12,10,12,0"
                        SelectedIndex="{Binding SelectedTabIndex}"
                        TabStripPlacement="Left">
                <TabItem Header="Справка">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,12">
                        <TextBlock Text="{Binding HelpGuideText}"
                                   FontSize="13"
                                   LineHeight="22"
                                   Foreground="#334155"
                                   TextWrapping="Wrap"/>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Что нового?">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,12">
                        <ItemsControl ItemsSource="{Binding ChangelogEntries}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ChangelogEntryViewModel">
                                    <Grid ColumnDefinitions="18,*" Margin="0,0,0,18">
                                        <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                            <Border Width="10"
                                                    Height="10"
                                                    CornerRadius="5"
                                                    Background="#3B82F6"
                                                    Margin="0,4,0,0"/>
                                            <Border Width="2"
                                                    Background="#CBD5E1"
                                                    HorizontalAlignment="Center"
                                                    MinHeight="48"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="6" Margin="8,0,0,0">
                                            <TextBlock Text="{Binding Title}"
                                                       FontSize="15"
                                                       FontWeight="SemiBold"
                                                       Foreground="#0F172A"/>
                                            <ItemsControl ItemsSource="{Binding Items}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2">
                                                            <TextBlock Text="•"
                                                                       Foreground="#3B82F6"
                                                                       FontWeight="Bold"/>
                                                            <TextBlock Text="{Binding}"
                                                                       TextWrapping="Wrap"
                                                                       Foreground="#475569"
                                                                       FontSize="13"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Обновить">
                    <StackPanel Margin="20"
                                Spacing="14"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                MaxWidth="420">
                        <TextBlock Text="Проверка обновлений NurSapat"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="#0F172A"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"/>
                        <TextBlock Text="{Binding UpdateStatusText}"
                                   TextWrapping="Wrap"
                                   Foreground="#64748B"
                                   FontSize="13"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Center"/>
                        <ProgressBar Height="8"
                                     Minimum="0"
                                     Maximum="100"
                                     IsIndeterminate="{Binding IsUpdateProgressIndeterminate}"
                                     IsVisible="{Binding IsCheckingUpdates}"/>
                        <StackPanel Orientation="Horizontal"
                                    Spacing="8"
                                    HorizontalAlignment="Center">
                            <Button Classes="mat-primary"
                                    Content="Проверить наличие обновлений"
                                    Command="{Binding CheckForUpdatesCommand}"
                                    MinWidth="240"
                                    MinHeight="38"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"/>
                            <Button Classes="mat-toolbar"
                                    Content="Открыть страницу загрузки"
                                    Command="{Binding OpenDownloadPageCommand}"
                                    MinHeight="38"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </TabItem>

                <TabItem Header="Консультация">
                    <StackPanel Margin="20"
                                Spacing="12"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                MaxWidth="360">
                        <TextBlock Text="Техподдержка NurSapat"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="#0F172A"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Свяжитесь с разработчиками для консультации по установке, настройке и работе в конструкторе."
                                   TextWrapping="Wrap"
                                   Foreground="#64748B"
                                   FontSize="13"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Center"/>
                        <Button Classes="mat-primary tg-btn"
                                Content="Telegram"
                                Command="{Binding OpenTelegramCommand}"
                                MinWidth="280"
                                MinHeight="44"/>

                        <Button Classes="mat-primary wa-btn"
                                Content="WhatsApp"
                                Command="{Binding OpenWhatsAppCommand}"
                                MinWidth="280"
                                MinHeight="44"/>

                        <Button Classes="mat-primary phone-btn"
                                Content="{Binding SupportPhoneDisplay}"
                                Command="{Binding OpenPhoneCommand}"
                                MinWidth="280"
                                MinHeight="44"/>
                    </StackPanel>
                </TabItem>

                <TabItem Header="О программе">
                    <StackPanel Margin="20"
                                Spacing="10"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center">
                        <Image Source="avares://NurSapat.App/Assets/Logo.png"
                               Width="96"
                               Height="96"
                               HorizontalAlignment="Center"/>
                        <TextBlock Text="NurSapat"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="#0F172A"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding AppVersion, StringFormat=Версия {0}}"
                                   FontSize="14"
                                   Foreground="#64748B"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="ERP/CAD для оконного производства"
                                   FontSize="13"
                                   Foreground="#475569"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Copyright © 2026 NurSapat. Все права защищены."
                                   FontSize="12"
                                   Foreground="#94A3B8"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"/>
                        <TextBlock Text="Лицензия: проприетарное программное обеспечение.&#x0a;Использование допускается согласно лицензионному соглашению."
                                   FontSize="12"
                                   Foreground="#94A3B8"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   MaxWidth="360"/>
                    </StackPanel>
                </TabItem>
            </TabControl>

            <Border Grid.Row="2" Padding="16,10" Background="#F8FAFC" CornerRadius="0,0,12,12">
                <Button Classes="mat-toolbar"
                        Content="Закрыть"
                        Command="{Binding CloseCommand}"
                        MinWidth="100"
                        MinHeight="34"
                        HorizontalAlignment="Right"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"/>
            </Border>
        </Grid>
    </Border>
</Window>
