<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:NurSapat.App.ViewModels"
             x:Class="NurSapat.App.Views.OrderSheet.OrderGeneralInfoCard"
             x:DataType="vm:OrderSheetViewModel"
             FontFamily="Inter, Segoe UI"
             MinHeight="168"
             MaxHeight="190">

    <UserControl.Styles>
        <StyleInclude Source="/Styles/OrderSheetStyles.axaml"/>
    </UserControl.Styles>

    <Border Classes="card" Padding="12,10">
        <Grid RowDefinitions="Auto,*,*" RowSpacing="12">
            <TextBlock Classes="cardTitle" Text="Общие данные заказа"/>

            <!-- Строка 1: Заказчик · Телефон · Дилер · № заказа · Дата -->
            <Grid Grid.Row="1" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.4*" MinWidth="160"/>
                    <ColumnDefinition Width="1.3*" MinWidth="120"/>
                    <ColumnDefinition Width="2*" MinWidth="160"/>
                    <ColumnDefinition Width="0.9*" MinWidth="90"/>
                    <ColumnDefinition Width="Auto" MinWidth="200"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="0">
                    <TextBlock Classes="fieldLabel" Text="Заказчик"/>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                        <ComboBox Classes="field"
                                  ItemsSource="{Binding AvailableCustomers}"
                                  SelectedItem="{Binding SelectedCustomer, Mode=TwoWay}"
                                  IsTextSearchEnabled="True">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Spacing="0">
                                        <TextBlock Text="{Binding FullName}" FontWeight="SemiBold" FontSize="13"/>
                                        <TextBlock Text="{Binding DetailText}" FontSize="10" Foreground="#667085"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button Grid.Column="1"
                                Classes="ref"
                                Content="..."
                                Command="{Binding BrowseCustomerCommand}"
                                ToolTip.Tip="Справочник заказчиков"/>
                    </Grid>
                </StackPanel>

                <StackPanel Grid.Column="1" Spacing="0">
                    <TextBlock Classes="fieldLabel" Text="Телефон"/>
                    <TextBox Classes="field-readonly"
                             IsReadOnly="True"
                             PlaceholderText="+996 (___) __ __ __"
                             Text="{Binding CustomerPhone}"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Spacing="0">
                    <TextBlock Classes="fieldLabel" Text="Дилер"/>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                        <TextBox Classes="field"
                                 PlaceholderText="Название дилера"
                                 Text="{Binding DealerName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Grid.Column="1"
                                Classes="ref"
                                Content="..."
                                Margin="2,0,0,0"
                                Command="{Binding BrowseManagerCommand}"
                                ToolTip.Tip="Справочник"/>
                    </Grid>
                </StackPanel>

                <StackPanel Grid.Column="3" Spacing="0">
                    <TextBlock Classes="fieldLabel" Text="№ заказа"/>
                    <TextBox Classes="field-readonly"
                             IsReadOnly="True"
                             Text="{Binding OrderNumberDisplay}"/>
                </StackPanel>

                <StackPanel Grid.Column="4" Spacing="0" HorizontalAlignment="Left">
                    <TextBlock Classes="fieldLabel" Text="Дата"/>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBox Classes="field date-part"
                                 Width="45"
                                 PlaceholderText="дд"
                                 HorizontalContentAlignment="Center"
                                 Text="{Binding OrderDateDay, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                        <TextBox Classes="field date-part"
                                 Width="80"
                                 PlaceholderText="месяц"
                                 HorizontalContentAlignment="Center"
                                 Text="{Binding OrderDateMonth, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                        <TextBox Classes="field date-part"
                                 Width="60"
                                 PlaceholderText="гггг"
                                 HorizontalContentAlignment="Center"
                                 Text="{Binding OrderDateYear, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- Строка 2: Адрес · Город · Договор № · Дата договора · Код -->
            <Grid Grid.Row="2" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.4*" MinWidth="160"/>
                    <ColumnDefinition Width="1.1*" MinWidth="100"/>
                    <ColumnDefinition Width="1.6*" MinWidth="120"/>
                    <ColumnDefinition Width="Auto" MinWidth="200"/>
                    <ColumnDefinition Width="1*" MinWidth="90"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="0">
                    <TextBlock Classes="fieldLabel" Text="Адрес объекта"/>
                    <TextBox Classes="field"
                             PlaceholderText="ул., дом, кв."
                             Text="{Binding ObjectAddress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Spacing="0">
                    <TextBlock Classes="fieldLabel" Text="Город"/>
                    <TextBox Classes="field"
                             PlaceholderText="Бишкек"
                             Text="{Binding CustomerCity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Spacing="0">
                    <TextBlock Classes="fieldLabel" Text="Договор №"/>
                    <TextBox Classes="field"
                             PlaceholderText="D-2026/001"
                             Text="{Binding ContractNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <StackPanel Grid.Column="3" Spacing="0" HorizontalAlignment="Left">
                    <TextBlock Classes="fieldLabel" Text="Дата договора"/>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBox Classes="field date-part"
                                 Width="45"
                                 PlaceholderText="дд"
                                 HorizontalContentAlignment="Center"
                                 Text="{Binding ContractDateDay, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                        <TextBox Classes="field date-part"
                                 Width="80"
                                 PlaceholderText="месяц"
                                 HorizontalContentAlignment="Center"
                                 Text="{Binding ContractDateMonth, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                        <TextBox Classes="field date-part"
                                 Width="60"
                                 PlaceholderText="гггг"
                                 HorizontalContentAlignment="Center"
                                 Text="{Binding ContractDateYear, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="4" Spacing="0">
                    <TextBlock Classes="fieldLabel" Text="Код"/>
                    <TextBox Classes="field"
                             PlaceholderText="AC-1258"
                             Text="{Binding CustomerCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>
