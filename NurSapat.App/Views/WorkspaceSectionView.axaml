<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:NurSapat.App.ViewModels"
             x:Class="NurSapat.App.Views.WorkspaceSectionView"
             x:DataType="vm:WorkspaceSectionViewModel">
	<Grid Background="{StaticResource SurfaceBrush}">
		<Border Background="{StaticResource BackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="28"
                Margin="24"
                VerticalAlignment="Top">
			<StackPanel Spacing="18">
				<StackPanel Spacing="6">
					<TextBlock Text="{Binding Title}"
                               FontSize="28"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}"/>
					<TextBlock Text="{Binding Description}"
                               FontSize="14"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               TextWrapping="Wrap"/>
				</StackPanel>
				<ItemsControl ItemsSource="{Binding WorkItems}">
					<ItemsControl.ItemTemplate>
						<DataTemplate>
							<Border Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="14"
                                    Margin="0,0,0,8">
								<TextBlock Text="{Binding}"
                                           Foreground="{StaticResource TextBrush}"
                                           FontSize="14"/>
							</Border>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>
			</StackPanel>
		</Border>
	</Grid>
</UserControl>
