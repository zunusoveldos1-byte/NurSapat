<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:NurSapat.App.ViewModels.Dialogs.Edit"
        xmlns:controls="clr-namespace:NurSapat.Cad.UI.Controls;assembly=NurSapat.Cad.UI"
        xmlns:picker="using:Avalonia.Controls"
        x:Class="NurSapat.App.Views.Dialogs.Edit.OrderColorDialogWindow"
        x:DataType="vm:OrderColorDialogViewModel"
        Title="{DynamicResource Edit_OrderColor_Title}"
        MinWidth="820"
        MinHeight="560"
        Width="900"
        Height="600"
        WindowStartupLocation="CenterOwner"
        WindowDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="0"
        Background="#F6F9FD"
        FontFamily="Inter">

    <Window.Styles>
        <StyleInclude Source="/Styles/EditDialogStyles.axaml"/>
    </Window.Styles>

    <Border Background="White"
            BorderBrush="#808080"
            BorderThickness="2"
            CornerRadius="10"
            PointerPressed="OnWindowPointerPressed">
        <Grid RowDefinitions="Auto,*" Margin="20">
            <TextBlock Grid.Row="0"
                       Classes="edit-dialog-section-title"
                       Text="{DynamicResource Edit_OrderColor_Title}"
                       Margin="0,0,0,16"/>

            <Grid Grid.Row="1" ColumnDefinitions="*,340" ColumnSpacing="16">
                <Border Classes="edit-dialog-card edit-preview-frame" Padding="12">
                    <controls:CadCanvasControl Editor="{Binding PreviewEditor}"
                                               IsThumbnailPreview="True"
                                               AutoFitOnResize="True"/>
                </Border>

                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="16">
                        <Border Classes="edit-dialog-card"
                                Background="#FFF7ED"
                                BorderBrush="#FDBA74">
                            <TextBlock Text="{DynamicResource Edit_OrderColor_Warning}"
                                       Classes="edit-dialog-body"
                                       TextWrapping="Wrap"/>
                        </Border>

                        <Border Classes="edit-dialog-card">
                            <StackPanel Spacing="8">
                                <TextBlock Classes="edit-dialog-section-title"
                                           Text="{DynamicResource Edit_OrderColor_ConstructionCount}"/>
                                <TextBlock Text="{Binding ConstructionCount}"
                                           FontSize="24"
                                           FontWeight="SemiBold"
                                           Foreground="#0F172A"/>
                            </StackPanel>
                        </Border>

                        <Border Classes="edit-dialog-card">
                            <StackPanel Spacing="12">
                                <picker:ColorPicker Color="{Binding SelectedColor}"
                                                    IsAlphaEnabled="False"/>
                                <CheckBox Content="{DynamicResource Edit_OrderColor_AllConstructions}"
                                          IsChecked="{Binding ApplyToAllConstructions}"/>
                                <CheckBox Content="{DynamicResource Edit_OrderColor_AllSashes}"
                                          IsChecked="{Binding ApplyToAllSashes}"/>
                                <CheckBox Content="{DynamicResource Edit_OrderColor_AllImposts}"
                                          IsChecked="{Binding ApplyToAllImposts}"/>
                                <CheckBox Content="{DynamicResource Edit_OrderColor_AllDecorative}"
                                          IsChecked="{Binding ApplyToAllDecorativeElements}"/>
                            </StackPanel>
                        </Border>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <Button Grid.Column="0"
                                    Classes="edit-dialog-primary"
                                    Content="{DynamicResource Edit_OrderColor_Apply}"
                                    Command="{Binding ApplyCommand}"/>
                            <Button Grid.Column="1"
                                    Classes="edit-dialog-action"
                                    Content="{DynamicResource Edit_OrderColor_Cancel}"
                                    Command="{Binding CancelCommand}"/>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Border>
</Window>
