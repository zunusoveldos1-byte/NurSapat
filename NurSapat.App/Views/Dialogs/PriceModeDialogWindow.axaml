<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:NurSapat.App.ViewModels.Dialogs"
        xmlns:orders="clr-namespace:NurSapat.Core.Models.Orders;assembly=NurSapat.Core"
        xmlns:conv="clr-namespace:NurSapat.App.Converters"
        xmlns:controls="clr-namespace:NurSapat.App.Views.Dialogs.Controls"
        x:Class="NurSapat.App.Views.Dialogs.PriceModeDialogWindow"
        x:DataType="vm:PriceModeDialogViewModel"
        Width="540"
        Height="560"
        MinWidth="500"
        MinHeight="500"
        WindowStartupLocation="CenterOwner"
        WindowDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="-1"
        Background="Transparent"
        FontFamily="Inter">

    <Window.Styles>
        <StyleInclude Source="/Styles/MaterialsDictionaryStyles.axaml"/>
        <StyleInclude Source="/Styles/ErpDialogStyles.axaml"/>
    </Window.Styles>

    <Border Classes="mat-shell" Margin="8">
        <Grid RowDefinitions="32,*,Auto">
            <controls:ErpDialogTitleBar Grid.Row="0"
                                        x:Name="TitleBar"
                                        Title="{Binding Title}"
                                        CloseRequested="OnTitleBarClose"/>

            <ScrollViewer Grid.Row="1" Margin="16,0,16,8">
                <StackPanel Spacing="0">
                    <StackPanel Classes="erp-field">
                        <TextBlock Classes="erp-label" Text="Тип расчёта"/>
                        <ListBox Classes="erp-radio-list"
                                 ItemsSource="{Binding PriceModes}"
                                 SelectedItem="{Binding SelectedPriceMode}"
                                 MaxHeight="148">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="orders:PriceModeType">
                                    <TextBlock Text="{Binding Converter={x:Static conv:PriceModeDisplayConverter.Instance}}"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,0,0,12">
                        <StackPanel Classes="erp-field" Margin="0">
                            <TextBlock Classes="erp-label" Text="Скидка, %"/>
                            <NumericUpDown Classes="erp-input"
                                           Value="{Binding DiscountPercent}"
                                           Minimum="0"
                                           Maximum="100"
                                           Increment="0.5"
                                           FormatString="N1"/>
                        </StackPanel>
                        <StackPanel Classes="erp-field" Margin="0">
                            <TextBlock Classes="erp-label" Text="Скидка, сом"/>
                            <NumericUpDown Classes="erp-input"
                                           Value="{Binding DiscountSum}"
                                           Minimum="0"
                                           Increment="100"
                                           FormatString="N0"/>
                        </StackPanel>
                    </Grid>
                    <Border Classes="erp-error-card"
                            Margin="0,0,0,12"
                            IsVisible="{Binding DiscountError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <TextBlock Text="{Binding DiscountError}" Foreground="#DC2626" TextWrapping="Wrap"/>
                    </Border>
                    <Border Classes="erp-margin-card">
                        <StackPanel Spacing="6">
                            <TextBlock Text="{Binding Subtotal, StringFormat=Подитог: {0:N0} сом}" Foreground="#166534"/>
                            <TextBlock Text="{Binding EstimatedCost, StringFormat=Себестоимость (оценка): {0:N0} сом}" Foreground="#166534"/>
                            <TextBlock Text="{Binding MarginAmount, StringFormat=Маржа (прибыль): {0:N0} сом}"
                                       FontWeight="SemiBold"
                                       Foreground="#14532D"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" Classes="erp-dialog-footer">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                    <Button Classes="mat-toolbar" Command="{Binding CancelCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="✕" FontSize="11"/>
                            <TextBlock Text="Отмена"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="mat-primary" Command="{Binding ConfirmCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="✓" FontSize="11" Foreground="White"/>
                            <TextBlock Text="Применить" Foreground="White"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
