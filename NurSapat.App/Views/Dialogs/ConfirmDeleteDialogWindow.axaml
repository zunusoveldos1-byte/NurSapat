<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:NurSapat.App.ViewModels.Dialogs"
        xmlns:controls="clr-namespace:NurSapat.App.Views.Dialogs.Controls"
        x:Class="NurSapat.App.Views.Dialogs.ConfirmDeleteDialogWindow"
        x:DataType="vm:ConfirmDeleteDialogViewModel"
        Width="500"
        Height="240"
        MinHeight="220"
        WindowStartupLocation="CenterOwner"
        WindowDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="-1"
        CanResize="False"
        Background="Transparent"
        FontFamily="Inter">

    <Window.Styles>
        <StyleInclude Source="/Styles/MaterialsDictionaryStyles.axaml"/>
        <StyleInclude Source="/Styles/ErpDialogStyles.axaml"/>
    </Window.Styles>

    <Border Classes="mat-shell" Margin="8">
        <Grid RowDefinitions="32,*,Auto">
            <controls:ErpDialogTitleBar Grid.Row="0"
                                        x:Name="TitleBar"
                                        Title="{Binding Title}"
                                        IsWarning="True"
                                        CloseRequested="OnTitleBarClose"/>

            <Border Grid.Row="1" Margin="16,16,16,8" Classes="erp-error-card">
                <TextBlock Text="{Binding ConfirmationMessage}"
                           TextWrapping="Wrap"
                           Foreground="#991B1B"
                           FontSize="13"
                           VerticalAlignment="Center"/>
            </Border>

            <Border Grid.Row="2" Classes="erp-dialog-footer">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                    <Button Classes="mat-toolbar" Command="{Binding CancelCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="✕" FontSize="11"/>
                            <TextBlock Text="Отмена"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="mat-danger" Command="{Binding ConfirmCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="🗑" FontSize="11" Foreground="White"/>
                            <TextBlock Text="Да, удалить" Foreground="White"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
