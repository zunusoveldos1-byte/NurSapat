<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:NurSapat.App.ViewModels"
        x:Class="NurSapat.App.Views.Dialogs.AutoSaveRecoveryWindow"
        x:DataType="vm:AutoSaveRecoveryViewModel"
        Title="Автосохранение"
        Width="420"
        Height="130"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        WindowDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="0"
        FontFamily="Inter">

    <!-- Серая рамка вокруг окна -->
    <Border Background="White"
            BorderBrush="#808080"
            BorderThickness="2"
            CornerRadius="8"
            PointerPressed="OnWindowPointerPressed">
        
        <StackPanel Margin="24" Spacing="16">
            <TextBlock Text="Обнаружен автоматически сохранённый проект.&#x0a;Восстановить его?"
                       TextWrapping="Wrap"
                       FontSize="13"/>
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <Button Content="Да" 
                        Command="{Binding YesCommand}" 
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"/>
                <Button Grid.Column="1" 
                        Content="Нет" 
                        Command="{Binding NoCommand}" 
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"/>
            </Grid>
        </StackPanel>
    </Border>
</Window>