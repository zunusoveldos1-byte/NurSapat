<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:NurSapat.App.ViewModels.Dialogs"
        x:Class="NurSapat.App.Views.Dialogs.CreateLocalAccountDialog"
        x:DataType="vm:CreateLocalAccountDialogViewModel"
        Width="420"
        Height="340"
        MinWidth="380"
        MinHeight="300"
        WindowStartupLocation="CenterOwner"
        WindowDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="-1"
        Background="Transparent"
        FontFamily="Inter">

    <Window.Styles>
        <StyleInclude Source="/Styles/MaterialsDictionaryStyles.axaml"/>
    </Window.Styles>

    <Border Classes="mat-shell" Margin="8">
        <Grid RowDefinitions="32,*,Auto">
            <Border Grid.Row="0" Classes="mat-titlebar" PointerPressed="OnTitleBarPointerPressed">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="16,0,0,0" VerticalAlignment="Center">
                        <Image Source="/Assets/logo.ico" Width="16" Height="16"/>
                        <TextBlock Classes="mat-titlebar-text" Text="Новый локальный аккаунт"/>
                    </StackPanel>
                    <Button Grid.Column="1"
                            Classes="mat-chrome-btn close"
                            Click="OnCloseClick"
                            Content="✕"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"/>
                </Grid>
            </Border>

            <StackPanel Grid.Row="1" Margin="16" Spacing="10">
                <TextBlock Text="Создайте отдельный профиль на этом ПК. Материалы и заказы будут храниться независимо."
                           TextWrapping="Wrap"
                           Foreground="#64748B"
                           FontSize="12"/>
                <TextBox Text="{Binding Email}"
                         PlaceholderText="Email"
                         MinHeight="34"
                         VerticalContentAlignment="Center"/>
                <TextBox Text="{Binding Password}"
                         PasswordChar="•"
                         PlaceholderText="Пароль"
                         MinHeight="34"
                         VerticalContentAlignment="Center"/>
                <TextBox Text="{Binding ConfirmPassword}"
                         PasswordChar="•"
                         PlaceholderText="Подтвердите пароль"
                         MinHeight="34"
                         VerticalContentAlignment="Center"/>
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="#DC2626"
                           TextWrapping="Wrap"
                           IsVisible="{Binding !!ErrorMessage}"/>
            </StackPanel>

            <Border Grid.Row="2" Padding="16" Background="#F8FAFC" CornerRadius="0,0,12,12">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                    <Button Classes="mat-toolbar"
                            Content="Отмена"
                            Command="{Binding CancelCommand}"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"/>
                    <Button Classes="mat-primary"
                            Content="Создать"
                            Command="{Binding ConfirmCommand}"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
