<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:NurSapat.App.ViewModels.Dictionaries"
        x:Class="NurSapat.App.Views.Dictionaries.GraphicSymbolEditWindow"
        x:DataType="vm:GraphicSymbolEditViewModel"
        Width="560"
        Height="360"
        WindowStartupLocation="CenterOwner"
        WindowDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="-1"
        Background="Transparent"
        FontFamily="Inter">
    <Window.Styles>
        <StyleInclude Source="/Styles/MaterialsDictionaryStyles.axaml"/>
    </Window.Styles>
    <Border Classes="mat-shell" Margin="12">
        <Grid RowDefinitions="32,*,Auto">
            <Border Grid.Row="0" Classes="mat-titlebar" PointerPressed="OnTitleBarPointerPressed">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Classes="mat-titlebar-text" Text="{Binding WindowTitle}" Margin="16,0,0,0" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Classes="mat-chrome-btn close" Click="OnCloseClick" Content="✕" Margin="0,0,8,0"/>
                </Grid>
            </Border>
            <Border Grid.Row="1" Classes="mat-card" Margin="12,0,12,0">
                <Grid ColumnDefinitions="140,*" RowDefinitions="Auto,Auto" RowSpacing="12">
                    <TextBlock Text="Наименование" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Text="{Binding Name}"/>
                    <TextBlock Grid.Row="1" Text="Код" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Code}"/>
                </Grid>
            </Border>
            <Border Grid.Row="2" Padding="16" Background="#F8FAFC" CornerRadius="0,0,12,12">
                <StackPanel Spacing="8">
                    <TextBlock Text="{Binding ValidationMessage}" Foreground="#DC2626"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                        <Button Classes="mat-toolbar" Content="Отмена" Command="{Binding CancelCommand}"/>
                        <Button Classes="mat-primary" Content="ОК" Command="{Binding SaveCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
