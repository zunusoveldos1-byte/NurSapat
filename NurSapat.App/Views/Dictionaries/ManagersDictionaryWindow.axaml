<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:NurSapat.App.ViewModels.Dictionaries"
        xmlns:dg="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls.DataGrid"
        x:Class="NurSapat.App.Views.Dictionaries.ManagersDictionaryWindow"
        x:DataType="vm:ManagersDictionaryViewModel"
        Width="1120"
        Height="700"
        MinWidth="900"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        WindowDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="-1"
        Background="Transparent"
        FontFamily="Inter">

    <Window.Styles>
        <StyleInclude Source="/Styles/MaterialsDictionaryStyles.axaml"/>
    </Window.Styles>

    <Border Classes="mat-shell" Margin="12">
        <Grid RowDefinitions="32,Auto,*,Auto">
            <Border Grid.Row="0" Classes="mat-titlebar" PointerPressed="OnTitleBarPointerPressed">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="16,0,0,0">
                        <Image Source="/Assets/logo.ico" Width="16" Height="16" VerticalAlignment="Center"/>
                        <TextBlock Classes="mat-titlebar-text" Text="{Binding Title}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                        <Button Classes="mat-chrome-btn" Click="OnMinimizeClick" Content="—"/>
                        <Button Classes="mat-chrome-btn" Click="OnMaximizeClick" Content="▢"/>
                        <Button Classes="mat-chrome-btn close" Click="OnCloseClick" Content="✕"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1" Margin="12,0,12,0" Padding="0,0,0,10" Background="White">
                <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="8">
                    <TextBox Grid.Column="0"
                             PlaceholderText="Поиск по ФИО, телефону, email..."
                             Text="{Binding SearchText}"
                             MinHeight="36"
                             VerticalContentAlignment="Center"/>
                    <ComboBox Grid.Column="1"
                              Width="140"
                              ItemsSource="{Binding ActiveFilters}"
                              SelectedItem="{Binding ActiveFilter}"
                              MinHeight="36"/>
                    <Button Grid.Column="2" Classes="mat-primary" Content="Добавить" Command="{Binding AddCommand}"/>
                    <Button Grid.Column="3" Classes="mat-toolbar" Content="Изменить" Command="{Binding EditCommand}"/>
                    <Button Grid.Column="4" Classes="mat-toolbar" Content="Просмотр" Command="{Binding ViewSelectedCommand}"/>
                    <Button Grid.Column="5" Classes="mat-toolbar" Content="Удалить" Command="{Binding DeleteCommand}"/>
                    <Button Grid.Column="6" Classes="mat-toolbar" Content="Закрыть" Command="{Binding CloseWindowCommand}"/>
                </Grid>
            </Border>

            <dg:DataGrid Grid.Row="2"
                         Margin="12,0,12,0"
                         ItemsSource="{Binding FilteredItems}"
                         SelectedItem="{Binding SelectedItem}"
                         AutoGenerateColumns="False"
                         CanUserReorderColumns="False"
                         CanUserResizeColumns="True"
                         CanUserSortColumns="True"
                         GridLinesVisibility="Horizontal"
                         BorderBrush="#E2E8F0"
                         BorderThickness="1"
                         IsReadOnly="True"
                         DoubleTapped="OnGridDoubleTapped">
                <dg:DataGrid.Columns>
                    <dg:DataGridTextColumn Header="№" Binding="{Binding RowNumber}" Width="50"/>
                    <dg:DataGridTextColumn Header="ФИО" Binding="{Binding FullName}" Width="2*"/>
                    <dg:DataGridTextColumn Header="Телефон" Binding="{Binding Phone}" Width="140"/>
                    <dg:DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="180"/>
                    <dg:DataGridTextColumn Header="Должность" Binding="{Binding Position}" Width="140"/>
                    <dg:DataGridTextColumn Header="Отдел" Binding="{Binding Department}" Width="140"/>
                    <dg:DataGridTextColumn Header="Активен" Binding="{Binding ActiveDisplay}" Width="90"/>
                    <dg:DataGridTextColumn Header="Примечание" Binding="{Binding Note}" Width="*"/>
                </dg:DataGrid.Columns>
            </dg:DataGrid>

            <Border Grid.Row="3" Padding="16" Background="#F8FAFC" CornerRadius="0,0,12,12">
                <TextBlock VerticalAlignment="Center"
                           Foreground="#64748B"
                           Text="{Binding FilteredItems.Count, StringFormat=Показано менеджеров: {0}}"/>
            </Border>
        </Grid>
    </Border>
</Window>
