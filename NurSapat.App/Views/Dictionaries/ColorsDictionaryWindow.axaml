<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:NurSapat.App.ViewModels.Dictionaries"
        xmlns:dg="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls.DataGrid"
        x:Class="NurSapat.App.Views.Dictionaries.ColorsDictionaryWindow"
        x:DataType="vm:WindowColorsDictionaryViewModel"
        Width="820"
        Height="620"
        MinWidth="680"
        MinHeight="480"
        WindowStartupLocation="CenterOwner"
        WindowDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="-1"
        Background="Transparent"
        FontFamily="Inter">

    <Window.Styles>
        <StyleInclude Source="/Styles/MaterialsDictionaryStyles.axaml"/>
    </Window.Styles>

    <Border Classes="mat-shell" Margin="12">
        <Grid RowDefinitions="40,Auto,*,Auto">
            <Border Grid.Row="0"
                    Classes="mat-titlebar"
                    PointerPressed="OnTitleBarPointerPressed">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Orientation="Horizontal"
                                Spacing="8"
                                VerticalAlignment="Center"
                                Margin="16,0,0,0">
                        <Image Source="/Assets/logo.ico" Width="16" Height="16" VerticalAlignment="Center"/>
                        <TextBlock Classes="mat-titlebar-text" Text="{Binding Title}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="0,0,8,0">
                        <Button Classes="mat-chrome-btn" Click="OnMinimizeClick" Content="—"/>
                        <Button Classes="mat-chrome-btn" Click="OnMaximizeClick" Content="▢"/>
                        <Button Classes="mat-chrome-btn close" Click="OnCloseClick" Content="✕"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1"
                    Margin="12,12,12,0"
                    Padding="0,0,0,10"
                    Background="White">
                <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="10">
                    <TextBox Grid.Column="0"
                             PlaceholderText="Поиск по наименованию..."
                             Text="{Binding SearchText}"
                             MinHeight="36"
                             VerticalContentAlignment="Center"/>
                    <Button Grid.Column="1"
                            Classes="mat-primary"
                            Content="Добавить цвет"
                            Command="{Binding AddCommand}"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"/>
                    <Button Grid.Column="2"
                            Classes="mat-toolbar"
                            Content="Назначить цвет"
                            Command="{Binding AssignColorCommand}"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"/>
                    <Button Grid.Column="3"
                            Classes="mat-toolbar"
                            Content="Редактировать"
                            Command="{Binding EditCommand}"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"/>
                    <Button Grid.Column="4"
                            Classes="mat-toolbar"
                            Content="Удалить"
                            Command="{Binding DeleteCommand}"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"/>
                    <Button Grid.Column="5"
                            Classes="mat-toolbar"
                            Content="Закрыть"
                            Command="{Binding CloseWindowCommand}"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"/>
                </Grid>
            </Border>

            <dg:DataGrid Grid.Row="2"
                         Margin="12,0,12,0"
                         ItemsSource="{Binding FilteredItems}"
                         SelectedItem="{Binding SelectedItem}"
                         AutoGenerateColumns="False"
                         CanUserReorderColumns="False"
                         CanUserResizeColumns="True"
                         CanUserSortColumns="True"
                         GridLinesVisibility="Horizontal"
                         BorderBrush="#E2E8F0"
                         BorderThickness="1"
                         DoubleTapped="OnGridDoubleTapped">
                <dg:DataGrid.Columns>
                    <dg:DataGridTextColumn Header="Наименование цвета"
                                           Binding="{Binding Name}"
                                           Width="2*"
                                           IsReadOnly="False"/>
                    <dg:DataGridTextColumn Header="HEX"
                                           Binding="{Binding HexCode}"
                                           Width="120"
                                           IsReadOnly="True"/>
                    <dg:DataGridTemplateColumn Header="Цвет на чертеже" Width="160">
                        <dg:DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="vm:WindowColorDictionaryItemViewModel">
                                <Button Padding="4"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        HorizontalContentAlignment="Center"
                                        VerticalContentAlignment="Center"
                                        Command="{Binding $parent[Window].((vm:WindowColorsDictionaryViewModel)DataContext).AssignColorCommand}"
                                        CommandParameter="{Binding}">
                                    <Border Width="56"
                                            Height="28"
                                            CornerRadius="4"
                                            Background="{Binding Brush}"
                                            BorderBrush="#CBD5E1"
                                            BorderThickness="1"/>
                                </Button>
                            </DataTemplate>
                        </dg:DataGridTemplateColumn.CellTemplate>
                    </dg:DataGridTemplateColumn>
                </dg:DataGrid.Columns>
            </dg:DataGrid>

            <Border Grid.Row="3" Padding="16" Background="#F8FAFC" CornerRadius="0,0,12,12">
                <TextBlock VerticalAlignment="Center"
                           Foreground="#64748B"
                           Text="{Binding FilteredItems.Count, StringFormat=Показано цветов: {0}}"/>
            </Border>
        </Grid>
    </Border>
</Window>
