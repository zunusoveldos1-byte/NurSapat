<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dg="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls.DataGrid"
        x:Class="NurSapat.App.Views.Dictionaries.BaseDictionaryWindow"
        x:CompileBindings="False"
        Width="960"
        Height="640"
        MinWidth="720"
        MinHeight="480"
        WindowStartupLocation="CenterOwner"
        FontFamily="Inter"
        Background="#F6F9FD">

    <Border Background="White"
            BorderBrush="#E2E8F0"
            BorderThickness="1"
            CornerRadius="10"
            Margin="16"
            Padding="20">
        <Grid RowDefinitions="Auto,*,Auto" RowSpacing="16">
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <TextBox PlaceholderText="Поиск..."
                         Text="{Binding SearchText}"
                         MinHeight="36"
                         VerticalContentAlignment="Center"/>
                <Button Grid.Column="1"
                        Content="Добавить"
                        MinWidth="120"
                        MinHeight="36"
                        Command="{Binding AddCommand}"/>
            </Grid>

            <dg:DataGrid x:Name="ItemsDataGrid"
                         Grid.Row="1"
                         ItemsSource="{Binding FilteredItems}"
                         SelectedItem="{Binding SelectedItem}"
                         AutoGenerateColumns="False"
                         CanUserReorderColumns="False"
                         CanUserResizeColumns="True"
                         CanUserSortColumns="True"
                         GridLinesVisibility="Horizontal"
                         BorderBrush="#E2E8F0"
                         BorderThickness="1">
                <dg:DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Редактировать" Command="{Binding EditCommand}"/>
                        <MenuItem Header="Удалить" Command="{Binding DeleteCommand}"/>
                    </ContextMenu>
                </dg:DataGrid.ContextMenu>
            </dg:DataGrid>

            <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                <TextBlock Text="{Binding Title}"
                           VerticalAlignment="Center"
                           FontSize="13"
                           Foreground="#64748B"/>
                <Button Grid.Column="1"
                        Content="Редактировать"
                        MinWidth="130"
                        MinHeight="36"
                        Command="{Binding EditCommand}"/>
                <Button Grid.Column="2"
                        Content="Удалить"
                        MinWidth="110"
                        MinHeight="36"
                        Command="{Binding DeleteCommand}"/>
            </Grid>
        </Grid>
    </Border>
</Window>
