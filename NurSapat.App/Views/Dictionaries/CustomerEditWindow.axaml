<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:NurSapat.App.ViewModels.Dictionaries"
        x:Class="NurSapat.App.Views.Dictionaries.CustomerEditWindow"
        x:DataType="vm:CustomerEditViewModel"
        Width="720"
        Height="680"
        MinWidth="640"
        MinHeight="600"
        WindowStartupLocation="CenterOwner"
        WindowDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="-1"
        Background="Transparent"
        FontFamily="Inter">

    <Window.Styles>
        <StyleInclude Source="/Styles/MaterialsDictionaryStyles.axaml"/>
    </Window.Styles>

    <Border Classes="mat-shell" Margin="12">
        <Grid RowDefinitions="40,*,Auto">
            <Border Grid.Row="0"
                    Classes="mat-titlebar"
                    PointerPressed="OnTitleBarPointerPressed">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Orientation="Horizontal"
                                Spacing="8"
                                VerticalAlignment="Center"
                                Margin="16,0,0,0">
                        <Image Source="/Assets/logo.ico" Width="16" Height="16" VerticalAlignment="Center"/>
                        <TextBlock Classes="mat-titlebar-text" Text="{Binding WindowTitle}"/>
                    </StackPanel>
                    <Button Grid.Column="1"
                            Classes="mat-chrome-btn close"
                            Click="OnCloseClick"
                            Content="✕"
                            Margin="0,0,8,0"/>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" Margin="12,12,12,0" Padding="0,0,0,12">
                <StackPanel Spacing="14">
                    <Border Classes="mat-card">
                        <StackPanel Spacing="10">
                            <TextBlock Classes="mat-section-title" Text="Основное"/>
                            <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="10">
                                <TextBlock Grid.Row="0" Text="Наименование" VerticalAlignment="Center"/>
                                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding FullName}"/>

                                <TextBlock Grid.Row="1" Text="Телефон" VerticalAlignment="Center"/>
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Phone}"/>

                                <TextBlock Grid.Row="2" Text="Тип" VerticalAlignment="Center"/>
                                <ComboBox Grid.Row="2" Grid.Column="1"
                                          ItemsSource="{Binding CustomerTypes}"
                                          SelectedItem="{Binding Type}"/>

                                <TextBlock Grid.Row="3" Text="Оборот, сом" VerticalAlignment="Center"/>
                                <NumericUpDown Grid.Row="3" Grid.Column="1" Minimum="0" Increment="100" Value="{Binding Turnover}"/>

                                <TextBlock Grid.Row="4" Text="Долг, сом" VerticalAlignment="Center"/>
                                <NumericUpDown Grid.Row="4" Grid.Column="1" Minimum="0" Increment="100" Value="{Binding Debt}"/>
                            </Grid>

                            <TextBlock Text="Примечание" Margin="0,4,0,0"/>
                            <TextBox Text="{Binding Note}"
                                     AcceptsReturn="True"
                                     MinHeight="72"
                                     TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Border Classes="mat-card" Background="#F1F5F9">
                        <StackPanel Spacing="10">
                            <TextBlock Classes="mat-section-title" Text="Юридические реквизиты"/>
                            <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="10">
                                <TextBlock Grid.Row="0" Text="Код ЗКПО" VerticalAlignment="Center"/>
                                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding OkpoCode}"/>

                                <TextBlock Grid.Row="1" Text="Банк" VerticalAlignment="Center"/>
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding BankName}"/>

                                <TextBlock Grid.Row="2" Text="Расчетный счет" VerticalAlignment="Center"/>
                                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding CheckingAccount}"/>

                                <TextBlock Grid.Row="3" Text="МФО" VerticalAlignment="Center"/>
                                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Mfo}"/>

                                <TextBlock Grid.Row="4" Text="Юр. адрес" VerticalAlignment="Top" Margin="0,6,0,0"/>
                                <TextBox Grid.Row="4" Grid.Column="1"
                                         Text="{Binding LegalAddress}"
                                         AcceptsReturn="True"
                                         MinHeight="64"
                                         TextWrapping="Wrap"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" Padding="16" Background="#F8FAFC" CornerRadius="0,0,12,12">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                    <Button Classes="mat-toolbar"
                            Content="Отмена"
                            Command="{Binding CancelCommand}"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"/>
                    <Button Classes="mat-primary"
                            Content="ОК"
                            Command="{Binding SaveCommand}"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
