<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:NurSapat.App.ViewModels.Dictionaries"
        xmlns:dg="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls.DataGrid"
        x:Class="NurSapat.App.Views.Dictionaries.UsersDictionaryWindow"
        x:DataType="vm:UsersDictionaryViewModel"
        Width="960"
        Height="680"
        MinWidth="800"
        MinHeight="540"
        WindowStartupLocation="CenterOwner"
        WindowDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="-1"
        Background="Transparent"
        FontFamily="Inter">

    <Window.Styles>
        <StyleInclude Source="/Styles/MaterialsDictionaryStyles.axaml"/>
    </Window.Styles>

    <Border Classes="mat-shell" Margin="12">
        <Grid RowDefinitions="40,Auto,Auto,*,Auto">
            <Border Grid.Row="0" Classes="mat-titlebar" PointerPressed="OnTitleBarPointerPressed">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="16,0,0,0">
                        <Image Source="/Assets/logo.ico" Width="16" Height="16"/>
                        <TextBlock Classes="mat-titlebar-text" Text="{Binding Title}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,8,0">
                        <Button Classes="mat-chrome-btn" Click="OnMinimizeClick" Content="—"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                        <Button Classes="mat-chrome-btn" Click="OnMaximizeClick" Content="▢"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                        <Button Classes="mat-chrome-btn close" Click="OnCloseClick" Content="✕"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1" Margin="12,12,12,0" Padding="12" Classes="mat-card">
                <TextBlock Text="{Binding AccessNotice}" TextWrapping="Wrap" Foreground="#64748B"/>
            </Border>

            <Border Grid.Row="2" Margin="12,10,12,0" Padding="0,0,0,10" Background="White">
                <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="10">
                    <TextBox Grid.Column="0" PlaceholderText="Поиск по имени или № группы..."
                             Text="{Binding SearchText}" MinHeight="36" VerticalContentAlignment="Center"/>
                    <Button Grid.Column="1" Classes="mat-primary" Content="Добавить пользователя"
                            Command="{Binding AddUserCommand}" IsEnabled="{Binding CanManageUsers}"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                    <Button Grid.Column="2" Classes="mat-toolbar" Content="Редактировать пользователя"
                            Command="{Binding EditUserCommand}" IsEnabled="{Binding CanManageUsers}"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                    <Button Grid.Column="3" Classes="mat-toolbar" Content="Удалить пользователя"
                            Command="{Binding DeleteUserCommand}" IsEnabled="{Binding CanManageUsers}"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                    <Button Grid.Column="4" Classes="mat-toolbar" Content="Закрыть"
                            Command="{Binding CloseWindowCommand}"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                </Grid>
            </Border>

            <dg:DataGrid Grid.Row="3" Margin="12,0,12,0"
                         ItemsSource="{Binding FilteredItems}"
                         SelectedItem="{Binding SelectedItem}"
                         AutoGenerateColumns="False"
                         CanUserSortColumns="True"
                         GridLinesVisibility="Horizontal"
                         BorderBrush="#E2E8F0"
                         BorderThickness="1"
                         IsReadOnly="True"
                         DoubleTapped="OnGridDoubleTapped">
                <dg:DataGrid.Columns>
                    <dg:DataGridTextColumn Header="Пользователь" Binding="{Binding Username}" Width="2*" SortMemberPath="Username"/>
                    <dg:DataGridTextColumn Header="№ группы" Binding="{Binding GroupNumber}" Width="100" SortMemberPath="GroupNumber"/>
                    <dg:DataGridTextColumn Header="Администратор" Binding="{Binding AdministratorDisplay}" Width="130"/>
                </dg:DataGrid.Columns>
            </dg:DataGrid>

            <Border Grid.Row="4" Padding="16" Background="#F8FAFC" CornerRadius="0,0,12,12">
                <TextBlock Foreground="#64748B"
                           Text="{Binding FilteredItems.Count, StringFormat=Пользователей в справочнике: {0}}"/>
            </Border>
        </Grid>
    </Border>
</Window>
