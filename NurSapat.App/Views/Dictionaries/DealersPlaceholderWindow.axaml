<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="NurSapat.App.Views.Dictionaries.DealersPlaceholderWindow"
        Width="560"
        Height="320"
        MinWidth="480"
        MinHeight="280"
        WindowStartupLocation="CenterOwner"
        WindowDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="-1"
        Background="Transparent"
        FontFamily="Inter"
        Title="Дилеры">

    <Window.Styles>
        <StyleInclude Source="/Styles/MaterialsDictionaryStyles.axaml"/>
    </Window.Styles>

    <Border Classes="mat-shell" Margin="12">
        <Grid RowDefinitions="32,*,Auto">
            <Border Grid.Row="0" Classes="mat-titlebar" PointerPressed="OnTitleBarPointerPressed">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="16,0,0,0">
                        <Image Source="/Assets/logo.ico" Width="16" Height="16" VerticalAlignment="Center"/>
                        <TextBlock Classes="mat-titlebar-text" Text="Заказ → Дилер"/>
                    </StackPanel>
                    <Button Grid.Column="1" Classes="mat-chrome-btn close" Click="OnCloseClick" Content="✕" Margin="0,0,8,0"/>
                </Grid>
            </Border>

            <Border Grid.Row="1" Margin="24" Classes="mat-card" VerticalAlignment="Center">
                <StackPanel Spacing="10" HorizontalAlignment="Center">
                    <TextBlock Text="Раздел «Дилеры» временно отключён"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#0F172A"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Справочник будет связан с заказчиками типа Dealer.&#x0a;Сейчас функционал не реализован — заглушки удалены."
                               FontSize="13"
                               Foreground="#64748B"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               MaxWidth="420"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Padding="16" Background="#F8FAFC" CornerRadius="0,0,12,12">
                <Button Classes="mat-primary"
                        Content="Закрыть"
                        HorizontalAlignment="Right"
                        Click="OnCloseClick"/>
            </Border>
        </Grid>
    </Border>
</Window>
