<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:NurSapat.App.ViewModels.Dictionaries"
             xmlns:dg="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls.DataGrid"
             x:Class="NurSapat.App.Views.Dictionaries.EmbeddedOrdersDictionaryView"
             x:DataType="vm:OrdersDictionaryViewModel">
    <Grid RowDefinitions="Auto,*,Auto" Margin="16">
        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <TextBox PlaceholderText="Поиск..." Text="{Binding SearchText}" MinHeight="36"/>
            <Button Grid.Column="1" Content="Открыть" Command="{Binding OpenOrderCommand}"/>
            <Button Grid.Column="2" Content="Обновить" Command="{Binding RefreshStoreCommand}"/>
        </Grid>
        <dg:DataGrid Grid.Row="1" Margin="0,12,0,12"
                     ItemsSource="{Binding FilteredItems}"
                     SelectedItem="{Binding SelectedItem}"
                     AutoGenerateColumns="False"
                     IsReadOnly="True">
            <dg:DataGrid.Columns>
                <dg:DataGridTextColumn Header="Номер" Binding="{Binding OrderNumber}" Width="120"/>
                <dg:DataGridTextColumn Header="Дата" Binding="{Binding DateCreatedDisplay}" Width="110"/>
                <dg:DataGridTextColumn Header="Заказчик" Binding="{Binding CustomerName}" Width="2*"/>
                <dg:DataGridTextColumn Header="Сумма" Binding="{Binding TotalSumDisplay}" Width="120"/>
                <dg:DataGridTextColumn Header="Статус" Binding="{Binding StatusDisplay}" Width="140"/>
            </dg:DataGrid.Columns>
        </dg:DataGrid>
        <TextBlock Grid.Row="2" Text="{Binding FilteredItems.Count, StringFormat=Заказов: {0}}" Foreground="#64748B"/>
    </Grid>
</UserControl>
