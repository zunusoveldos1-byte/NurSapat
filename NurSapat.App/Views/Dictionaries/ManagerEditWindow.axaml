<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:NurSapat.App.ViewModels.Dictionaries"
        x:Class="NurSapat.App.Views.Dictionaries.ManagerEditWindow"
        x:DataType="vm:ManagerEditViewModel"
        Width="720"
        Height="700"
        MinWidth="640"
        MinHeight="600"
        WindowStartupLocation="CenterOwner"
        WindowDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="-1"
        Background="Transparent"
        FontFamily="Inter">

    <Window.Styles>
        <StyleInclude Source="/Styles/MaterialsDictionaryStyles.axaml"/>
    </Window.Styles>

    <Border Classes="mat-shell" Margin="12">
        <Grid RowDefinitions="32,*,Auto">
            <Border Grid.Row="0" Classes="mat-titlebar" PointerPressed="OnTitleBarPointerPressed">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="16,0,0,0">
                        <Image Source="/Assets/logo.ico" Width="16" Height="16" VerticalAlignment="Center"/>
                        <TextBlock Classes="mat-titlebar-text" Text="{Binding WindowTitle}"/>
                    </StackPanel>
                    <Button Grid.Column="1" Classes="mat-chrome-btn close" Click="OnCloseClick" Content="✕" Margin="0,0,8,0"/>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" Margin="12,0,12,0" Padding="0,0,0,12">
                <StackPanel Spacing="14">
                    <Border Classes="mat-card">
                        <StackPanel Spacing="10">
                            <TextBlock Classes="mat-section-title" Text="Основное"/>
                            <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="10">
                                <TextBlock Grid.Row="0" Text="ФИО" VerticalAlignment="Center"/>
                                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding FullName}"/>

                                <TextBlock Grid.Row="1" Text="Телефон" VerticalAlignment="Center"/>
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Phone}"/>

                                <TextBlock Grid.Row="2" Text="Email" VerticalAlignment="Center"/>
                                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Email}"/>

                                <TextBlock Grid.Row="3" Text="Должность" VerticalAlignment="Center"/>
                                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Position}"/>

                                <TextBlock Grid.Row="4" Text="Отдел" VerticalAlignment="Center"/>
                                <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Department}"/>

                                <TextBlock Grid.Row="5" Text="Дата приема" VerticalAlignment="Center"/>
                                <DatePicker Grid.Row="5" Grid.Column="1" SelectedDate="{Binding HireDate}"/>

                                <TextBlock Grid.Row="6" Text="Активен" VerticalAlignment="Center"/>
                                <CheckBox Grid.Row="6" Grid.Column="1" IsChecked="{Binding IsActive}" Content="Можно выбирать в заказах"/>

                                <TextBlock Grid.Row="7" Text="Примечание" VerticalAlignment="Top" Margin="0,6,0,0"/>
                                <TextBox Grid.Row="7" Grid.Column="1"
                                         Text="{Binding Note}"
                                         AcceptsReturn="True"
                                         MinHeight="64"
                                         TextWrapping="Wrap"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Classes="mat-card" Background="#F8FAFC">
                        <StackPanel Spacing="10">
                            <TextBlock Classes="mat-section-title" Text="Дополнительно"/>
                            <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
                                <TextBlock Grid.Row="0" Text="Логин" VerticalAlignment="Center"/>
                                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Login}"/>

                                <TextBlock Grid.Row="1" Text="Роль" VerticalAlignment="Center"/>
                                <ComboBox Grid.Row="1" Grid.Column="1"
                                          ItemsSource="{Binding Roles}"
                                          SelectedItem="{Binding Role}"
                                          IsEditable="True"/>

                                <TextBlock Grid.Row="2" Text="Фотография" VerticalAlignment="Center"/>
                                <TextBox Grid.Row="2" Grid.Column="1"
                                         Text="{Binding PhotoPath}"
                                         PlaceholderText="Путь к файлу (опционально)"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" Padding="16" Background="#F8FAFC" CornerRadius="0,0,12,12">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                    <Button Classes="mat-toolbar" Content="Отмена" Command="{Binding CancelCommand}"/>
                    <Button Classes="mat-primary" Content="ОК" Command="{Binding SaveCommand}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
