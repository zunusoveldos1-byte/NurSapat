<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:NurSapat.App.ViewModels.Dictionaries"
        x:Class="NurSapat.App.Views.Dictionaries.OrderTemplateEditWindow"
        x:DataType="vm:OrderTemplateEditViewModel"
        Width="720"
        Height="720"
        MinWidth="640"
        MinHeight="640"
        WindowStartupLocation="CenterOwner"
        WindowDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="-1"
        Background="Transparent"
        FontFamily="Inter">

    <Window.Styles>
        <StyleInclude Source="/Styles/MaterialsDictionaryStyles.axaml"/>
    </Window.Styles>

    <Border Classes="mat-shell" Margin="12">
        <Grid RowDefinitions="40,*,Auto">
            <Border Grid.Row="0"
                    Classes="mat-titlebar"
                    PointerPressed="OnTitleBarPointerPressed">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Classes="mat-titlebar-text"
                               Text="{Binding WindowTitle}"
                               Margin="16,0,0,0"
                               VerticalAlignment="Center"/>
                    <Button Grid.Column="1"
                            Classes="mat-chrome-btn close"
                            Click="OnCloseClick"
                            Content="✕"
                            Margin="0,0,8,0"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"/>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" Margin="12,12,12,0">
                <StackPanel Spacing="12">
                    <Border Classes="mat-card">
                        <Grid ColumnDefinitions="200,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="12">
                            <TextBlock Text="Наименование" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Text="{Binding Name}"/>

                            <TextBlock Grid.Row="1" Text="Производитель профиля" VerticalAlignment="Center"/>
                            <ComboBox Grid.Row="1"
                                      Grid.Column="1"
                                      ItemsSource="{Binding ManufacturerOptions}"
                                      SelectedItem="{Binding SelectedManufacturerOption}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate DataType="vm:ManufacturerSelectionOption">
                                        <TextBlock Text="{Binding DisplayName}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <TextBlock Grid.Row="2" Text="Валюта" VerticalAlignment="Center"/>
                            <ComboBox Grid.Row="2"
                                      Grid.Column="1"
                                      ItemsSource="{Binding CurrencyOptions}"
                                      SelectedItem="{Binding CurrencyCode}"/>
                        </Grid>
                    </Border>

                    <Border Classes="mat-card" Background="#F8FAFC">
                        <Grid ColumnDefinitions="200,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="12">
                            <TextBlock Text="Давление ветра" VerticalAlignment="Center"/>
                            <NumericUpDown Grid.Column="1"
                                           Minimum="0"
                                           Increment="10"
                                           FormatString="N0"
                                           Value="{Binding WindPressure}"/>

                            <TextBlock Grid.Row="1" Text="Затраты / Рентабельность" VerticalAlignment="Center"/>
                            <NumericUpDown Grid.Row="1"
                                             Grid.Column="1"
                                             Minimum="0"
                                             Increment="0.5"
                                             FormatString="N2"
                                             Value="{Binding ProfitMargin}"/>

                            <TextBlock Grid.Row="2" Text="Доп. расходы, %" VerticalAlignment="Center"/>
                            <NumericUpDown Grid.Row="2"
                                             Grid.Column="1"
                                             Minimum="0"
                                             Increment="0.5"
                                             FormatString="N2"
                                             Value="{Binding AdditionalExpensesPercent}"/>

                            <TextBlock Grid.Row="3" Text="Доп. расходы, фикс." VerticalAlignment="Center"/>
                            <NumericUpDown Grid.Row="3"
                                             Grid.Column="1"
                                             Minimum="0"
                                             Increment="100"
                                             FormatString="N2"
                                             Value="{Binding AdditionalExpensesFixed}"/>

                            <TextBlock Grid.Row="4" Text="Демонтаж" VerticalAlignment="Center"/>
                            <NumericUpDown Grid.Row="4"
                                             Grid.Column="1"
                                             Minimum="0"
                                             Increment="100"
                                             FormatString="N2"
                                             Value="{Binding DismantlingPrice}"/>

                            <TextBlock Grid.Row="5" Text="Монтаж" VerticalAlignment="Center"/>
                            <NumericUpDown Grid.Row="5"
                                             Grid.Column="1"
                                             Minimum="0"
                                             Increment="100"
                                             FormatString="N2"
                                             Value="{Binding InstallationPrice}"/>
                        </Grid>
                    </Border>

                    <Button Classes="mat-toolbar"
                            Content="Шаблонные параметры заказа"
                            Command="{Binding OpenTemplateParametersCommand}"
                            HorizontalAlignment="Center"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"/>

                    <TextBlock Text="{Binding ValidationMessage}"
                               Foreground="#DC2626"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" Padding="16" Background="#F8FAFC" CornerRadius="0,0,12,12">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                    <Button Classes="mat-toolbar"
                            Content="Отмена"
                            Command="{Binding CancelCommand}"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"/>
                    <Button Classes="mat-primary"
                            Content="ОК"
                            Command="{Binding SaveCommand}"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
