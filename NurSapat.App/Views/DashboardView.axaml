<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:NurSapat.App.ViewModels"
             xmlns:views="clr-namespace:NurSapat.App.Views"
             x:Class="NurSapat.App.Views.DashboardView"
             x:DataType="vm:DashboardViewModel">
	<Grid ColumnDefinitions="220,*">
		<!-- Левая панель меню -->
		<Border Grid.Column="0" Background="{StaticResource SurfaceBrush}">
			<ListBox ItemsSource="{Binding MenuItems}"
						SelectedItem="{Binding SelectedContent, Mode=TwoWay}"
						Background="Transparent"
						BorderThickness="0">
				<ListBox.ItemTemplate>
					<DataTemplate>
						<TextBlock Text="{Binding Title}"
								   Foreground="{StaticResource TextBrush}"
								   FontSize="16" Margin="10,8"/>
					</DataTemplate>
				</ListBox.ItemTemplate>
			</ListBox>
		</Border>

		<!-- Правая область контента -->
		<ContentControl Grid.Column="1" Content="{Binding SelectedContent}">
			<ContentControl.DataTemplates>
				<!-- Для заглушек используем просто TextBlock -->
				<DataTemplate DataType="vm:PlaceholderViewModel">
					<Border Background="{StaticResource BackgroundBrush}"
                            VerticalAlignment="Center" HorizontalAlignment="Center">
						<TextBlock Text="{Binding Title}"
                                   FontSize="48"
                                   Foreground="{StaticResource SecondaryTextBrush}"/>
					</Border>
				</DataTemplate>
			</ContentControl.DataTemplates>
		</ContentControl>
	</Grid>
</UserControl>