<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:NurSapat.App.ViewModels"
             xmlns:cadControls="clr-namespace:NurSapat.Cad.UI.Controls;assembly=NurSapat.Cad.UI"
             x:Class="NurSapat.App.Views.OrderDrawingView"
             x:DataType="vm:OrderDrawingViewModel">

    <UserControl.Styles>
        <Style Selector="Border.toolPanel">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
        </Style>
        <Style Selector="TextBlock.groupTitle">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="Margin" Value="0,12,0,8"/>
        </Style>
        <Style Selector="Button.designTool">
            <Setter Property="Height" Value="72"/>
            <Setter Property="Width" Value="88"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.designTool:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#EFF6FF"/>
            <Setter Property="BorderBrush" Value="#93C5FD"/>
        </Style>
        <Style Selector="Button.designTool.active">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="BorderBrush" Value="#1D4ED8"/>
        </Style>
        <Style Selector="Button.designTool.active TextBlock.toolIcon">
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.designTool.active TextBlock.toolLabel">
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="TextBlock.toolIcon">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="Foreground" Value="#2563EB"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBlock.toolLabel">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="MaxWidth" Value="76"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="*,36" Background="#F6F9FD">
        <Grid Grid.Row="0" ColumnDefinitions="300,*">
            <!-- Панель инструментов -->
            <Border Grid.Column="0" Classes="toolPanel">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14,10">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Конструктор" FontSize="16" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,0,0,4"/>
                        <TextBlock Text="Инструменты проектирования" FontSize="12" Foreground="#64748B" Margin="0,0,0,8"/>

                        <ItemsControl ItemsSource="{Binding ToolGroups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:CadDesignToolGroup">
                                    <StackPanel>
                                        <TextBlock Classes="groupTitle" Text="{Binding Title}"/>
                                        <ItemsControl ItemsSource="{Binding Tools}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="vm:CadDesignTool">
                                                    <Button Classes.designTool="True"
                                                            Classes.active="{Binding IsActive}"
                                                            Command="{Binding $parent[UserControl].((vm:OrderDrawingViewModel)DataContext).SelectToolCommand}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip.Tip="{Binding Title}">
                                                        <StackPanel Spacing="4">
                                                            <TextBlock Classes="toolIcon" Text="{Binding IconGlyph}"/>
                                                            <TextBlock Classes="toolLabel" Text="{Binding Title}"/>
                                                        </StackPanel>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Рабочая область CAD -->
            <Grid Grid.Column="1" RowDefinitions="Auto,*" Margin="0">
                <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="14,8">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <TextBlock Text="{Binding CadEditor.ActiveToolDisplayName}" FontWeight="SemiBold" Foreground="#0F172A"/>
                            <TextBlock Text="{Binding StatusMessage}" Foreground="#64748B" FontSize="13"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <Button Content="Показать всё" Command="{Binding CadEditor.FitAllCommand}" Height="32" CornerRadius="8" Padding="12,0"/>
                            <Button Content="Отменить" Command="{Binding CadEditor.UndoCommand}" Height="32" CornerRadius="8" Padding="12,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <cadControls:CadSceneControl Grid.Row="1" Editor="{Binding CadEditor}" ClipToBounds="True"/>
            </Grid>
        </Grid>

        <!-- Статусная строка -->
        <Border Grid.Row="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="16,0">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="20" VerticalAlignment="Center">
                    <TextBlock>
                        <Run Text="X: "/><Run Text="{Binding CadEditor.CursorX, StringFormat={}{0:F1}}"/><Run Text=" мм"/>
                    </TextBlock>
                    <TextBlock>
                        <Run Text="Y: "/><Run Text="{Binding CadEditor.CursorY, StringFormat={}{0:F1}}"/><Run Text=" мм"/>
                    </TextBlock>
                </StackPanel>
                <TextBlock Grid.Column="1" VerticalAlignment="Center" Foreground="#64748B">
                    <Run Text="Масштаб: "/><Run Text="{Binding CadEditor.ZoomPercent}"/>
                </TextBlock>
            </Grid>
        </Border>
    </Grid>
</UserControl>
