<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:NurSapat.App.ViewModels.Structures"
        x:Class="NurSapat.App.Views.Structures.StandardStructureEditWindow"
        x:DataType="vm:StandardStructureEditViewModel"
        Width="520"
        Height="360"
        WindowStartupLocation="CenterOwner"
        WindowDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        Background="Transparent"
        FontFamily="Inter">

    <Window.Styles>
        <StyleInclude Source="/Styles/MaterialsDictionaryStyles.axaml"/>
    </Window.Styles>

    <Border Classes="mat-shell" Margin="12">
        <Grid RowDefinitions="40,*,Auto">
            <Border Grid.Row="0" Classes="mat-titlebar" PointerPressed="OnTitleBarPointerPressed">
                <TextBlock Classes="mat-titlebar-text" Text="{Binding WindowTitle}" Margin="16,0,0,0"/>
            </Border>
            <StackPanel Grid.Row="1" Margin="12" Spacing="12">
                <Border Classes="mat-card" Padding="12">
                    <Grid RowDefinitions="Auto,Auto" RowSpacing="10" ColumnDefinitions="110,*" ColumnSpacing="10">
                        <TextBlock Text="Наименование" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" Text="{Binding Name}"/>
                        <TextBlock Grid.Row="1" Text="Группа" VerticalAlignment="Center"/>
                        <ComboBox Grid.Row="1" Grid.Column="1"
                                  ItemsSource="{Binding Groups}"
                                  SelectedItem="{Binding SelectedGroup}"
                                  DisplayMemberBinding="{Binding Name}"/>
                    </Grid>
                </Border>
                <TextBlock Text="{Binding GeometryNotice}" TextWrapping="Wrap" Foreground="#64748B" FontSize="12"/>
            </StackPanel>
            <Border Grid.Row="2" Padding="16" Background="#F8FAFC" CornerRadius="0,0,12,12">
                <Grid ColumnDefinitions="*,Auto,Auto">
                    <Button Grid.Column="1" Classes="mat-toolbar" Margin="0,0,8,0" Content="Отмена"
                            Command="{Binding CancelCommand}"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                    <Button Grid.Column="2" Classes="mat-primary" Content="ОК"
                            Command="{Binding SaveCommand}"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
