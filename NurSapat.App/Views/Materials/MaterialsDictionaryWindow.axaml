<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:NurSapat.App.ViewModels.Materials"
        xmlns:dg="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls.DataGrid"
        xmlns:models="clr-namespace:NurSapat.App.Models.Materials"
        x:Class="NurSapat.App.Views.Materials.MaterialsDictionaryWindow"
        x:DataType="vm:MaterialsDictionaryViewModel"
        Width="1180"
        Height="760"
        MinWidth="960"
        MinHeight="600"
        WindowStartupLocation="CenterOwner"
        WindowDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="-1"
        Background="Transparent"
        FontFamily="Inter">

    <Window.Styles>
        <StyleInclude Source="/Styles/MaterialsDictionaryStyles.axaml"/>
    </Window.Styles>

    <Border Classes="mat-shell" Margin="12">
        <Grid RowDefinitions="40,Auto,*,Auto">
            <Border Grid.Row="0"
                    Classes="mat-titlebar"
                    PointerPressed="OnTitleBarPointerPressed">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Orientation="Horizontal"
                                Spacing="8"
                                VerticalAlignment="Center"
                                Margin="16,0,0,0">
                        <Image Source="/Assets/logo.ico" Width="16" Height="16" VerticalAlignment="Center"/>
                        <TextBlock Classes="mat-titlebar-text" Text="{Binding Title}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="0,0,8,0">
                        <Button Classes="mat-chrome-btn" Click="OnMinimizeClick" Content="—"/>
                        <Button Classes="mat-chrome-btn" Click="OnMaximizeClick" Content="▢"/>
                        <Button Classes="mat-chrome-btn close" Click="OnCloseClick" Content="✕"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1"
                    Margin="12,12,12,0"
                    Padding="0,0,0,10"
                    Background="White">
                <Grid ColumnDefinitions="*,220,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="10">
                    <TextBox Grid.Column="0"
                             PlaceholderText="Поиск: сначала артикул, затем наименование..."
                             Text="{Binding SearchText}"
                             MinHeight="36"
                             VerticalContentAlignment="Center"/>
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding ManufacturersFilter}"
                              SelectedItem="{Binding SelectedManufacturer}"
                              MinHeight="36"
                              VerticalContentAlignment="Center"/>
                    <Button Grid.Column="2" Classes="mat-primary" Content="Добавить" Command="{Binding AddCommand}"/>
                    <Button Grid.Column="3" Classes="mat-toolbar" Content="По образцу" Command="{Binding AddAsCopyCommand}"/>
                    <Button Grid.Column="4" Classes="mat-toolbar" Content="Excel" Command="{Binding ExportToExcelCommand}"/>
                    <Button Grid.Column="5" Classes="mat-toolbar" Content="TXT" Command="{Binding ExportToTxtCommand}"/>
                    <Button Grid.Column="6" Classes="mat-toolbar" Content="Редактировать" Command="{Binding EditCommand}"/>
                </Grid>
            </Border>

            <dg:DataGrid Grid.Row="2"
                         x:Name="MaterialsGrid"
                         Margin="12,0,12,0"
                         ItemsSource="{Binding FilteredItems}"
                         SelectedItem="{Binding SelectedItem}"
                         AutoGenerateColumns="False"
                         CanUserReorderColumns="False"
                         CanUserResizeColumns="True"
                         CanUserSortColumns="True"
                         GridLinesVisibility="Horizontal"
                         BorderBrush="#E2E8F0"
                         BorderThickness="1"
                         DoubleTapped="OnGridDoubleTapped">
                <dg:DataGrid.Columns>
                    <dg:DataGridTextColumn Header="Артикул" Binding="{Binding Article}" Width="130"/>
                    <dg:DataGridTextColumn Header="Наименование" Binding="{Binding Name}" Width="2*"/>
                    <dg:DataGridTextColumn Header="Раздел" Binding="{Binding SectionDisplay}" Width="160"/>
                    <dg:DataGridTextColumn Header="Производитель" Binding="{Binding Manufacturer}" Width="140"/>
                    <dg:DataGridTextColumn Header="Ед. изм." Binding="{Binding UnitDisplay}" Width="90"/>
                    <dg:DataGridTextColumn Header="Валюта" Binding="{Binding CurrencyDisplay}" Width="80"/>
                    <dg:DataGridTextColumn Header="Цена" Binding="{Binding PriceDisplay}" Width="120"/>
                    <dg:DataGridTextColumn Header="Отход, %" Binding="{Binding WastePercent}" Width="90"/>
                </dg:DataGrid.Columns>
            </dg:DataGrid>

            <Border Grid.Row="3" Padding="16" Background="#F8FAFC" CornerRadius="0,0,12,12">
                <Grid ColumnDefinitions="*,Auto,Auto">
                    <TextBlock VerticalAlignment="Center" Foreground="#64748B"
                               Text="{Binding FilteredItems.Count, StringFormat=Показано позиций: {0}}"/>
                    <Button Grid.Column="1" Classes="mat-toolbar" Margin="0,0,8,0"
                            Content="Удалить" Command="{Binding DeleteCommand}"/>
                    <Button Grid.Column="2" Classes="mat-primary"
                            Content="Редактировать" Command="{Binding EditCommand}"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
