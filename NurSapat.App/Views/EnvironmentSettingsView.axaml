<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:NurSapat.App.ViewModels"
             x:Class="NurSapat.App.Views.EnvironmentSettingsView"
             x:DataType="vm:EnvironmentPathsViewModel">
	<Grid Background="{StaticResource SurfaceBrush}">
		<Border Background="{StaticResource BackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="28"
                Margin="24"
                VerticalAlignment="Top"
                MaxWidth="860"
                HorizontalAlignment="Left">
			<StackPanel Spacing="18">
				<TextBlock Text="Настройка окружения и папок БД"
                           FontSize="26"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}"/>
				<TextBlock Text="Каталоги создаются при старте приложения и используются для базы, документов, эскизов и журналов."
                           Foreground="{StaticResource SecondaryTextBrush}"
                           TextWrapping="Wrap"/>
				<Grid ColumnDefinitions="210,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="12" ColumnSpacing="18">
					<TextBlock Text="База данных" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
					<TextBox Grid.Column="1" Text="{Binding DbPath}" IsReadOnly="True"/>
					<TextBlock Grid.Row="1" Text="Документы" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
					<TextBox Grid.Row="1" Grid.Column="1" Text="{Binding DocumentsPath}" IsReadOnly="True"/>
					<TextBlock Grid.Row="2" Text="Эскизы" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
					<TextBox Grid.Row="2" Grid.Column="1" Text="{Binding SketchesPath}" IsReadOnly="True"/>
					<TextBlock Grid.Row="3" Text="Логи" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
					<TextBox Grid.Row="3" Grid.Column="1" Text="{Binding LogsPath}" IsReadOnly="True"/>
				</Grid>
			</StackPanel>
		</Border>
	</Grid>
</UserControl>
