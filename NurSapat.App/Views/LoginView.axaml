<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:NurSapat.App.ViewModels"
             x:Class="NurSapat.App.Views.LoginView"
             x:DataType="vm:LoginViewModel">
    <Grid RowDefinitions="*,56" Background="White">
        <Grid Grid.Row="0" ColumnDefinitions="*,*">
            <Grid Grid.Column="0">
                <Image Source="avares://NurSapat.App/Assets/login-bg.png" Stretch="UniformToFill"/>
                <Border Background="#660B1220"/>
                <Grid RowDefinitions="*,Auto,*">
                    <StackPanel Grid.Row="1" Margin="54" Spacing="18" MaxWidth="460">
                        <TextBlock Text="NurSapat" Foreground="White" FontSize="40" FontWeight="Bold"/>
                        <TextBlock Text="ERP/CAD для оконного производства" Foreground="White" FontSize="16" FontWeight="SemiBold"/>
                        <Border Height="3" Width="52" Background="#3B82F6" HorizontalAlignment="Left"/>
                        <TextBlock Text="Единая система расчетов, заказов, материалов и производственного архива в одном рабочем пространстве."
                                   Foreground="#E5EEF9" FontSize="14" LineHeight="22" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </Grid>

            <Grid Grid.Column="1">
                <Border Width="440" HorizontalAlignment="Center" VerticalAlignment="Center" Background="White" CornerRadius="12" Padding="32">
                    <StackPanel Spacing="16">
                        <TextBlock Text="Вход в систему" FontSize="28" FontWeight="SemiBold" Foreground="#0F172A"/>
                        <TextBlock Text="Введите учетные данные для доступа к системе." Foreground="#64748B" FontSize="14" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="#D93025" TextWrapping="Wrap" FontSize="13" IsVisible="{Binding !!ErrorMessage}"/>

                        <StackPanel Spacing="6">
                            <TextBlock Text="Логин" Foreground="#334155" FontWeight="SemiBold" FontSize="13"/>
                            <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Height="48" Padding="14,0">
                                <Grid ColumnDefinitions="Auto,*">
                                    <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" Foreground="#94A3B8" FontSize="18" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <TextBox Grid.Column="1" Text="{Binding Username}" PlaceholderText="Введите логин" Background="Transparent" BorderThickness="0" FontSize="14" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Text="Пароль" Foreground="#334155" FontWeight="SemiBold" FontSize="13"/>
                            <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Height="48" Padding="14,0">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" Foreground="#94A3B8" FontSize="18" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <TextBox Grid.Column="1" Text="{Binding Password}" PasswordChar="{Binding PasswordChar}" PlaceholderText="Введите пароль" Background="Transparent" BorderThickness="0" FontSize="14" VerticalAlignment="Center"/>
                                    <Button Grid.Column="2" Command="{Binding TogglePasswordVisibilityCommand}" Width="32" Height="32" Padding="0" Background="Transparent" BorderBrush="Transparent" ToolTip.Tip="Показать пароль">
                                        <TextBlock Text="&#xE890;" FontFamily="Segoe MDL2 Assets" Foreground="#64748B" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Button>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,8">
                            <CheckBox Content="Запомнить меня" IsChecked="{Binding RememberMe}" Foreground="#475569" FontSize="13"/>
                            <Button Grid.Column="1" Command="{Binding HelpCommand}" Background="Transparent" BorderBrush="Transparent" Padding="0" Content="Забыли пароль?" Foreground="#2563EB" FontSize="13"/>
                        </Grid>

                        <Button Command="{Binding LoginCommand}" IsEnabled="{Binding !IsBusy}" HorizontalAlignment="Stretch" Height="54" CornerRadius="10" Background="#2563EB" Foreground="White" FontSize="16" FontWeight="Bold" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Content="Войти"/>
                        <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" Height="3" Background="#E2E8F0" CornerRadius="2"/>

                        <Grid ColumnDefinitions="*,Auto,*" Margin="0,14,0,0">
                            <Border Grid.Column="0" Height="1" Background="#E2E8F0" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="16,0">
                                <TextBlock Text="&#xE83D;" FontFamily="Segoe MDL2 Assets" Foreground="#94A3B8" FontSize="17"/>
                                <TextBlock Text="Безопасное подключение" Foreground="#94A3B8" FontSize="13"/>
                            </StackPanel>
                            <Border Grid.Column="2" Height="1" Background="#E2E8F0" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="1" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Background="White">
            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center" Height="56">
                <Button Command="{Binding HelpCommand}" Background="Transparent" BorderBrush="Transparent" HorizontalAlignment="Left" Margin="36,0" Padding="0">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="&#xE897;" FontFamily="Segoe MDL2 Assets" Foreground="#2563EB" FontSize="18"/>
                        <TextBlock Text="Нужна помощь?" Foreground="#2563EB" FontWeight="SemiBold" FontSize="14"/>
                        <TextBlock Text="Свяжитесь с администратором системы." Foreground="#64748B" FontSize="14"/>
                    </StackPanel>
                </Button>
                <Button Grid.Column="1" Command="{Binding ContactCommand}" Background="Transparent" BorderBrush="Transparent" Margin="0,0,36,0" Padding="0">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="&#xE715;" FontFamily="Segoe MDL2 Assets" Foreground="#64748B" FontSize="18"/>
                        <TextBlock Text="Связаться с нами" Foreground="#64748B" FontSize="14" FontWeight="Medium"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>
