<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:NurSapat.App.ViewModels"
             x:Class="NurSapat.App.Views.LoginView"
             x:DataType="vm:LoginViewModel">
	<Grid ColumnDefinitions="*,*" Background="{StaticResource BackgroundBrush}">
		<Border Grid.Column="0">
			<Border.Background>
				<LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
					<GradientStop Color="#FF2563EB" Offset="0"/>
					<GradientStop Color="#FF0EA5E9" Offset="0.55"/>
					<GradientStop Color="#FF14B8A6" Offset="1"/>
				</LinearGradientBrush>
			</Border.Background>
			<Grid Margin="34">
				<StackPanel VerticalAlignment="Center" Spacing="18">
					<Border Width="108" Height="108" CornerRadius="16"
                            BorderBrush="#88FFFFFF" BorderThickness="2"
                            HorizontalAlignment="Left">
						<Grid Margin="18" RowDefinitions="*,*,*" ColumnDefinitions="*,*">
							<Border Grid.RowSpan="3" Grid.ColumnSpan="2" BorderBrush="White" BorderThickness="3"/>
							<Border Grid.Column="0" Grid.RowSpan="3" BorderBrush="White" BorderThickness="0,0,1.5,0"/>
							<Border Grid.Row="0" Grid.ColumnSpan="2" BorderBrush="White" BorderThickness="0,0,0,1.5"/>
							<Border Grid.Row="1" Grid.ColumnSpan="2" BorderBrush="White" BorderThickness="0,0,0,1.5"/>
						</Grid>
					</Border>
					<TextBlock Text="NurSapat"
                               Foreground="White"
                               FontSize="34"
                               FontWeight="SemiBold"/>
					<TextBlock Text="ERP/CAD для оконного производства"
                               Foreground="#E0F2FE"
                               FontSize="16"
                               TextWrapping="Wrap"/>
					<TextBlock Text="Расчеты, заказы, материалы и производственный архив в одном рабочем пространстве."
                               Foreground="#CCFFFFFF"
                               FontSize="13"
                               LineHeight="20"
                               TextWrapping="Wrap"/>
				</StackPanel>
			</Grid>
		</Border>

		<Border Grid.Column="1" Background="{StaticResource BackgroundBrush}">
			<StackPanel Margin="46,44" Spacing="16" VerticalAlignment="Center">
				<TextBlock Text="Вход в систему"
                           FontSize="26"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}"/>
				<TextBlock Text="Введите учетные данные оператора."
                           Foreground="{StaticResource SecondaryTextBrush}"
                           FontSize="13"/>
				<TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{StaticResource ErrorBrush}"
                           TextWrapping="Wrap"
                           IsVisible="{Binding !!ErrorMessage}"/>
				<StackPanel Spacing="6">
					<TextBlock Text="Логин" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold"/>
					<TextBox Text="{Binding Username}" PlaceholderText="123"/>
				</StackPanel>
				<StackPanel Spacing="6">
					<TextBlock Text="Пароль" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold"/>
					<TextBox Text="{Binding Password}" PasswordChar="*" PlaceholderText="123"/>
				</StackPanel>
				<Button Content="Войти"
                        Classes="Primary"
                        Command="{Binding LoginCommand}"
                        IsEnabled="{Binding !IsBusy}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"/>
				<ProgressBar IsIndeterminate="True"
                             IsVisible="{Binding IsBusy}"
                             Height="4"/>
			</StackPanel>
		</Border>
	</Grid>
</UserControl>
