<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:NurSapat.App.ViewModels"
             x:Class="NurSapat.App.Views.LoginView"
             x:DataType="vm:LoginViewModel">

	<!-- Убираем белый фон с корневого Grid -->
	<Grid RowDefinitions="*, 56">

		<!-- ===== ВЕРХНЯЯ ЧАСТЬ ===== -->
		<Grid Grid.Row="0" ColumnDefinitions="0.5*, 0.5*">

			<!-- ЛЕВАЯ ПАНЕЛЬ -->
			<Grid Grid.Column="0">
				<!-- Фотография на всю левую панель -->
				<Image Source="avares://NurSapat.App/Assets/login-bg.png"
					   Stretch="UniformToFill" />

				<!-- Контент поверх фото, выровненный по центру -->
				<Grid RowDefinitions="*, Auto, *">
					<Grid Grid.Row="1" Margin="48,20,48,20" RowDefinitions="Auto, *, Auto">
						<StackPanel Grid.Row="0" Spacing="16">
							<!-- Логотип убран -->
							<StackPanel Spacing="4">
								<TextBlock Text="NurSapat" Foreground="White" FontSize="38" FontWeight="Bold" LetterSpacing="-1"/>
								<TextBlock Text="ERP/CAD для оконного производства" Foreground="White" FontSize="15" FontWeight="Medium"/>
							</StackPanel>

							<Border Height="3" Width="48" Background="#3B82F6" HorizontalAlignment="Left"/>

							<TextBlock Text="Единая система расчетов, заказов, материалов и производственного архива — в одном рабочем пространстве."
									   Foreground="White" FontSize="14" LineHeight="22" TextWrapping="Wrap" MaxWidth="400"/>
						</StackPanel>

						<Grid Grid.Row="1" Margin="0,20,0,20"/>

						<Grid Grid.Row="2" ColumnDefinitions="*,*,*" ColumnSpacing="12" Margin="0,0,0,20">
							<StackPanel Grid.Column="0" Spacing="10">
								<Path Data="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-2 14H7v-2h10v2zm0-4H7v-2h10v2zm0-4H7V7h10v2z"
									  Fill="White" Width="26" Height="26"/>
								<TextBlock Text="Точные расчеты" Foreground="White" FontWeight="SemiBold" FontSize="13" TextAlignment="Center"/>
								<TextBlock Text="Быстрые и надежные расчеты" Foreground="#CBD5E1" FontSize="11" TextWrapping="Wrap" TextAlignment="Center"/>
							</StackPanel>

							<StackPanel Grid.Column="1" Spacing="10">
								<Path Data="M14 2H6c-1.1 0-1.99.9-1.99 2L4 20c0 1.1.89 2 1.99 2H18c1.1 0 2-.9 2-2V8l-6-6zm2 16H8v-2h8v2zm0-4H8v-2h8v2zm-3-5V3.5L18.5 9H13z"
									  Fill="White" Width="26" Height="26"/>
								<TextBlock Text="Заказы и проекты" Foreground="White" FontWeight="SemiBold" FontSize="13" TextAlignment="Center"/>
								<TextBlock Text="Управление заказами" Foreground="#CBD5E1" FontSize="11" TextWrapping="Wrap" TextAlignment="Center"/>
							</StackPanel>

							<StackPanel Grid.Column="2" Spacing="10">
								<Path Data="M20.54 5.23l-1.39-1.68C18.88 3.21 18.46 3 18 3H6c-.46 0-.88.21-1.16.55L3.46 5.23C3.17 5.57 3 6.02 3 6.5V19c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V6.5c0-.48-.17-.93-.46-1.27zM12 17.5L6.5 12H10v-2h4v2h3.5L12 17.5z"
									  Fill="White" Width="26" Height="26"/>
								<TextBlock Text="Материалы и архив" Foreground="White" FontWeight="SemiBold" FontSize="13" TextAlignment="Center"/>
								<TextBlock Text="Материалы, цены и архив" Foreground="#CBD5E1" FontSize="11" TextWrapping="Wrap" TextAlignment="Center"/>
							</StackPanel>
						</Grid>
					</Grid>
				</Grid>
			</Grid>

			<!-- ПРАВАЯ ПАНЕЛЬ (Форма входа) -->
			<Border Grid.Column="1" Background="Transparent">
				<Grid>
					<Border Width="440" HorizontalAlignment="Center" VerticalAlignment="Center" Background="White" CornerRadius="12" Padding="32">
						<StackPanel Spacing="16">

							<TextBlock Text="Вход в систему" FontSize="28" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,0,0,8"/>
							<TextBlock Text="Введите учетные данные для доступа к системе." Foreground="#64748B" FontSize="14" TextWrapping="Wrap"/>

							<TextBlock Text="{Binding ErrorMessage}" Foreground="#EF4444" TextWrapping="Wrap" FontSize="13" IsVisible="{Binding !!ErrorMessage}"/>

							<StackPanel Spacing="6">
								<TextBlock Text="Логин" Foreground="#334155" FontWeight="SemiBold" FontSize="13"/>
								<Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Height="48" Padding="14,0">
									<Grid ColumnDefinitions="Auto,*">
										<Path Data="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"
                                              Fill="#94A3B8" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,12,0"/>
										<TextBox Grid.Column="1" Text="{Binding Username}" PlaceholderText="Введите логин"
                                                 Background="Transparent" BorderThickness="0" FontSize="14" VerticalAlignment="Center"/>
									</Grid>
								</Border>
							</StackPanel>

							<StackPanel Spacing="6">
								<TextBlock Text="Пароль" Foreground="#334155" FontWeight="SemiBold" FontSize="13"/>
								<Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Height="48" Padding="14,0">
									<Grid ColumnDefinitions="Auto,*,Auto">
										<Path Data="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-9 0V6c0-1.66 1.34-3 3-3s3 1.34 3 3v2H9zm6 8c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2z"
                                              Fill="#94A3B8" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,12,0"/>
										<TextBox Grid.Column="1" Text="{Binding Password}" PasswordChar="•" PlaceholderText="Введите пароль"
                                                 Background="Transparent" BorderThickness="0" FontSize="14" VerticalAlignment="Center"/>
										<Path Grid.Column="2" Data="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zM12 9c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"
                                              Fill="#94A3B8" Width="20" Height="20" VerticalAlignment="Center" Margin="12,0,0,0" Cursor="Hand"/>
									</Grid>
								</Border>
							</StackPanel>

							<Grid ColumnDefinitions="*,Auto" Margin="0,4,0,8">
								<CheckBox Content="Запомнить меня" Foreground="#475569" FontSize="13"/>
								<TextBlock Grid.Column="1" Text="Забыли пароль?" Foreground="#2563EB" FontSize="13" VerticalAlignment="Center" Cursor="Hand"/>
							</Grid>

							<!-- Кнопка Войти: увеличена, строго по центру -->
							<Button Command="{Binding LoginCommand}" IsEnabled="{Binding !IsBusy}"
									HorizontalAlignment="Stretch" Height="56" CornerRadius="10"
									Background="#2563EB" Foreground="White" FontSize="16" FontWeight="Bold"
									HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
								<Button.Content>Войти</Button.Content>
								<Button.Styles>
									<Style Selector="Button:pointerover /template/ ContentPresenter">
										<Setter Property="Background" Value="#1D4ED8"/>
									</Style>
								</Button.Styles>
							</Button>

							<ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" Height="3" Background="#E2E8F0" CornerRadius="2"/>

							<Grid ColumnDefinitions="*,Auto,*" VerticalAlignment="Center" Margin="0,16,0,0">
								<Border Grid.Column="0" Height="1" Background="#E2E8F0" VerticalAlignment="Center"/>
								<StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="16,0">
									<Path Data="M12 2L4 5v6c0 5.55 3.84 10.74 8 12 4.16-1.26 8-6.45 8-12V5l-8-3z"
										Fill="#94A3B8"
										Width="20"
										Height="20"
										VerticalAlignment="Center"
										Margin="0,0,1,0"
										Stretch="Uniform"/>
									<TextBlock Text="Безопасное подключение" Foreground="#94A3B8" FontSize="13" VerticalAlignment="Center"/>
								</StackPanel>
								<Border Grid.Column="2" Height="1" Background="#E2E8F0" VerticalAlignment="Center"/>
							</Grid>
						</StackPanel>
					</Border>
				</Grid>
			</Border>
		</Grid>

		<!-- ===== НИЖНЯЯ ПАНЕЛЬ (ФУТЕР) ===== -->
		<Border Grid.Row="1" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Background="White" Padding="0,0">
			<Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center" Height="56">
				<StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center" Margin="40,0,0,0">
					<Path Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 16h-2v-2h2v2zm1.07-7.75l-.9.92C12.45 11.9 12 12.5 12 14h-2v-.5c0-1.1.45-2.1 1.17-2.83l1.24-1.26c.37-.36.59-.86.59-1.41 0-1.1-.9-2-2-2s-2 .9-2 2H7c0-2.76 2.24-5 5-5s5 2.24 5 5c0 1.04-.42 1.99-1.07 2.75z"
                          Fill="#2563EB" Width="20" Height="20" VerticalAlignment="Center"/>
					<TextBlock Text="Нужна помощь?" Foreground="#2563EB" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
					<TextBlock Text="Свяжитесь с администратором системы." Foreground="#64748B" FontSize="14" VerticalAlignment="Center"/>
				</StackPanel>

				<StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" Cursor="Hand" VerticalAlignment="Center" Margin="0,0,40,0">
					<Path Data="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"
                          Fill="#64748B" Width="20" Height="20" VerticalAlignment="Center"/>
					<TextBlock Text="Связаться с нами" Foreground="#64748B" FontSize="14" FontWeight="Medium" VerticalAlignment="Center"/>
				</StackPanel>
			</Grid>
		</Border>
	</Grid>
</UserControl>
