<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:NurSapat.App.ViewModels"
             x:Class="NurSapat.App.Views.LoginView"
             x:DataType="vm:LoginViewModel">
    <ScrollViewer Focusable="False"
                  HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                  VerticalAlignment="Center">
        <StackPanel Classes="auth-form">
            <StackPanel Classes="auth-heading">
                <TextBlock Text="С возвращением" Classes="auth-title auth-text"/>
                <TextBlock Text="Войдите в NurSapat, чтобы продолжить" Classes="auth-muted" FontSize="17"/>
            </StackPanel>

            <StackPanel Classes="auth-field-group" Margin="0,0,0,7">
                <TextBlock x:Name="UsernameLabel" Text="Логин" Classes="auth-label"/>
                <Border Classes="auth-input" Classes.invalid="{Binding HasUsernameError}">
                    <TextBox x:Name="UsernameField" Classes="auth-field" Text="{Binding Username}"
                             PlaceholderText="Введите логин" IsReadOnly="{Binding IsBusy}"
                             AutomationProperties.LabeledBy="{Binding #UsernameLabel}"/>
                </Border>
                <TextBlock Classes="auth-error" Classes.shown="{Binding HasUsernameError}"
                           Text="{Binding UsernameError}"/>
            </StackPanel>

            <StackPanel Classes="auth-field-group">
                <TextBlock x:Name="PasswordLabel" Text="Пароль" Classes="auth-label"/>
                <Border Classes="auth-input" Classes.invalid="{Binding HasPasswordError}">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBox x:Name="PasswordField" Classes="auth-field" Text="{Binding Password}"
                                 PasswordChar="*" RevealPassword="{Binding IsPasswordVisible}"
                                 PlaceholderText="Введите пароль" IsReadOnly="{Binding IsBusy}"
                                 AutomationProperties.LabeledBy="{Binding #PasswordLabel}"/>
                        <Button x:Name="PasswordToggle" Grid.Column="1" Classes="auth-icon password-toggle"
                                Classes.revealed="{Binding IsPasswordVisible}"
                                Command="{Binding TogglePasswordVisibilityCommand}"
                                ToolTip.Tip="{Binding PasswordVisibilityLabel}"
                                AutomationProperties.Name="{Binding PasswordVisibilityLabel}"
                                VerticalAlignment="Center" Margin="0,0,7,0">
                            <Panel>
                                <PathIcon Classes="password-glyph eye" Data="{StaticResource eye_regular}"/>
                                <PathIcon Classes="password-glyph eye-off" Data="{StaticResource eye_off_regular}"/>
                            </Panel>
                        </Button>
                    </Grid>
                </Border>
                <TextBlock Classes="auth-error" Classes.shown="{Binding HasPasswordError}"
                           Text="{Binding PasswordError}"/>
            </StackPanel>

            <Grid ColumnDefinitions="*,Auto" Margin="0,2,0,3">
                <CheckBox Classes="auth-remember" Content="Запомнить меня"
                          IsChecked="{Binding RememberMe}" IsEnabled="{Binding !IsBusy}"/>
                <Button Grid.Column="1" Classes="auth-link" Command="{Binding HelpCommand}">
                    <TextBlock Text="Забыли пароль?"/>
                </Button>
            </Grid>

            <TextBlock Classes="auth-error" Classes.shown="{Binding HasFormError}" Text="{Binding ErrorMessage}"/>
            <Button Classes="auth-primary" Classes.error="{Binding HasError}" Classes.loading="{Binding IsBusy}"
                    Content="{Binding LoginButtonLabel}" Command="{Binding LoginCommand}" IsDefault="True"/>

            <StackPanel Spacing="12" Margin="0,5">
                <WrapPanel HorizontalAlignment="Center">
                    <TextBlock Text="У вас нет аккаунта?" Classes="auth-muted" FontSize="14"
                               VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <Button Theme="{StaticResource AuthTextLink}" Classes="AuthTextLink"
                            Command="{Binding GoToRegisterCommand}"
                            VerticalAlignment="Center">
                        <TextBlock Text="Зарегистрироваться"/>
                    </Button>
                </WrapPanel>
                <Button x:Name="ContactButton" Theme="{StaticResource AuthTextLink}" Classes="AuthTextLink muted"
                        Click="OnContactClick"
                        HorizontalAlignment="Center">
                    <TextBlock Text="Связаться с поддержкой"/>
                </Button>
            </StackPanel>

            <Border Classes="auth-divider"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,-6,0,0">
                <Ellipse Classes="auth-status" Classes.online="{Binding HasGoodConnection}"
                         Classes.slow="{Binding HasSlowConnection}" Classes.offline="{Binding IsServerOffline}"
                         VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Text="{Binding NetworkStatusDisplay}" Classes="auth-muted"
                           FontSize="14" VerticalAlignment="Center" MaxWidth="200"/>
                <!-- Include only the 19 px glyph in the visual centering of the status. -->
                <Button Classes="auth-icon" Classes.refreshing="{Binding IsRefreshingNetwork}"
                        Width="35" Margin="6,0,-8,0"
                        Command="{Binding RefreshNetworkStatusCommand}"
                        ToolTip.Tip="Проверить подключение к серверу"
                        AutomationProperties.Name="Проверить подключение к серверу">
                    <PathIcon Data="{StaticResource arrow_sync_regular}"/>
                </Button>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
