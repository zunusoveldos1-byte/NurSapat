<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:NurSapat.App.ViewModels"
             xmlns:models="clr-namespace:NurSapat.Core.Models;assembly=NurSapat.Core"
             x:Class="NurSapat.App.Views.MaterialsView"
             x:DataType="vm:MaterialsViewModel">

    <Grid RowDefinitions="Auto,*,Auto" Margin="12">
        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
            <Button Command="{Binding AddMaterialCommand}" Content="+ Добавить" />
            <Button Command="{Binding DeleteSelectedCommand}" Content="Удалить" />
        </StackPanel>

        <Border Grid.Row="1" BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="4">
            <ScrollViewer>
                <ItemsControl ItemsSource="{Binding Materials}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="4">
                                <Grid ColumnDefinitions="150,*,150,80,120">
                                    <TextBlock Text="{Binding Article}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" />
                                    <TextBlock Grid.Column="2" Text="{Binding Category}" />
                                    <TextBlock Grid.Column="3" Text="{Binding UnitOfMeasure}" />
                                    <TextBlock Grid.Column="4" Text="{Binding Price, StringFormat='{}{0:F2}'}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>