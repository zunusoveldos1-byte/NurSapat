<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:NurSapat.App.ViewModels"
        x:Class="NurSapat.App.Views.MessagesWindow"
        x:DataType="vm:MessagesViewModel"
        Width="720"
        Height="520"
        MinWidth="560"
        MinHeight="400"
        WindowStartupLocation="CenterOwner"
        WindowDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="-1"
        Background="Transparent"
        FontFamily="Inter">

    <Window.Styles>
        <StyleInclude Source="/Styles/MaterialsDictionaryStyles.axaml"/>
    </Window.Styles>

    <Border Classes="mat-shell" Margin="12">
        <Grid RowDefinitions="32,*,Auto">
            <Border Grid.Row="0"
                    Classes="mat-titlebar"
                    PointerPressed="OnTitleBarPointerPressed">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Orientation="Horizontal"
                                Spacing="8"
                                VerticalAlignment="Center"
                                Margin="16,0,0,0">
                        <Image Source="/Assets/logo.ico" Width="16" Height="16" VerticalAlignment="Center"/>
                        <TextBlock Classes="mat-titlebar-text" Text="Сообщения"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="0,0,8,0">
                        <Button Classes="mat-chrome-btn"
                                Click="OnMinimizeClick"
                                Content="—"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"/>
                        <Button Classes="mat-chrome-btn"
                                Click="OnMaximizeClick"
                                Content="▢"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"/>
                        <Button Classes="mat-chrome-btn close"
                                Click="OnCloseClick"
                                Content="✕"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="16,12,16,0" RowDefinitions="Auto,*" RowSpacing="12">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <TextBlock Text="Сообщения программы"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="#0F172A"
                               VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="16"
                                VerticalAlignment="Center">
                        <CheckBox Content="Ошибки"
                                  IsChecked="{Binding ShowErrors}"/>
                        <CheckBox Content="Предупреждения"
                                  IsChecked="{Binding ShowWarnings}"/>
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1"
                        CornerRadius="8"
                        ClipToBounds="True">
                    <ListBox ItemsSource="{Binding FilteredMessages}"
                             Background="White"
                             BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:MessageItemViewModel">
                                <Border Padding="12,10"
                                        BorderBrush="#F1F5F9"
                                        BorderThickness="0,0,0,1">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                        <Border Width="10"
                                                Height="10"
                                                CornerRadius="5"
                                                Background="{Binding MarkerBrush}"
                                                VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Text}"
                                                   FontSize="13"
                                                   Foreground="#0F172A"
                                                   TextWrapping="Wrap"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding TimeDisplay}"
                                                   FontSize="12"
                                                   Foreground="#94A3B8"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </Grid>

            <Border Grid.Row="2" Padding="16" Background="#F8FAFC" CornerRadius="0,0,12,12">
                <Button Classes="mat-toolbar"
                        Content="Очистить все"
                        Command="{Binding ClearAllCommand}"
                        HorizontalAlignment="Right"
                        MinHeight="32"
                        Padding="14,0"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"/>
            </Border>
        </Grid>
    </Border>
</Window>
