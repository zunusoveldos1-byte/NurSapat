<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:NurSapat.App.ViewModels"
        x:Class="NurSapat.App.Views.MessagesWindow"
        x:DataType="vm:MessagesViewModel"
        Title="Сообщения"
        Width="720"
        Height="520"
        MinWidth="560"
        MinHeight="400"
        WindowStartupLocation="CenterOwner"
        FontFamily="Inter"
        Background="#F6F9FD">

    <Border Background="White"
            BorderBrush="#E2E8F0"
            BorderThickness="1"
            CornerRadius="10"
            Margin="16"
            Padding="20">
        <Grid RowDefinitions="Auto,*" RowSpacing="16">
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <TextBlock Text="Сообщения программы"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="#0F172A"
                           VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="16"
                            VerticalAlignment="Center">
                    <CheckBox Content="Ошибки"
                              IsChecked="{Binding ShowErrors}"/>
                    <CheckBox Content="Предупреждения"
                              IsChecked="{Binding ShowWarnings}"/>
                    <Button Content="Очистить все"
                            MinHeight="32"
                            Padding="14,0"
                            Command="{Binding ClearAllCommand}"/>
                </StackPanel>
            </Grid>

            <Border Grid.Row="1"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    CornerRadius="8"
                    ClipToBounds="True">
                <ListBox ItemsSource="{Binding FilteredMessages}"
                         Background="White"
                         BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:MessageItemViewModel">
                            <Border Padding="12,10"
                                    BorderBrush="#F1F5F9"
                                    BorderThickness="0,0,0,1">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                    <Border Width="10"
                                            Height="10"
                                            CornerRadius="5"
                                            Background="{Binding MarkerBrush}"
                                            VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Text}"
                                               FontSize="13"
                                               Foreground="#0F172A"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding TimeDisplay}"
                                               FontSize="12"
                                               Foreground="#94A3B8"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </Grid>
    </Border>
</Window>
