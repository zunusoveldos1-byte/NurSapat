<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:NurSapat.App.ViewModels"
             x:Class="NurSapat.App.Views.OrderEditView"
             x:DataType="vm:OrderEditViewModel">

    <Grid Background="#F6F9FD">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
            <TextBlock Text="Лист заказа" FontSize="20" FontWeight="SemiBold" Foreground="#0B1736"/>
            <TextBlock Text="Функционал в разработке" Foreground="#52688F"/>
        </StackPanel>
    </Grid>
    
</UserControl>