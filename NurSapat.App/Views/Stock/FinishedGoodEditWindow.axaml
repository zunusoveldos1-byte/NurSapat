<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:NurSapat.App.ViewModels.Stock"
        xmlns:models="clr-namespace:NurSapat.App.Models.Stock"
        x:Class="NurSapat.App.Views.Stock.FinishedGoodEditWindow"
        x:DataType="vm:FinishedGoodEditViewModel"
        Width="620"
        Height="480"
        MinWidth="540"
        MinHeight="440"
        WindowStartupLocation="CenterOwner"
        WindowDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="-1"
        Background="Transparent"
        FontFamily="Inter">

    <Window.Styles>
        <StyleInclude Source="/Styles/MaterialsDictionaryStyles.axaml"/>
    </Window.Styles>

    <Border Classes="mat-shell" Margin="12">
        <Grid RowDefinitions="32,*,Auto">
            <Border Grid.Row="0"
                    Classes="mat-titlebar"
                    PointerPressed="OnTitleBarPointerPressed">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Classes="mat-titlebar-text"
                               Text="{Binding WindowTitle}"
                               Margin="16,0,0,0"
                               VerticalAlignment="Center"/>
                    <Button Grid.Column="1"
                            Classes="mat-chrome-btn close"
                            Click="OnCloseClick"
                            Content="✕"
                            Margin="0,0,8,0"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"/>
                </Grid>
            </Border>

            <Border Grid.Row="1" Margin="12,0,12,0" Classes="mat-card">
                <Grid ColumnDefinitions="180,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="12">
                    <TextBlock Text="Номер заказа" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Text="{Binding OrderNumber}"/>

                    <TextBlock Grid.Row="1" Text="Код продукции" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ProductCode}"/>

                    <TextBlock Grid.Row="2" Text="Ячейка" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding CellAddress}"/>

                    <TextBlock Grid.Row="3" Text="Состояние" VerticalAlignment="Center"/>
                    <ComboBox Grid.Row="3"
                              Grid.Column="1"
                              ItemsSource="{Binding StateOptions}"
                              SelectedItem="{Binding SelectedStateOption}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate DataType="models:FinishedGoodStateOption">
                                <TextBlock Text="{Binding DisplayName}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBlock Grid.Row="4" Text="Дата" VerticalAlignment="Center"/>
                    <DatePicker Grid.Row="4" Grid.Column="1" SelectedDate="{Binding DateIncoming}"/>

                    <TextBlock Grid.Row="5" Text="Пользователь" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="5"
                             Grid.Column="1"
                             Text="{Binding UserName}"
                             IsReadOnly="True"
                             Background="#F1F5F9"/>

                    <TextBlock Grid.Row="6"
                               Grid.ColumnSpan="2"
                               Text="{Binding ValidationMessage}"
                               Foreground="#DC2626"
                               TextWrapping="Wrap"/>
                </Grid>
            </Border>

            <Border Grid.Row="2" Padding="16" Background="#F8FAFC" CornerRadius="0,0,12,12">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                    <Button Classes="mat-toolbar"
                            Content="Отмена"
                            Command="{Binding CancelCommand}"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"/>
                    <Button Classes="mat-primary"
                            Content="ОК"
                            Command="{Binding SaveCommand}"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
