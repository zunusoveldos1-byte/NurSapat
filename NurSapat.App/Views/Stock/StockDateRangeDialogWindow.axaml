<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:NurSapat.App.ViewModels.Stock"
        x:Class="NurSapat.App.Views.Stock.StockDateRangeDialogWindow"
        x:DataType="vm:StockDateRangeDialogViewModel"
        Width="520"
        Height="420"
        MinWidth="480"
        MinHeight="360"
        WindowStartupLocation="CenterOwner"
        WindowDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="-1"
        Background="Transparent"
        FontFamily="Inter">

    <Window.Styles>
        <StyleInclude Source="/Styles/MaterialsDictionaryStyles.axaml"/>
    </Window.Styles>

    <Border Classes="mat-shell" Margin="12">
        <Grid RowDefinitions="32,*,Auto">
            <Border Grid.Row="0" Classes="mat-titlebar" PointerPressed="OnTitleBarPointerPressed">
                <TextBlock Classes="mat-titlebar-text" Text="{Binding Title}" Margin="16,0,0,0"/>
            </Border>

            <StackPanel Grid.Row="1" Margin="12" Spacing="12">
                <Border Classes="mat-card">
                    <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto" RowSpacing="10">
                        <TextBlock Text="Период с" VerticalAlignment="Center"/>
                        <DatePicker Grid.Column="1" SelectedDate="{Binding Period1Start}"/>
                        <TextBlock Grid.Row="1" Text="Период по" VerticalAlignment="Center"/>
                        <DatePicker Grid.Row="1" Grid.Column="1" SelectedDate="{Binding Period1End}"/>
                    </Grid>
                </Border>

                <Border Classes="mat-card" IsVisible="{Binding IsDualPeriod}">
                    <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto" RowSpacing="10">
                        <TextBlock Text="Сравнить с" VerticalAlignment="Center"/>
                        <DatePicker Grid.Column="1" SelectedDate="{Binding Period2Start}"/>
                        <TextBlock Grid.Row="1" Text="Сравнить по" VerticalAlignment="Center"/>
                        <DatePicker Grid.Row="1" Grid.Column="1" SelectedDate="{Binding Period2End}"/>
                    </Grid>
                </Border>
            </StackPanel>

            <Border Grid.Row="2" Padding="16" Background="#F8FAFC" CornerRadius="0,0,12,12">
                <Grid ColumnDefinitions="*,Auto,Auto">
                    <Button Grid.Column="1" Classes="mat-toolbar" Margin="0,0,8,0"
                            Content="Отмена" Command="{Binding CancelCommand}"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                    <Button Grid.Column="2" Classes="mat-primary"
                            Content="Сформировать" Command="{Binding ConfirmCommand}"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
