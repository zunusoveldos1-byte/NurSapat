<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:NurSapat.App.ViewModels.Stock"
        xmlns:dg="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls.DataGrid"
        x:Class="NurSapat.App.Views.Stock.MaterialPickerWindow"
        x:DataType="vm:MaterialPickerViewModel"
        Width="760"
        Height="560"
        MinWidth="640"
        MinHeight="480"
        WindowStartupLocation="CenterOwner"
        WindowDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="-1"
        Background="Transparent"
        FontFamily="Inter">

    <Window.Styles>
        <StyleInclude Source="/Styles/MaterialsDictionaryStyles.axaml"/>
    </Window.Styles>

    <Border Classes="mat-shell" Margin="12">
        <Grid RowDefinitions="40,Auto,*,Auto">
            <Border Grid.Row="0" Classes="mat-titlebar" PointerPressed="OnTitleBarPointerPressed">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Classes="mat-titlebar-text" Text="{Binding Title}" Margin="16,0,0,0"/>
                    <Button Grid.Column="1" Classes="mat-chrome-btn close" Click="OnCloseClick" Content="✕"
                            Margin="0,0,8,0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                </Grid>
            </Border>

            <TextBox Grid.Row="1" Margin="12,12,12,0" MinHeight="36"
                     PlaceholderText="Поиск по артикулу или наименованию..."
                     Text="{Binding SearchText}"
                     VerticalContentAlignment="Center"/>

            <dg:DataGrid Grid.Row="2" Margin="12,10,12,0"
                         ItemsSource="{Binding FilteredMaterials}"
                         SelectedItem="{Binding SelectedMaterial}"
                         AutoGenerateColumns="False"
                         IsReadOnly="True"
                         CanUserSortColumns="True"
                         GridLinesVisibility="Horizontal"
                         BorderBrush="#E2E8F0"
                         BorderThickness="1"
                         DoubleTapped="OnGridDoubleTapped">
                <dg:DataGrid.Columns>
                    <dg:DataGridTextColumn Header="Артикул" Binding="{Binding Article}" Width="130"/>
                    <dg:DataGridTextColumn Header="Наименование" Binding="{Binding Name}" Width="2*"/>
                    <dg:DataGridTextColumn Header="Производитель" Binding="{Binding Manufacturer}" Width="140"/>
                </dg:DataGrid.Columns>
            </dg:DataGrid>

            <Border Grid.Row="3" Padding="16" Background="#F8FAFC" CornerRadius="0,0,12,12">
                <Grid ColumnDefinitions="*,Auto,Auto">
                    <TextBlock VerticalAlignment="Center" Foreground="#64748B"
                               Text="{Binding FilteredMaterials.Count, StringFormat=Найдено: {0}}"/>
                    <Button Grid.Column="1" Classes="mat-toolbar" Margin="0,0,8,0"
                            Content="Отмена" Command="{Binding CancelCommand}"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                    <Button Grid.Column="2" Classes="mat-primary"
                            Content="Выбрать" Command="{Binding ConfirmCommand}"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
