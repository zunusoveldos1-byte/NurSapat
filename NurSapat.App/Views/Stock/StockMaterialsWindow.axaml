<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:NurSapat.App.ViewModels.Stock"
        xmlns:dg="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls.DataGrid"
        x:Class="NurSapat.App.Views.Stock.StockMaterialsWindow"
        x:DataType="vm:StockMaterialsViewModel"
        Width="1320"
        Height="780"
        MinWidth="1080"
        MinHeight="640"
        WindowStartupLocation="CenterOwner"
        WindowDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="-1"
        Background="Transparent"
        FontFamily="Inter">

    <Window.Styles>
        <StyleInclude Source="/Styles/MaterialsDictionaryStyles.axaml"/>
    </Window.Styles>

    <Border Classes="mat-shell" Margin="12">
        <Grid RowDefinitions="40,Auto,*,Auto">
            <Border Grid.Row="0"
                    Classes="mat-titlebar"
                    PointerPressed="OnTitleBarPointerPressed">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Orientation="Horizontal"
                                Spacing="8"
                                VerticalAlignment="Center"
                                Margin="16,0,0,0">
                        <Image Source="/Assets/logo.ico" Width="16" Height="16" VerticalAlignment="Center"/>
                        <TextBlock Classes="mat-titlebar-text" Text="{Binding Title}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="0,0,8,0">
                        <Button Classes="mat-chrome-btn" Click="OnMinimizeClick" Content="—"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                        <Button Classes="mat-chrome-btn" Click="OnMaximizeClick" Content="▢"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                        <Button Classes="mat-chrome-btn close" Click="OnCloseClick" Content="✕"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1" Margin="12,12,12,0" Padding="0,0,0,10" Background="White">
                <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,*" ColumnSpacing="10">
                    <Button Grid.Column="0" Classes="mat-primary" Content="Добавить"
                            Command="{Binding AddDocumentCommand}"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                    <Button Grid.Column="1" Classes="mat-toolbar" Content="Редактировать"
                            Command="{Binding EditDocumentCommand}"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                    <Button Grid.Column="2" Classes="mat-toolbar" Content="Удалить"
                            Command="{Binding DeleteDocumentCommand}"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                    <Button Grid.Column="3" Classes="mat-toolbar" Content="Экспорт"
                            Command="{Binding ExportDocumentCommand}"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                    <Button Grid.Column="4" Classes="mat-toolbar" Content="Печать"
                            Command="{Binding PrintDocumentCommand}"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                    <Button Grid.Column="5" Classes="mat-toolbar" Content="Закрыть"
                            Command="{Binding CloseWindowCommand}"
                            HorizontalAlignment="Right"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                </Grid>
            </Border>

            <Grid Grid.Row="2" ColumnDefinitions="250,*" Margin="12,0,12,0">
                <Border Grid.Column="0" Margin="0,0,12,0" Classes="mat-card" Padding="12">
                    <StackPanel Spacing="8">
                        <TextBlock Classes="mat-section-title" Text="Аналитика"/>
                        <Button Classes="mat-toolbar" Content="Отчёт по складу"
                                Command="{Binding StockReportCommand}"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                        <Button Classes="mat-toolbar" Content="Планирование"
                                Command="{Binding PlanningReportCommand}"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                        <Button Classes="mat-toolbar" Content="Инвентаризация"
                                Command="{Binding InventoryReportCommand}"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                        <Button Classes="mat-toolbar" Content="Неснижаемый остаток"
                                Command="{Binding MinStockSettingsCommand}"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                        <Button Classes="mat-toolbar" Content="Ведомость дефицита"
                                Command="{Binding DeficitReportCommand}"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                        <Button Classes="mat-primary" Content="Шаблон инвентаризации"
                                Command="{Binding CreateInventoryTemplateCommand}"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                    </StackPanel>
                </Border>

                <dg:DataGrid Grid.Column="1"
                             x:Name="DocumentsGrid"
                             ItemsSource="{Binding Documents}"
                             SelectedItem="{Binding SelectedDocument}"
                             AutoGenerateColumns="False"
                             CanUserReorderColumns="False"
                             CanUserResizeColumns="True"
                             CanUserSortColumns="True"
                             GridLinesVisibility="Horizontal"
                             BorderBrush="#E2E8F0"
                             BorderThickness="1"
                             IsReadOnly="True"
                             DoubleTapped="OnGridDoubleTapped">
                    <dg:DataGrid.Columns>
                        <dg:DataGridTextColumn Header="Номер" Binding="{Binding Number}" Width="130" SortMemberPath="Number"/>
                        <dg:DataGridTextColumn Header="Дата" Binding="{Binding DateDisplay}" Width="110" SortMemberPath="Date"/>
                        <dg:DataGridTextColumn Header="Тип документа" Binding="{Binding TypeDisplay}" Width="180" SortMemberPath="Type"/>
                        <dg:DataGridTextColumn Header="Примечание" Binding="{Binding Note}" Width="2*" SortMemberPath="Note"/>
                        <dg:DataGridTextColumn Header="Сумма по документу" Binding="{Binding TotalSumDisplay}" Width="140" SortMemberPath="DocumentTotalSum"/>
                    </dg:DataGrid.Columns>
                </dg:DataGrid>
            </Grid>

            <Border Grid.Row="3" Padding="16" Background="#F8FAFC" CornerRadius="0,0,12,12">
                <TextBlock VerticalAlignment="Center" Foreground="#64748B"
                           Text="{Binding Documents.Count, StringFormat=Документов в журнале: {0}}"/>
            </Border>
        </Grid>
    </Border>
</Window>
