<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Styles.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="AuthSurface" Color="#F8FAFC"/>
                    <SolidColorBrush x:Key="AuthField" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="AuthBorder" Color="#CBD5E1"/>
                    <SolidColorBrush x:Key="AuthDivider" Color="#D8E1ED"/>
                    <SolidColorBrush x:Key="AuthText" Color="#0F172A"/>
                    <SolidColorBrush x:Key="AuthMuted" Color="#4D6080"/>
                    <SolidColorBrush x:Key="AuthPlaceholder" Color="#60728F"/>
                    <SolidColorBrush x:Key="AuthFocus" Color="#2563EB"/>
                    <SolidColorBrush x:Key="AuthLink" Color="#1459D1"/>
                    <SolidColorBrush x:Key="AuthLinkHover" Color="#1748AA"/>
                    <SolidColorBrush x:Key="AuthHover" Color="#151565F5"/>
                    <SolidColorBrush x:Key="AuthPressed" Color="#231565F5"/>
                    <SolidColorBrush x:Key="AuthDanger" Color="#B42340"/>
                    <SolidColorBrush x:Key="AuthCloseHover" Color="#D92D46"/>
                    <SolidColorBrush x:Key="AuthDisabled" Color="#526583"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="AuthSurface" Color="#0B1220"/>
                    <SolidColorBrush x:Key="AuthField" Color="#172235"/>
                    <SolidColorBrush x:Key="AuthBorder" Color="#334155"/>
                    <SolidColorBrush x:Key="AuthDivider" Color="#2A3A50"/>
                    <SolidColorBrush x:Key="AuthText" Color="#F1F5F9"/>
                    <SolidColorBrush x:Key="AuthMuted" Color="#ABBAD0"/>
                    <SolidColorBrush x:Key="AuthPlaceholder" Color="#9BAFCB"/>
                    <SolidColorBrush x:Key="AuthFocus" Color="#3B82F6"/>
                    <SolidColorBrush x:Key="AuthLink" Color="#82B6FF"/>
                    <SolidColorBrush x:Key="AuthLinkHover" Color="#BED8FF"/>
                    <SolidColorBrush x:Key="AuthHover" Color="#263B82F6"/>
                    <SolidColorBrush x:Key="AuthPressed" Color="#3A3B82F6"/>
                    <SolidColorBrush x:Key="AuthDanger" Color="#FFA5B5"/>
                    <SolidColorBrush x:Key="AuthCloseHover" Color="#C42A45"/>
                    <SolidColorBrush x:Key="AuthDisabled" Color="#3D4E69"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <DrawingImage x:Key="AuthBrandMark">
                <DrawingGroup>
                    <GeometryDrawing Brush="#0768FF"
                                     Geometry="M0,13 L36,0 L36,45 L0,58 Z M4,16 L4,52 L32,42 L32,6 Z"/>
                    <GeometryDrawing Brush="#50A5FF"
                                     Geometry="M18,19 L54,6 L54,51 L18,64 Z M22,22 L22,58 L50,48 L50,12 Z"/>
                </DrawingGroup>
            </DrawingImage>
        </ResourceDictionary>
    </Styles.Resources>

    <Style Selector="Border.auth-surface">
        <Setter Property="Background" Value="{DynamicResource AuthSurface}"/>
    </Style>
    <Style Selector="TransitioningContentControl#AuthPages">
        <Setter Property="Margin" Value="28,62,28,26"/>
    </Style>
    <Style Selector="Window.narrow-auth TransitioningContentControl#AuthPages">
        <Setter Property="Margin" Value="16,62,16,26"/>
    </Style>
    <Style Selector="Border.auth-divider">
        <Setter Property="Background" Value="{DynamicResource AuthDivider}"/>
        <Setter Property="Height" Value="1"/>
        <Setter Property="Margin" Value="0,16,0,0"/>
    </Style>
    <Style Selector="StackPanel.auth-form">
        <Setter Property="MaxWidth" Value="384"/>
        <Setter Property="Margin" Value="6,8,6,10"/>
        <Setter Property="Spacing" Value="12"/>
    </Style>
    <Style Selector="StackPanel.auth-heading">
        <Setter Property="Spacing" Value="5"/>
        <Setter Property="Margin" Value="0,0,0,24"/>
    </Style>
    <Style Selector="TextBlock.auth-text">
        <Setter Property="Foreground" Value="{DynamicResource AuthText}"/>
    </Style>
    <Style Selector="TextBlock.auth-title">
        <Setter Property="FontSize" Value="34"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style Selector="TextBlock.auth-muted">
        <Setter Property="Foreground" Value="{DynamicResource AuthMuted}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style Selector="TextBlock.auth-error">
        <Setter Property="IsVisible" Value="False"/>
        <Setter Property="Foreground" Value="{DynamicResource AuthDanger}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="AutomationProperties.LiveSetting" Value="Polite"/>
    </Style>
    <Style Selector="TextBlock.auth-error.shown">
        <Setter Property="IsVisible" Value="True"/>
    </Style>
    <Style Selector="Ellipse.auth-status">
        <Setter Property="Width" Value="12"/>
        <Setter Property="Height" Value="12"/>
        <Setter Property="Fill" Value="{DynamicResource AuthPlaceholder}"/>
    </Style>
    <Style Selector="Ellipse.auth-status.online">
        <Setter Property="Fill" Value="#36B978"/>
    </Style>
    <Style Selector="Ellipse.auth-status.slow">
        <Setter Property="Fill" Value="#E8BC47"/>
    </Style>
    <Style Selector="Ellipse.auth-status.offline">
        <Setter Property="Fill" Value="#FFA000"/>
    </Style>

    <Style Selector="Window.compact-auth">
        <Style Selector="^ StackPanel.auth-form">
            <Setter Property="Spacing" Value="8"/>
        </Style>
        <Style Selector="^ StackPanel.auth-heading">
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style Selector="^ TextBlock.auth-title">
            <Setter Property="FontSize" Value="28"/>
        </Style>
        <Style Selector="^ Border.auth-input">
            <Setter Property="Height" Value="44"/>
        </Style>
        <Style Selector="^ Border.auth-divider">
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
        <Style Selector="^ Button.auth-primary">
            <Setter Property="Height" Value="44"/>
        </Style>
    </Style>
</Styles>
