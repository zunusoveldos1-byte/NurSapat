<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style Selector="Border.mat-shell">
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="#CBD5E1"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="BoxShadow" Value="0 12 32 0 #220F172A"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="ClipToBounds" Value="True"/>
    </Style>

    <Style Selector="Border.mat-shell > Grid">
        <Setter Property="RowSpacing" Value="0"/>
        <Setter Property="ColumnSpacing" Value="0"/>
        <Setter Property="Margin" Value="0"/>
    </Style>

    <Style Selector="Border.mat-titlebar">
        <Setter Property="Background" Value="#0F172A"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="MaxHeight" Value="32"/>
        <Setter Property="Margin" Value="0,0,0,-1"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="CornerRadius" Value="12,12,0,0"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="ZIndex" Value="1"/>
    </Style>

    <Style Selector="TextBlock.mat-titlebar-text">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style Selector="Button.mat-chrome-btn">
        <Setter Property="Width" Value="46"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="Button.mat-chrome-btn:pointerover">
        <Setter Property="Background" Value="#1E293B"/>
    </Style>

    <Style Selector="Button.mat-chrome-btn.close:pointerover">
        <Setter Property="Background" Value="#DC2626"/>
    </Style>

    <Style Selector="Border.mat-card">
        <Setter Property="Background" Value="#F8FAFC"/>
        <Setter Property="BorderBrush" Value="#E2E8F0"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="14"/>
    </Style>

    <Style Selector="TextBlock.mat-section-title">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="#0F172A"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>

    <Style Selector="Button.mat-primary">
        <Setter Property="Background" Value="#2563EB"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="Button.mat-primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#1D4ED8"/>
        <Setter Property="TextBlock.Foreground" Value="White"/>
    </Style>

    <Style Selector="Button.mat-toolbar">
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="Button.tg-btn /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#33ADE9"/>
    </Style>
    <Style Selector="Button.tg-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#299AD2"/>
        <Setter Property="TextBlock.Foreground" Value="White"/>
    </Style>
    <Style Selector="Button.tg-btn:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#2082B2"/>
        <Setter Property="TextBlock.Foreground" Value="White"/>
    </Style>

    <Style Selector="Button.wa-btn /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#197948"/>
    </Style>
    <Style Selector="Button.wa-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#135F38"/>
        <Setter Property="TextBlock.Foreground" Value="White"/>
    </Style>
    <Style Selector="Button.wa-btn:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#0E4629"/>
        <Setter Property="TextBlock.Foreground" Value="White"/>
    </Style>

    <Style Selector="Button.phone-btn /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#0BC770"/>
    </Style>
    <Style Selector="Button.phone-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#09A65D"/>
        <Setter Property="TextBlock.Foreground" Value="White"/>
    </Style>
    <Style Selector="Button.phone-btn:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#07854A"/>
        <Setter Property="TextBlock.Foreground" Value="White"/>
    </Style>

</Styles>
