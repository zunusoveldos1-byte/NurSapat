<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style Selector="Window.auth-motion">
        <Style Selector="^ Border.auth-surface, ^ Border.auth-divider">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.25"/>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.25"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="^ TextBlock.auth-text, ^ TextBlock.auth-muted, ^ TextBlock.auth-label, ^ TextBlock.auth-error">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Foreground" Duration="0:0:0.25"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="^ TextBlock.auth-error.shown">
            <Style.Animations>
                <Animation Duration="0:0:0.15" Easing="CubicEaseOut">
                    <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0"/></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1"/></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="^ Border.auth-input">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.25"/>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.17"/>
                    <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.17"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="^ TextBox.auth-field">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Foreground" Duration="0:0:0.25"/>
                    <BrushTransition Property="PlaceholderForeground" Duration="0:0:0.25"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="^ TextBox.auth-field /template/ TextBlock#PART_Placeholder">
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.17"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="^ CheckBox.auth-remember">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Foreground" Duration="0:0:0.25"/>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.13"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="^ CheckBox.auth-remember:pointerover">
            <Setter Property="Opacity" Value="0.85"/>
        </Style>
        <Style Selector="^ CheckBox.auth-remember:pressed">
            <Setter Property="Opacity" Value="0.72"/>
        </Style>
        <Style Selector="^ Button.auth-primary">
            <Setter Property="RenderTransform" Value="translateY(0px)"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.18"/>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15"/>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="^ Button.auth-primary:pointerover:not(:disabled)">
            <Setter Property="RenderTransform" Value="translateY(-2px)"/>
        </Style>
        <Style Selector="^ Button.auth-primary /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="RenderTransform" Value="scale(1)"/>
            <Setter Property="BoxShadow" Value="0 3 12 0 #001565F5"/>
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.10" Easing="CubicEaseOut"/>
                    <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.18"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="^ Button.auth-primary:pointerover:not(:disabled) /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BoxShadow" Value="0 3 12 0 #481565F5"/>
        </Style>
        <Style Selector="^ Button.auth-primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="RenderTransform" Value="scale(0.985)"/>
        </Style>
        <Style Selector="^ Button.AuthTextLink">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Foreground" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="^ Button.auth-link, ^ Button.auth-icon">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.14"/>
                    <BrushTransition Property="Foreground" Duration="0:0:0.14"/>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.14"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="^ Button.auth-icon:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="RenderTransform" Value="scale(0.95)"/>
        </Style>
        <Style Selector="^ Button.auth-icon /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="RenderTransform" Value="scale(1)"/>
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.10"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="^ PathIcon.theme-glyph, ^ PathIcon.password-glyph">
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.15"/>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.24" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="^ PathIcon.theme-glyph">
            <Setter Property="RenderTransform" Value="rotate(0deg)"/>
        </Style>
        <Style Selector="^ PathIcon.theme-glyph.sun, ^ Button.dark PathIcon.theme-glyph.moon">
            <Setter Property="RenderTransform" Value="rotate(-18deg)"/>
        </Style>
        <Style Selector="^ Button.dark PathIcon.theme-glyph.sun">
            <Setter Property="RenderTransform" Value="rotate(0deg)"/>
        </Style>
        <Style Selector="^ Ellipse.auth-status">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Fill" Duration="0:0:0.20"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="^ Button.auth-icon.refreshing PathIcon">
            <Style.Animations>
                <Animation Duration="0:0:0.85" IterationCount="Infinite">
                    <KeyFrame Cue="0%"><Setter Property="RotateTransform.Angle" Value="0"/></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="RotateTransform.Angle" Value="360"/></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </Style>
</Styles>
