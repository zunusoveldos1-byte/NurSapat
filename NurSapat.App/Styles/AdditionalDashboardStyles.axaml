<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style Selector="Border.ad-card">
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="#E6EAF2"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="20"/>
        <Setter Property="BoxShadow" Value="0 1 3 0 #0A000000"/>
    </Style>

    <Style Selector="TextBlock.ad-title">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="#0F172A"/>
    </Style>

    <Style Selector="TextBlock.ad-label">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="#64748B"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>

    <Style Selector="TextBlock.ad-body">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="#0F172A"/>
    </Style>

    <Style Selector="TextBlock.ad-muted">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="#94A3B8"/>
    </Style>

    <Style Selector="TextBlock.ad-icon">
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Foreground" Value="#64748B"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style Selector="Button.ad-primary">
        <Setter Property="Height" Value="36"/>
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="Padding" Value="16,0"/>
        <Setter Property="Background" Value="#2F80ED"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <Style Selector="Button.ad-primary:pointerover">
        <Setter Property="Background" Value="#2563EB"/>
    </Style>

    <Style Selector="Button.ad-secondary">
        <Setter Property="Height" Value="36"/>
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="Padding" Value="16,0"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="Foreground" Value="#0F172A"/>
        <Setter Property="BorderBrush" Value="#E6EAF2"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <Style Selector="Button.ad-secondary:pointerover">
        <Setter Property="Background" Value="#F7F9FC"/>
    </Style>

    <Style Selector="Button.ad-ghost">
        <Setter Property="Height" Value="32"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="Width" Value="32"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <Style Selector="Button.ad-ghost:pointerover">
        <Setter Property="Background" Value="#F1F5F9"/>
    </Style>

    <Style Selector="ComboBox.ad-field">
        <Setter Property="Height" Value="36"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="BorderBrush" Value="#E6EAF2"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="8,0"/>
    </Style>

    <Style Selector="TextBox.ad-note">
        <Setter Property="MinHeight" Value="120"/>
        <Setter Property="AcceptsReturn" Value="True"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="BorderBrush" Value="#E6EAF2"/>
        <Setter Property="Padding" Value="12"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="PlaceholderText" Value="Введите примечание..."/>
    </Style>

    <Style Selector="ToggleSwitch.ad-switch">
        <Setter Property="FontSize" Value="13"/>
    </Style>

    <Style Selector="Border.ad-table-header">
        <Setter Property="Background" Value="#F7F9FC"/>
        <Setter Property="BorderBrush" Value="#E6EAF2"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Height" Value="42"/>
        <Setter Property="MinHeight" Value="42"/>
    </Style>

    <Style Selector="Border.ad-table-row">
        <Setter Property="Height" Value="42"/>
        <Setter Property="MinHeight" Value="42"/>
        <Setter Property="BorderBrush" Value="#EEF2F7"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.12"/>
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Border.ad-table-row:pointerover">
        <Setter Property="Background" Value="#F7F9FC"/>
    </Style>

    <Style Selector="TextBlock.ad-th">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="#64748B"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style Selector="Border.ad-info-tile">
        <Setter Property="Background" Value="#F7F9FC"/>
        <Setter Property="BorderBrush" Value="#E6EAF2"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="12"/>
        <Setter Property="MinHeight" Value="72"/>
    </Style>

    <Style Selector="Border.ad-badge">
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style Selector="Border.ad-status-pill">
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>

</Styles>
